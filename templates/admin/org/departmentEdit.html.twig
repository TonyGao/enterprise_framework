{% import 'ui/template/ui.html.twig' as ui %}
{% if dynamicFormHtml is defined %}
  {% include 'admin/org/_designer_link.html.twig' %}
  {{ dynamicFormHtml|raw }}
{% else %}
  {% if designerViewId is defined %}
    {% include 'admin/org/_designer_link.html.twig' %}
  {% elseif is_granted('ROLE_SYS_ADMIN') and designerViewName is defined %}
    <div style="position: fixed; right: 28px; top: 70px; z-index: 999; display: flex; gap: 6px;">
      <button type="button" id="btn-create-designer" onclick="autoCreateView()"
         style="padding: 6px 12px; background: #fff3cd; border: 1px solid #ffc107; border-radius: 20px;
                font-size: 13px; color: #856404; white-space: nowrap;
                box-shadow: 0 2px 8px rgba(0,0,0,0.1); display: inline-flex; align-items: center; gap: 6px;
                cursor: pointer;">
        <i class="fa-solid fa-link"></i> {{ "deptEdit.1"|trans }}
      </button>
    </div>
  {% endif %}
  {{ form_start(form) }}
      {{ form_widget(form) }}
      <div class="ef-row ef-row-align-start ef-row-justify-start ef-form-item ef-form-item-layout-horizontal">
          <div class="ef-col ef-col-5 ef-form-item-label-col">
              <label class="ef-form-item-label"></label>
          </div>
          <div class="ef-col ef-col-19 ef-form-item-wrapper-col">
              <div class="ef-form-item-content-wrapper">
                  <div class="ef-form-item-content ef-form-item-content-flex">
                      <div class="ef-space ef-space-horizontal ef-space-align-center">
                          <div class="ef-space-item" style="margin-right: 8px;">
                              <button class="btn primary medium" type="submit">{{ "deptEdit.2"|trans }}</button>
                          </div>
                          <div class="ef-space-item">
                                <button class="btn primary medium back-btn" type="button">{{ "deptEdit.3"|trans }}</button>
                          </div>
                      </div>
                  </div>
              </div>
          </div>
      </div>
  {{ form_end(form) }}
  {{ ui.formValid() }}
{% endif %}

{% if designerViewName is defined and designerEntityFqn is defined %}
<script>
function autoCreateView() {
  var btn = $('#btn-create-designer');
  btn.prop('disabled', true).html(t('deptEdit.js1'));
  var _alert = new Alert($('.app-content-container'));
  ajax({
    url: '{{ path('api_platform_view_auto_bind') }}',
    method: 'POST',
    contentType: 'application/json',
    data: {
      viewName: '{{ designerViewName }}',
      viewLabel: '{{ designerViewLabel|default(designerViewName) }}',
      entityFqn: '{{ designerEntityFqn|e('js') }}'
    },
    success: function(resp) {
      var info = resp.data;
      if (info && info.viewId) {
        window.open('{{ path('platform_view_editor', {id: '__VIEW_ID__'}) }}'.replace('__VIEW_ID__', info.viewId), '_blank');
        setTimeout(function() { location.reload(); }, 500);
      }
    },
    error: function(xhr) {
      var msg = xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : t('deptEdit.js2');
      _alert.error(msg, { percent: '280px', title: t('deptEdit.js3'), closable: true });
      btn.prop('disabled', false).html(t('deptEdit.js4'));
    }
  });
}
</script>
{% endif %}
