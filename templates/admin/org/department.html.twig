{% extends 'admin/layout.html.twig' %}
{% import 'ui/template/ui.html.twig' as ui %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" type="text/css" href="{{ asset('platform/treeLayout.css', 'admin') }}"/>
	<link rel="stylesheet" type="text/css" href="{{ asset('platform/treeCollapse.css', 'admin') }}"/>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('platform/treeCollapse.js', 'admin') }}"></script>
  <script src=" {{ asset('organization/department.js', 'admin') }} "></script>

  <script>
  function getQueryParam(name) {
    var match = window.location.search.match(new RegExp('[?&]' + name + '=([^&]*)'));
    return match ? decodeURIComponent(match[1]) : null;
  }

  function updateUrl(id) {
    if (id) {
      history.replaceState(null, '', '?id=' + encodeURIComponent(id));
    } else {
      history.replaceState(null, '', window.location.pathname);
    }
  }

  function expandToNode(nodeId) {
    var $node = $('.org-text-content[id="' + nodeId + '"]');
    if (!$node.length) return;
    $node.parents('li').each(function() {
      var $subTree = $(this).children('ol.sub-tree-content');
      if ($subTree.length && $subTree.is(':hidden')) {
        $subTree.show();
        $(this).children('.tree-indent').show();
        var $arrow = $(this).find('> .item-content .arrow-icon i');
        if ($arrow.length) {
          $arrow.removeClass('fa-caret-right').addClass('fa-caret-down');
        }
      }
    });
  }

	$(document).ready(function () {
    let payload = {
      parent: null,
    };

    $(".org-text-content.company, .org-text-content.department").on("click", function (event) {
      let thisChosen = false;
      let type = $(this).attr("type");
      if ($(this).hasClass("chosen")) {
        thisChosen = true;
      }
      $(".org-text-content.chosen").removeClass("chosen");
      if (!thisChosen) {
        $(this).addClass("chosen");
        payload.parent = $(this).attr("id");
        updateUrl($(this).attr("id"));
      } else {
        updateUrl(null);
      }
    })

    // 页面恢复：如果 URL 有 ?id=xxx，展开路径并自动选中该节点
    var restoreId = getQueryParam('id');
    if (restoreId) {
      // 如果左侧树被折叠，先展开
      if ($('#leftTree').is(':hidden')) {
        $('#collapseTree').trigger('click');
      }
      expandToNode(restoreId);
      var $node = $('.org-text-content[id="' + restoreId + '"]');
      if ($node.length) {
        $('.org-text-content.chosen').removeClass('chosen');
        $node.addClass('chosen');
        payload.parent = restoreId;
        // 滚动到可见区域
        var scrollContainer = $node.closest('.left-tree-wrapper');
        if (scrollContainer.length) {
          scrollContainer.scrollTop($node.offset().top - scrollContainer.offset().top + scrollContainer.scrollTop() - 100);
        }
        if ($node.hasClass('department')) {
          setTimeout(function() { $('#modify').trigger('click'); }, 50);
        }
      }
    }

    $("#create").on("click", function (event) {
      $.ajax({
        url: "{{ path('org_department_new') }}", // 你的路由 URL
        data: payload, // GET 请求不会发送 JSON 数据，直接传递对象或字符串
        dataType: "html",
        success: function(data) {
          $(".right-content").html(data);
        }
      })
    })

    $("#modify").on("click", function (event) {
      const departmentId = $(".org-text-content.department.chosen").attr('id'); // 获取部门 ID
      const payload = {
        // 此处填充你需要发送的表单数据
        name: $("#name").val(),
        type: $("#type").val(),
        // 其它字段...
      };

      ajax({
        url: "{{ path('org_department_edit', { id: 'departmentId' }) }}".replace('departmentId', departmentId), // 动态 URL，包含部门 ID
        data: payload,
        dataType: "html",
        success: function(response) {
          $(".right-content").html(response); // 更新页面内容
        },
        error: (xhr, _, msg) => {
          $.alert.error(`修改失败: ${msg}`);
        }
      });
    });

    // "返回"按钮：清空右侧内容并清除 URL
    $(document).on('click', '.right-content .back-btn', function(e) {
      e.preventDefault();
      e.stopPropagation();
      console.log('[DEBUG] 返回按钮点击', new Date().toISOString());
      $('.right-content').empty();
      console.log('[DEBUG] right-content cleared');
      updateUrl(null);
      console.log('[DEBUG] URL cleared, pathname:', window.location.pathname, 'search:', window.location.search);
    });

    // Handle AJAX form submission for New/Edit Department
    $(document).on('submit', '.right-content form', function(e) {
        e.preventDefault();
        const $form = $(this);
        
        $.ajax({
            url: $form.attr('action'),
            method: 'POST',
            data: $form.serialize(),
            success: function(response, status, xhr) {
                const contentType = xhr.getResponseHeader("content-type") || "";
                if (contentType.indexOf("json") !== -1) {
                    if (response.code === 200) {
                         // alert(response.message || '操作成功');
                         const data = response.data;
                         if (data.type === 'edit') {
                              $('.org-text-content[id="' + data.id + '"]').text(data.name);
                         } else if (data.type === 'new') {
                              const parentId = data.parentId;
                              if (parentId) {
                                  const $parentText = $('.org-text-content[id="' + parentId + '"]');
                                  if ($parentText.length) {
                                      const $itemContent = $parentText.closest('.item-content');
                                      const $li = $itemContent.parent('li');
                                      let $ol = $li.children('ol.sub-tree-content');
                                      
                                      if ($ol.length === 0) {
                                          $ol = $('<ol class="sub-tree-content"></ol>');
                                          $li.append($ol);
                                          const $arrow = $itemContent.find('.arrow-icon');
                                          // Add caret if empty
                                          if ($arrow.find('i').length === 0) {
                                              $arrow.html('<i class="fa-solid fa-caret-right"></i>');
                                          }
                                      }
                                      $ol.append(data.html);
                                  }
                              }
                         }
                          if (data.type === 'new' && data.id) {
                            updateUrl(data.id);
                          }
                          $('.right-content').html('<div style="padding: 20px;" class="alert alert-success">' + (response.message || '操作成功') + '</div>');
                    } else {
                        alert(response.message || '操作失败');
                    }
                } else {
                    // HTML response (validation errors)
                    $('.right-content').html(response);
                }
            },
            error: function() {
                alert('请求失败');
            }
        });
    });
  })
  </script>
{% endblock %}

{% block css %}
<style>
.outside-wrapper {
  padding-top: 0;
}
</style>
{% endblock %}

{% block app_content_container %}
	<div class="org-structure-container">
		<div class="outside-wrapper">
			{{ ui.toolBar([
					{'type': 'create', 'text': 'btn.create', 'id': 'create'},
					{'type': 'modify', 'text': 'btn.modify', 'id': 'modify'},
          {'type':'disable', 'text': 'btn.disable', 'id':'disable'},
			]) }}
			<div class="inside-wrapper">
				<div class="left-tree visible" id="leftTree">
					<div class="left-tree-wrapper">
						<div class="search-department-wrapper">
							<span class="ef-input-wrapper">
								<input class="ef-input ef-input-size-mini text" type="text" clearable="true" placeholder="{{ "orgDept.1"|trans }}"/>
								<span class="ef-input-suffix">
									<i class="fa-solid fa-magnifying-glass"></i>
								</span>
							</span>
						</div>
						<div class="department-tree-wrapper common-tree-wrapper">
              {{ departmentTree | raw }}
						</div>
					</div>
				</div>
        <div class="fold-icon-wrapper" id="collapseTree">
          <i class="fa-solid fa-chevron-left"></i>
        </div>
				<div class="right-content">
				</div>
			</div>
		</div>
	</div>
{% endblock %}
