{% extends 'admin/layout.html.twig' %}
{% import 'ui/template/ui.html.twig' as ui %}

{% block title %}{{ title|default('posLevel.formTitle'|trans) }}{% endblock %}

{% block app_content_container %}
<div class="ef-page-header">
    <div class="ef-page-title">
        <h1>{{ title|default('posLevel.formTitle'|trans) }}</h1>
    </div>
</div>

<div class="ef-page-content">
    <div class="ef-card">
        <div class="ef-card-body">
            {% if dynamicFormHtml is defined %}
                {{ dynamicFormHtml|raw }}
            {% else %}
                {{ form_start(form, {'attr': {'class': 'ef-form'}}) }}
                    {{ form_widget(form) }}
                    {{ ui.formSubmitButton() }}
                {{ form_end(form) }}
            {% endif %}
        </div>
    </div>
</div>

{{ ui.formValid() }}
{% endblock %}
