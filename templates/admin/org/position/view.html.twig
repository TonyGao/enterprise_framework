{% extends "admin/base.html.twig" %}

{% block title %}{{ "posView.title1"|trans }}{% endblock %}

{% block body %}
    <div class="ef-page-header">
        <div class="ef-page-title">
            <h1>{{ "posView.1"|trans }}</h1>
        </div>
        <div class="ef-page-breadcrumb">
            <ol class="ef-breadcrumb">
                <li class="ef-breadcrumb-item"><a href="{{ path('admin_dashboard') }}">{{ "posView.2"|trans }}</a></li>
                <li class="ef-breadcrumb-item"><a href="{{ path('org_corporation') }}">{{ "posView.3"|trans }}</a></li>
                <li class="ef-breadcrumb-item"><a href="{{ path('org_position') }}">{{ "posView.4"|trans }}</a></li>
                <li class="ef-breadcrumb-item active">{{ "posView.1"|trans }}</li>
            </ol>
        </div>
    </div>

    <div class="ef-page-content">
        <div class="ef-card">
            <div class="ef-card-header">
                <div class="ef-card-title">{{ "posView.5"|trans }}</div>
                <div class="ef-card-actions">
                    <a href="{{ path('org_position_edit', {'id': position.id}) }}" class="ef-button ef-button-primary">
                        <i class="fa-solid fa-edit"></i> {{ "posView.6"|trans }}
                    </a>
                    <a href="{{ path('org_position') }}" class="ef-button ef-button-default">
                        <i class="fa-solid fa-arrow-left"></i> {{ "posView.7"|trans }}
                    </a>
                </div>
            </div>
            <div class="ef-card-body">
                <div class="ef-detail-view">
                    <div class="ef-detail-row">
                        <div class="ef-detail-label">{{ "posView.8"|trans }}</div>
                        <div class="ef-detail-value">{{ position.name }}</div>
                    </div>
                    <div class="ef-detail-row">
                        <div class="ef-detail-label">{{ "posView.9"|trans }}</div>
                        <div class="ef-detail-value">{{ position.code }}</div>
                    </div>
                    <div class="ef-detail-row">
                        <div class="ef-detail-label">{{ "posView.10"|trans }}</div>
                        <div class="ef-detail-value">{{ position.department ? position.department.name : '无' }}</div>
                    </div>
                    <div class="ef-detail-row">
                        <div class="ef-detail-label">{{ "posView.11"|trans }}</div>
                        <div class="ef-detail-value">{{ position.type ? position.type.name : '无' }}</div>
                    </div>
                    <div class="ef-detail-row">
                        <div class="ef-detail-label">{{ "posView.12"|trans }}</div>
                        <div class="ef-detail-value">{{ position.level ? position.level.name : '无' }}</div>
                    </div>
                    <div class="ef-detail-row">
                        <div class="ef-detail-label">{{ "posView.13"|trans }}</div>
                        <div class="ef-detail-value">{{ position.parent ? position.parent.name : '无' }}</div>
                    </div>
                    <div class="ef-detail-row">
                        <div class="ef-detail-label">{{ "posView.14"|trans }}</div>
                        <div class="ef-detail-value">{{ position.headcount ?: '未设置' }}</div>
                    </div>
                    <div class="ef-detail-row">
                        <div class="ef-detail-label">{{ "posView.15"|trans }}</div>
                        <div class="ef-detail-value">
                            {% if position.state %}
                                <span class="ef-badge ef-badge-success">{{ "posView.16"|trans }}</span>
                            {% else %}
                                <span class="ef-badge ef-badge-danger">{{ "posView.17"|trans }}</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="ef-card mt-4">
            <div class="ef-card-header">
                <div class="ef-card-title">{{ "posView.18"|trans }}</div>
            </div>
            <div class="ef-card-body">
                <div class="ef-detail-content">
                    {{ position.responsibility|nl2br ?: '暂无岗位职责描述' }}
                </div>
            </div>
        </div>

        <div class="ef-card mt-4">
            <div class="ef-card-header">
                <div class="ef-card-title">{{ "posView.19"|trans }}</div>
            </div>
            <div class="ef-card-body">
                <div class="ef-detail-content">
                    {{ position.requirement|nl2br ?: '暂无任职要求描述' }}
                </div>
            </div>
        </div>

        <div class="ef-card mt-4">
            <div class="ef-card-header">
                <div class="ef-card-title">{{ "posView.20"|trans }} ({{ employees|length }}{{ "posView.21"|trans }})</div>
            </div>
            <div class="ef-card-body">
                {% if employees|length > 0 %}
                    <div class="ef-table ef-table-size-medium ef-table-border">
                        <div class="ef-table-container">
                            <table class="ef-table-element">
                                <thead>
                                    <tr class="ef-table-tr">
                                        <th class="ef-table-th">{{ "posView.22"|trans }}</th>
                                        <th class="ef-table-th">{{ "posView.23"|trans }}</th>
                                        <th class="ef-table-th">{{ "posView.24"|trans }}</th>
                                        <th class="ef-table-th">{{ "posView.15"|trans }}</th>
                                        <th class="ef-table-th">{{ "posView.25"|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for employee in employees %}
                                        <tr class="ef-table-tr">
                                            <td class="ef-table-td" style="{% if employee.employmentStatus == 'inactive' %}text-decoration: underline; text-decoration-color: #ef4444; text-underline-offset: 4px;{% endif %}">{{ employee.name }}</td>
                                            <td class="ef-table-td">{{ employee.employeeNo }}</td>
                                            <td class="ef-table-td">{{ employee.hireDate ? employee.hireDate|date('Y-m-d') : '未设置' }}</td>
                                            <td class="ef-table-td">
                                                {% set work_icon = {
                                                    'working': 'fa-briefcase',
                                                    'vacation': 'fa-umbrella-beach',
                                                    'business_trip': 'fa-plane',
                                                    'out_of_office': 'fa-person-walking-arrow-right',
                                                    'in_meeting': 'fa-users'
                                                }[employee.workStatus|default('working')] | default('fa-circle') %}
                                                <span class="ef-badge ef-badge-default" style="display: inline-flex; align-items: center; gap: 4px;">
                                                    <i class="fa-solid {{ work_icon }}" style="font-size: 11px;"></i>
                                                    {{ ('employee.work_status.' ~ employee.workStatus|default('working'))|trans }}
                                                </span>
                                            </td>
                                            <td class="ef-table-td">
                                                <a href="#" class="ef-button ef-button-text">{{ "posView.26"|trans }}</a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                {% else %}
                    <div class="ef-empty-state">
                        <div class="ef-empty-state-icon">
                            <i class="fa-solid fa-users-slash"></i>
                        </div>
                        <div class="ef-empty-state-text">{{ "posView.27"|trans }}</div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}