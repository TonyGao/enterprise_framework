<link rel="stylesheet" href="{{ asset('sunui/components/position-drawer.css') }}">
<div class="ef-drawer-container" style="z-index: 1001; display: none;" id="{{ drawerId }}">
    <div class="ef-drawer-mask" maskid="{{ drawerId }}"></div>
    <div class="ef-drawer" style="right: -650px; width: 650px; box-shadow: -4px 0 20px rgba(0,0,0,0.15);">
        <div class="ef-drawer-header">
            <div class="ef-drawer-title">
                <i class="fa-solid fa-edit" style="margin-right: 12px; font-size: 18px;"></i>
                编辑岗位级别
                <span style="font-size: 14px; font-weight: 400; margin-left: 8px; opacity: 0.8;">{{ positionLevel.name }}</span>
            </div>
            {% if is_granted('ROLE_SYS_ADMIN') %}
                <div style="margin-left: auto; display: flex; gap: 6px; align-items: center; margin-right: 12px;">
                    {% if designerViewId is defined %}
                        <a href="{{ path('platform_view_editor', {id: designerViewId}) }}" target="_blank"
                           style="padding: 4px 10px; background: #f0f7ff; border: 1px solid #cce5ff; border-radius: 14px;
                                  font-size: 12px; color: #0066cc; text-decoration: none; white-space: nowrap;
                                  display: inline-flex; align-items: center; gap: 4px;">
                            <i class="fa-solid fa-pen-to-square"></i> 视图设计器
                        </a>
                    {% elseif designerViewName is defined %}
                        <button type="button" onclick="autoCreatePositionView(this)"
                                style="padding: 4px 10px; background: #fff3cd; border: 1px solid #ffc107; border-radius: 14px;
                                       font-size: 12px; color: #856404; white-space: nowrap; cursor: pointer;
                                       display: inline-flex; align-items: center; gap: 4px;">
                            <i class="fa-solid fa-link"></i> 新建视图
                        </button>
                    {% endif %}
                </div>
            {% endif %}
            <div tabindex="-1" role="button" aria-label="Close" class="ef-drawer-close-btn">
                <span class="ef-icon-hover">
                    <svg viewbox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" class="ef-icon ef-icon-close" stroke-width="4" stroke-linecap="butt" stroke-linejoin="miter">
                        <path d="M9.857 9.858 24 24m0 0 14.142 14.142M24 24 38.142 9.858M24 24 9.857 38.142"></path>
                    </svg>
                </span>
            </div>
        </div>
        <div class="ef-drawer-body">
            <div class="ef-drawer-content">
                {% import 'ui/template/ui.html.twig' as ui %}
                {% if dynamicFormHtml is defined %}
                    {{ dynamicFormHtml|raw }}
                {% else %}
                    {{ form_start(form, {'attr': {'id': 'position-level-edit-form', 'class': 'ef-form'}}) }}
                        {{ form_widget(form) }}
                        {{ ui.formSubmitButton() }}
                    {{ form_end(form) }}
                {% endif %}
            </div>
        </div>
        <div class="ef-drawer-footer">
            <button class="cancelDrawer ef-drawer-btn ef-drawer-btn-secondary" type="button" onclick="closeDrawer()">取消</button>
        </div>
    </div>
</div>

{# 初始化表单验证 #}
{% import 'ui/template/ui.html.twig' as ui %}
{{ ui.formValid() }}

<script>
function addDrawerOpenClass() {
    $('body').addClass('ef-drawer-open');
}
function removeDrawerOpenClass() {
    $('body').removeClass('ef-drawer-open');
}
$(document).ready(function() {
    addDrawerOpenClass();
    $('.ef-drawer-close-btn').on('click', function() {
        removeDrawerOpenClass();
        $().hideDrawer('{{ drawerId }}');
    });
    $('.ef-drawer-mask').on('click', function() {
        removeDrawerOpenClass();
        $().hideDrawer('{{ drawerId }}');
    });
    $('.cancelDrawer').on('click', function() {
        removeDrawerOpenClass();
        $().hideDrawer('{{ drawerId }}');
    });
});

function onFormSubmitSuccess() {
    removeDrawerOpenClass();
    $().hideDrawer('{{ drawerId }}');
    alert('岗位级别保存成功！');
    window.location.reload();
}

function closeDrawer() {
    removeDrawerOpenClass();
    $().hideDrawer('{{ drawerId }}');
}

{% if designerViewName is defined %}
function autoCreatePositionView(btn) {
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> 创建中...';
    ajax({
        url: '{{ path('api_platform_view_auto_bind') }}',
        method: 'POST',
        contentType: 'application/json',
        data: {
            viewName: '{{ designerViewName }}',
            viewLabel: '{{ designerViewLabel|default(designerViewName) }}',
            entityFqn: '{{ designerEntityFqn|e('js') }}'
        },
        success: function(resp) {
            var info = resp.data;
            if (info && info.viewId) {
                window.open('{{ path('platform_view_editor', {id: '__VIEW_ID__'}) }}'.replace('__VIEW_ID__', info.viewId), '_blank');
                setTimeout(function() { location.reload(); }, 500);
            }
        },
        error: function(xhr) {
            var msg = xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : '创建失败';
            alert(msg);
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-link"></i> 新建视图';
        }
    });
}
{% endif %}
</script>