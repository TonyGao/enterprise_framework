{% if designerViewId is defined and is_granted('ROLE_SYS_ADMIN') %}
  {% if designerViewEntityId %}
    <div style="position: fixed; right: 20px; top: 70px; z-index: 999; display: flex; gap: 6px;">
      <button type="button" id="btn-unbind-designer"
         style="padding: 6px 12px; background: #fff; border: 1px solid #ddd; border-radius: 20px;
                font-size: 13px; color: #999; white-space: nowrap;
                box-shadow: 0 2px 8px rgba(0,0,0,0.1); cursor: pointer;">
        <i class="fa-solid fa-unlink"></i> 解除绑定
      </button>
      <a href="{{ path('platform_view_editor', {id: designerViewId}) }}" target="_blank"
         style="padding: 6px 12px; background: #f0f7ff; border: 1px solid #cce5ff; border-radius: 20px;
                font-size: 13px; color: #0066cc; text-decoration: none; white-space: nowrap;
                box-shadow: 0 2px 8px rgba(0,0,0,0.1); display: inline-flex; align-items: center; gap: 6px;">
        <i class="fa-solid fa-pen-to-square"></i> 视图设计器
      </a>
    </div>
    <script>
    document.getElementById('btn-unbind-designer')?.addEventListener('click', function() {
      var modalId = 'unbind-confirm-' + Date.now();
      var html = '<div class="ef-modal-container" id="' + modalId + '" style="z-index: 2000; display: none;">' +
        '<div class="ef-modal-mask"></div>' +
        '<div class="ef-modal-wrapper ef-modal-wrapper-align-center">' +
          '<div class="ef-modal" style="width:400px">' +
            '<div class="ef-modal-header">' +
              '<div class="ef-modal-title">解除绑定</div>' +
              '<div tabindex="-1" role="button" aria-label="Close" class="ef-modal-close-btn" onclick="closeModal(\'' + modalId + '\')"><span class="ef-icon-hover"><svg viewBox="0 0 48 48" width="16" height="16"><path d="M39.486 12.456a1.5 1.5 0 0 0-2.022-2.197l-.1.092L24 23.778 10.636 10.35a1.5 1.5 0 0 0-2.228 1.998l.092.1L21.864 25.9 8.5 39.352a1.5 1.5 0 0 0 2.022 2.197l.1-.092L24 28.022l13.364 13.428a1.5 1.5 0 0 0 2.228-1.998l-.092-.1L26.136 25.9l13.35-13.444Z" fill="currentColor"/></svg></span></div>' +
            '</div>' +
            '<div class="ef-modal-body"><p>确认解除绑定？解除后模板关联也会清除。</p></div>' +
            '<div class="ef-modal-footer">' +
              '<button class="btn secondary small" onclick="closeModal(\'' + modalId + '\')">取消</button>' +
              '<button class="btn red small" onclick="doUnbind(\'' + modalId + '\')">解除绑定</button>' +
            '</div>' +
          '</div>' +
        '</div>' +
      '</div>';
      document.body.insertAdjacentHTML('beforeend', html);
      openModal(modalId);
    });
    function doUnbind(modalId) {
      fetch('/api/admin/platform/view/{{ designerViewId }}/unbind-entity', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: '{}'
      }).then(function(r) {
        if (r.ok) location.reload();
        else r.text().then(function(t) { alert('解除绑定失败: ' + t); closeModal(modalId); });
      });
    }
    </script>
  {% else %}
    <button type="button" id="btn-bind-designer"
       style="position: fixed; right: 20px; top: 70px; z-index: 999; padding: 6px 12px;
              background: #fff3cd; border: 1px solid #ffc107; border-radius: 20px;
              font-size: 13px; color: #856404; white-space: nowrap;
              box-shadow: 0 2px 8px rgba(0,0,0,0.1); display: inline-flex; align-items: center; gap: 6px;
              cursor: pointer;">
      <i class="fa-solid fa-link"></i> 绑定视图设计器
    </button>
    <script>
    document.getElementById('btn-bind-designer')?.addEventListener('click', function() {
      var modalId = 'bind-confirm-' + Date.now();
      var html = '<div class="ef-modal-container" id="' + modalId + '" style="z-index: 2000; display: none;">' +
        '<div class="ef-modal-mask"></div>' +
        '<div class="ef-modal-wrapper ef-modal-wrapper-align-center">' +
          '<div class="ef-modal" style="width:400px">' +
            '<div class="ef-modal-header">' +
              '<div class="ef-modal-title">绑定视图设计器</div>' +
              '<div tabindex="-1" role="button" aria-label="Close" class="ef-modal-close-btn" onclick="closeModal(\'' + modalId + '\')"><span class="ef-icon-hover"><svg viewBox="0 0 48 48" width="16" height="16"><path d="M39.486 12.456a1.5 1.5 0 0 0-2.022-2.197l-.1.092L24 23.778 10.636 10.35a1.5 1.5 0 0 0-2.228 1.998l.092.1L21.864 25.9 8.5 39.352a1.5 1.5 0 0 0 2.022 2.197l.1-.092L24 28.022l13.364 13.428a1.5 1.5 0 0 0 2.228-1.998l-.092-.1L26.136 25.9l13.35-13.444Z" fill="currentColor"/></svg></span></div>' +
            '</div>' +
            '<div class="ef-modal-body"><p>确认绑定「{{ designerViewLabel }}」？绑定后将使用视图设计器管理表单布局。</p></div>' +
            '<div class="ef-modal-footer">' +
              '<button class="btn secondary small" onclick="closeModal(\'' + modalId + '\')">取消</button>' +
              '<button class="btn primary small" onclick="doBind(\'' + modalId + '\')">确认绑定</button>' +
            '</div>' +
          '</div>' +
        '</div>' +
      '</div>';
      document.body.insertAdjacentHTML('beforeend', html);
      openModal(modalId);
    });
    function doBind(modalId) {
      fetch('/api/admin/platform/view/{{ designerViewId }}/bind-entity', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: '{}'
      }).then(function(r) {
        if (r.ok) location.reload();
        else r.text().then(function(t) { alert('绑定失败: ' + t); closeModal(modalId); });
      });
    }
    </script>
  {% endif %}
{% endif %}