{% extends "base.html.twig" %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" type="text/css" href="{{ asset('view_editor_layout.css', 'admin') }}">
  <link rel="stylesheet" type="text/css" href="{{ asset('platform/view_editor.css', 'admin') }}?v=2">
  <link rel="stylesheet" type="text/css" href="{{ asset('platform/editor_toolbar.css', 'admin') }}">
	<link rel="stylesheet" type="text/css" href="{{ asset('platform/view_editor_properties.css', 'admin') }}">
	<link rel="stylesheet" type="text/css" href="{{ asset('platform/view_editor_table_context_menu.css', 'admin') }}">
	<link rel="stylesheet" type="text/css" href="{{ asset('platform/view_editor_canvas.css', 'admin') }}">
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('layout.js', 'admin') }}"></script>
	<script src="{{ asset('platform/view_editor_core.js', 'admin') }}"></script>
  <script src="{{ asset('platform/view_editor_table.js', 'admin') }}"></script>
  <script src="{{ asset('platform/view_editor_components.js', 'admin') }}"></script>
  <script src="{{ asset('platform/view_editor.js', 'admin') }}"></script>
  <script src="{{ asset('platform/editor_toolbar.js', 'admin') }}"></script>
	<script src="{{ asset('platform/color_picker.js', 'admin') }}"></script>
	<script src="{{ asset('platform/border_style_picker.js', 'admin') }}"></script>
	<script src="{{ asset('platform/view_editor_section_properties.js', 'admin') }}?v=3"></script>
	<script src="{{ asset('platform/view_table.js', 'admin') }}"></script>
	<script src="{{ asset('platform/view_editor_table_context_menu.js', 'admin') }}"></script>
	<script src="{{ asset('platform/view_editor_field_row_context_menu.js', 'admin') }}"></script>
	<script src="{{ asset('platform/view_editor_canvas.js', 'admin') }}?v=2"></script>
  <script src="{{ asset('platform/view_editor_css_properties.js', 'admin') }}?v=3"></script>
	<script src="{{ asset('platform/components/table_component_properties.js', 'admin') }}"></script>
  <script src="{{ asset('platform/components/text_component_properties.js', 'admin') }}"></script>
  <script src="{{ asset('platform/components/form_field_component_properties.js', 'admin') }}"></script>
  <script src="{{ asset('platform/view_editor_component_properties.js', 'admin') }}"></script>
	<script src="{{ asset('platform/view_editor_datasource.js', 'admin') }}"></script>
	<script src="{{ asset('lib/twind/twind.umd.min.js', 'static') }}"></script>
	<script>
  // 初始化 localforage 数据库名
  localforage.config({
    name: 'EnterpriseFramework'
  });

  // 初始化 Twind v1（关闭 preflight 防止与现有 CSS 冲突）
  function initTwind() {
    if (typeof twind !== 'undefined' && typeof twind.install === 'function') {
      try {
        twind.install({ preflight: false });
        console.log('Twind initialized');
      } catch (e) {
        console.warn('Twind init failed:', e);
      }
    }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTwind);
  } else {
    initTwind();
  }
	</script>
{% endblock %}

{% block body %}
  
	<div id="app">
		<section class="layout-container">
			<header class="app-header {{ headerState == 'shrunk' ? 'shrunk' : '' }}">
				<div class="admin-left-logo">
					<div class="admin-left-logo-container">
						<div class="admin-logo {{ headerState == 'shrunk' ? 'shrunk' : '' }}">
							<a href="/admin/index">
								<div class="logo-image {{ headerState == 'shrunk' ? 'shrunk' : '' }}">Dog View Editor</div>
							</a>
						</div>
					</div>
				</div>
				<div class="admin-header-right">
					<div class="header-helper">
						<a href="javascript:void(0)" class="admin-help-link" id="view-info-btn" title="{{ "viewEditorLayout.1"|trans }}">
							<div>
								<span class="universe-icon helper">
									<i class="fa-regular fa-circle-question"></i>
								</span>
							</div>
						</a>
					</div>
					<div class="hSeperater"></div>
					<span>
						<div class="module-container">
							<div class="module-icon-container {{ headerState == 'shrunk' ? 'shrunk' : '' }}">
								{# <span class="universe-icon">
									<a class="fa-brands fa-symfony" href="/_profiler/empty/search/results?limit=20" target="_blank"></a>
								</span> #}
							</div>
						</div>
					</span>
				</div>
				<div class="header-toggle">
						<button id="toggle-header-button">
								<i class="fa-solid fa-angle-up"></i> <!-- 向上箭头图标 -->
						</button>
				</div>
			</header>
      {% include "admin/platform/view/editor_toolbar.html.twig" %}
			<section class="app-body">
				{% include "admin/platform/view/editor_components.html.twig" %}
				<section class="app-content-container">
        {% block app_content_container %}{% endblock %}
        </section>
			</section>
		</section>
	</div>
<script>
document.getElementById('view-info-btn')?.addEventListener('click', function(e) {
	e.preventDefault();
	var lines = [];
	if (window.__VIEW_ID__) lines.push(t('viewEditorLayout.js1') + window.__VIEW_ID__);
	if (window.__VIEW_NAME__) lines.push(t('viewEditorLayout.js2') + window.__VIEW_NAME__);
	if (window.__VIEW_PATH__) lines.push(t('viewEditorLayout.js3') + window.__VIEW_PATH__);
	if (window.__VIEW_DESIGN_PATH__) lines.push(t('viewEditorLayout.js4') + window.__VIEW_DESIGN_PATH__);
	if (lines.length === 0) { lines.push(t('viewEditorLayout.js5')); }

	var old = document.getElementById('ai-view-info-popup');
	if (old) old.remove();

	var popup = document.createElement('div');
	popup.id = 'ai-view-info-popup';
	popup.style.cssText = 'position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:#fff;color:#1e293b;padding:20px 24px;border-radius:12px;box-shadow:0 8px 30px rgba(0,0,0,0.15);z-index:99999;font-size:14px;line-height:1.6;min-width:320px;max-width:90vw;';

	var title = document.createElement('div');
	title.textContent = t('viewEditorLayout.js6');
	title.style.cssText = 'font-size:16px;font-weight:700;margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid #e2e8f0;';
	popup.appendChild(title);

	lines.forEach(function(l) {
		var p = document.createElement('div');
		p.textContent = l;
		p.style.cssText = 'margin:4px 0;';
		popup.appendChild(p);
	});

	var close = document.createElement('button');
	close.textContent = t('viewEditorLayout.js7');
	close.style.cssText = 'margin-top:14px;padding:6px 16px;background:#3b82f6;color:#fff;border:none;border-radius:6px;cursor:pointer;font-size:13px;';
	close.onclick = function() { popup.remove(); };
	popup.appendChild(close);

	popup.onclick = function(e) { if (e.target === popup) popup.remove(); };
	document.body.appendChild(popup);
});
</script>
{% endblock %}
