{% extends "base.html.twig" %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" type="text/css" href="{{ asset('layout.css', 'admin') }}">
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('layout.js', 'admin') }}"></script>
	<script>
  // 初始化 localforage 数据库名
  localforage.config({
    name: 'EnterpriseFramework'
  });
	</script>
{% endblock %}

{% block body %}
	<div id="app">
		<section class="layout-container">
			<header class="app-header {{ headerState == 'shrunk' ? 'shrunk' : '' }}">
				<div class="admin-left-logo">
					<div class="admin-left-logo-container">
						<div class="admin-logo {{ headerState == 'shrunk' ? 'shrunk' : '' }}">
							<a href="/admin/index">
								<div class="logo-image {{ headerState == 'shrunk' ? 'shrunk' : '' }}" style="background-image: url('{{ asset('logo/logo.png', 'image') }}');"></div>
							</a>
						</div>
					</div>
				</div>
				<div class="admin-header-right">
					<div class="header-helper">
						<a href="" class="admin-help-link">
							<div>
								<span class="universe-icon helper">
									<i class="fa-regular fa-circle-question"></i>
								</span>
							</div>
						</a>
					</div>
					<div class="hSeperater"></div>
					<span>
						<div class="module-container">
							<div class="module-icon-container {{ headerState == 'shrunk' ? 'shrunk' : '' }}">
								<span class="universe-icon">
									<a class="fa-brands fa-symfony" href="/_profiler/empty/search/results?limit=20" target="_blank"></a>
								</span>
							</div>
						</div>
					</span>
					<span>
						<div class="hPerson-container">
							<div class="hPerson-control">
								<div class="hPerson-avatar-box {{ headerState == 'shrunk' ? 'shrunk' : '' }}">
									<div class="hPerson-avatar" style="display: {{ headerState == 'shrunk' ? 'none' : 'block' }}">
										{% if app.user %}
											{% if app.user.avatar is defined and app.user.avatar %}
												<img src="{{ app.user.avatar }}" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">
											{% else %}
												{{ (app.user.name|default(app.user.userIdentifier))|slice(-2) }}
											{% endif %}
										{% else %}
											Guest
										{% endif %}
									</div>
									<div class="hPerson-content">
										<div class="hPerson-name">
											{% if app.user %}
												{{ app.user.englishName|default(app.user.name|default(app.user.userIdentifier)) }}
											{% else %}
												Guest User
											{% endif %}
										</div>
									</div>
									<div class="hPerson-caret">
										<i class="fa-solid fa-angle-down"></i>
									</div>
								</div>
							</div>
							<div class="dropdown-menu hidden">
								<div class="dropdown-close-icon" onclick="$('.dropdown-menu.hidden').hide('slow', 'swing')">
									<i class="fa-solid fa-xmark"></i>
								</div>
								<div class="dropdown-header">
									<div class="align-items-center">
										<span>
											<div class="hPerson-avatar">
												{% if app.user %}
													{% if app.user.avatar is defined and app.user.avatar %}
														<img src="{{ app.user.avatar }}" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">
													{% else %}
														{{ (app.user.name|default(app.user.userIdentifier))|slice(-2) }}
													{% endif %}
												{% else %}
													Guest
												{% endif %}
											</div>
										</span>
										<div class="hPerson-info-text">
											<div class="hPerson-info-title">
												{% if app.user %}
													{% if app.user.position is defined and app.user.position %}
														{{ app.user.position.name }}
													{% endif %}
													{{ app.user.name|default(app.user.userIdentifier) }}
												{% else %}
													Guest User
												{% endif %}
											</div>
											<div class="text-content">
												{{ app.user and app.user.email is defined ? app.user.email : '' }}
											</div>
										</div>
									</div>
								</div>
								<div class="dropdown-divider" style="margin: 0!important;"></div>
								<a href="#" class="dropdown-item">
									<span>{{ "layout.user.settings"|trans }}</span>
								</a>
								<div class="dropdown-divider" style="margin: 0!important;"></div>
								<div class="dropdown-multilevel">
									<div class="dropdown-item">
										<span>{{ "layout.user.language"|trans }}</span>
										<i class="fa-solid fa-angle-right"></i>
									</div>
									<div class="dropdown-menu">
										<a href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge(app.request.query.all)|merge({'_locale': 'zh_CN'})) }}" class="dropdown-item">{{ "layout.language.zh"|trans }}</a>
										<a href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge(app.request.query.all)|merge({'_locale': 'en'})) }}" class="dropdown-item">{{ "layout.language.en"|trans }}</a>
									</div>
								</div>
								<div class="dropdown-divider" style="margin: 0!important;"></div>
								<a href="{{ path('app_logout') }}" class="dropdown-item">
									<span>{{ "layout.user.logout"|trans }}</span>
								</a>
							</div>
						</div>
					</span>
				</div>
				<div class="header-toggle">
						<button id="toggle-header-button">
								<i class="fa-solid fa-angle-up"></i> <!-- 向上箭头图标 -->
						</button>
				</div>
			</header>
			<section class="app-body">
				{% include "admin/static/menu.html.twig" %}
				<section class="app-content-container">
        {% block app_content_container %}{% endblock %}
        </section>
			</section>
		</section>
	</div>
{% endblock %}
