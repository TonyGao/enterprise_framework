{% extends "admin/layout.html.twig" %}

{% block title %}狗狗框架 | Enterprise Framework{% endblock %}

{% block css %}
<style>
  /* =============================================
     Home page - Enterprise Framework / 狗狗框架
     ============================================= */

  .app-content-container {
    padding: 0;
    overflow-y: auto;
    background: #f5f6fa;
  }

  /* ---- Hero Section ---- */
  .home-hero {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 40%, #0f3460 100%);
    padding: 64px 48px 80px;
    color: #fff;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-start;
    gap: 48px;
    min-height: 380px;
  }

  .home-hero::before {
    content: '';
    position: absolute;
    top: -60%;
    right: -5%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(51,112,255,0.08) 0%, transparent 70%);
    border-radius: 50%;
  }

  .home-hero::after {
    content: '';
    position: absolute;
    bottom: -40%;
    left: 30%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(99,102,241,0.06) 0%, transparent 70%);
    border-radius: 50%;
  }

  .home-hero-content {
    position: relative;
    z-index: 1;
    flex: 1;
  }

  .home-hero-brand {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-bottom: 24px;
  }

  .home-hero-logo {
    width: 72px;
    height: 72px;
    border-radius: 16px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.3);
    flex-shrink: 0;
  }

  .home-hero-brand-text h1 {
    font-size: 38px;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.5px;
    line-height: 1.2;
  }

  .home-hero-brand-sub {
    font-size: 15px;
    opacity: 0.6;
    margin-top: 4px;
    font-weight: 400;
    letter-spacing: 1px;
  }

  .home-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 16px;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 20px;
    font-size: 12px;
    margin-bottom: 16px;
    backdrop-filter: blur(4px);
    color: rgba(255,255,255,0.8);
  }

  .home-hero-desc {
    font-size: 15px;
    opacity: 0.75;
    line-height: 1.8;
    max-width: 560px;
    margin-bottom: 32px;
  }

  .home-hero-stats {
    display: flex;
    gap: 48px;
  }

  .home-hero-stat {
    text-align: left;
  }

  .home-hero-stat-num {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.3px;
  }

  .home-hero-stat-label {
    font-size: 12px;
    opacity: 0.55;
    margin-top: 2px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* ---- Quick Actions ---- */
  .home-quick-actions {
    padding: 32px 48px;
    display: flex;
    gap: 16px;
  }

  .home-quick-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 24px;
    background: #fff;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    color: #1f2329;
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
  }

  .home-quick-btn:hover {
    border-color: #3370ff;
    color: #3370ff;
    box-shadow: 0 2px 8px rgba(51,112,255,0.1);
    transform: translateY(-1px);
  }

  .home-quick-btn i {
    font-size: 16px;
    color: #3370ff;
  }

  /* ---- Sections ---- */
  .home-section {
    padding: 40px 48px;
  }

  .home-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 28px;
  }

  .home-section-title {
    font-size: 20px;
    font-weight: 600;
    color: #1f2329;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .home-section-title .title-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    color: #fff;
    background: #3370ff;
  }

  .home-section-more {
    font-size: 13px;
    color: #86909c;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 4px;
    transition: color 0.2s;
  }

  .home-section-more:hover {
    color: #3370ff;
  }

  /* ---- Feature Cards ---- */
  .home-feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .home-feature-card {
    background: #fff;
    border-radius: 12px;
    padding: 28px 24px;
    border: 1px solid #f0f0f5;
    transition: all 0.25s;
    cursor: default;
    position: relative;
  }

  .home-feature-card:hover {
    border-color: #e0e3eb;
    box-shadow: 0 8px 24px rgba(31, 35, 41, 0.06);
    transform: translateY(-3px);
  }

  .home-feature-card-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    margin-bottom: 18px;
    transition: transform 0.25s;
  }

  .home-feature-card:hover .home-feature-card-icon {
    transform: scale(1.05);
  }

  .home-feature-card-icon.indigo {
    background: #eef2ff;
    color: #4f46e5;
  }

  .home-feature-card-icon.emerald {
    background: #ecfdf5;
    color: #059669;
  }

  .home-feature-card-icon.amber {
    background: #fffbeb;
    color: #d97706;
  }

  .home-feature-card-icon.violet {
    background: #f5f3ff;
    color: #7c3aed;
  }

  .home-feature-card-icon.teal {
    background: #f0fdfa;
    color: #0d9488;
  }

  .home-feature-card-icon.rose {
    background: #fff1f2;
    color: #e11d48;
  }

  .home-feature-card h3 {
    font-size: 15px;
    font-weight: 600;
    color: #1f2329;
    margin: 0 0 8px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .home-feature-badge {
    display: inline-block;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 500;
    color: #d97706;
    background: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: 4px;
    white-space: nowrap;
  }

  .home-feature-card p {
    font-size: 13px;
    color: #6b7280;
    line-height: 1.7;
    margin: 0;
  }

  .home-feature-card-footer {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid #f3f4f6;
    font-size: 12px;
    color: #9ca3af;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* ---- Advantages ---- */
  .home-advantage-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .home-advantage-item {
    padding: 20px;
    background: #fff;
    border-radius: 10px;
    border: 1px solid #f0f0f5;
    transition: all 0.2s;
  }

  .home-advantage-item:hover {
    border-color: #e0e3eb;
    box-shadow: 0 4px 16px rgba(31, 35, 41, 0.04);
  }

  .home-advantage-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    background: #eef2ff;
    color: #4f46e5;
    margin-bottom: 14px;
  }

  .home-advantage-item h4 {
    font-size: 14px;
    font-weight: 600;
    color: #1f2329;
    margin: 0 0 6px;
  }

  .home-advantage-item p {
    font-size: 12px;
    color: #6b7280;
    margin: 0;
    line-height: 1.6;
  }

  /* ---- Footer ---- */
  .home-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 48px;
    color: #9ca3af;
    font-size: 13px;
    border-top: 1px solid #e5e6eb;
    background: #fff;
  }

  .home-footer-links {
    display: flex;
    gap: 24px;
  }

  .home-footer-links a {
    color: #9ca3af;
    text-decoration: none;
    transition: color 0.2s;
  }

  .home-footer-links a:hover {
    color: #3370ff;
  }

  /* ---- Dividers ---- */
  .home-divider {
    height: 1px;
    background: linear-gradient(to right, transparent, #e5e6eb, transparent);
    margin: 0;
  }

  /* ---- Responsive ---- */
  @media (max-width: 1200px) {
    .home-feature-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .home-advantage-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .home-hero {
      flex-direction: column;
      padding: 40px 24px;
      gap: 24px;
    }
    .home-hero-stats {
      gap: 24px;
    }
    .home-feature-grid {
      grid-template-columns: 1fr;
    }
    .home-advantage-list {
      grid-template-columns: 1fr;
    }
    .home-section {
      padding: 24px;
    }
  }
</style>
{% endblock %}

{% block app_content_container %}

<!-- ====== Hero Section ====== -->
<div class="home-hero">
  <div class="home-hero-content">
    <div class="home-hero-badge">
      <i class="fa-solid fa-crown"></i> v0.1.0 · 基于 Symfony 7.4 LTS 构建
    </div>
    <div class="home-hero-brand">
      <img src="{{ asset('logo/dog215.png', 'image') }}" alt="狗狗框架" class="home-hero-logo">
      <div class="home-hero-brand-text">
        <h1>狗狗框架</h1>
        <div class="home-hero-brand-sub">ENTERPRISE FRAMEWORK</div>
      </div>
    </div>
    <div class="home-hero-desc">
      基于 Symfony 7.4 LTS 构建的企业级低代码开发平台。提供模型驱动开发、动态表单、可视化视图设计、RESTful API 自动生成等核心能力，助力企业快速构建高质量业务系统。
    </div>
    <div class="home-hero-stats">
      <div class="home-hero-stat">
        <div class="home-hero-stat-num">Symfony 7.4</div>
        <div class="home-hero-stat-label">LTS 全栈框架</div>
      </div>
      <div class="home-hero-stat">
        <div class="home-hero-stat-num">PHP 8.2+</div>
        <div class="home-hero-stat-label">运行环境</div>
      </div>
      <div class="home-hero-stat">
        <div class="home-hero-stat-num">FrankenPHP</div>
        <div class="home-hero-stat-label">应用服务器</div>
      </div>
    </div>
  </div>
</div>

<!-- ====== Core Features ====== -->
<div class="home-section">
  <div class="home-section-header">
    <div class="home-section-title">
      <span class="title-icon"><i class="fa-solid fa-cubes"></i></span>
      核心功能
    </div>
  </div>
  <div class="home-feature-grid">
    <div class="home-feature-card">
      <div class="home-feature-card-icon indigo">
        <i class="fa-solid fa-database"></i>
      </div>
      <h3>模型驱动开发 <span class="home-feature-badge">开发中</span></h3>
      <p>通过可视化界面定义数据模型，自动生成 Doctrine 实体、数据库表、CRUD 接口和后台管理页面，实现从模型到应用的一键生成。</p>
      <div class="home-feature-card-footer">
        <i class="fa-regular fa-clock"></i> 预计 Q3 2025 完成
      </div>
    </div>
    <div class="home-feature-card">
      <div class="home-feature-card-icon emerald">
        <i class="fa-solid fa-paint-brush"></i>
      </div>
      <h3>视图设计器 <span class="home-feature-badge">开发中</span></h3>
      <p>拖拽式可视化视图编辑器，支持自定义布局、组件配置、数据绑定，所见即所得地构建业务页面，无需手写前端代码。</p>
      <div class="home-feature-card-footer">
        <i class="fa-regular fa-clock"></i> 预计 Q3 2025 完成
      </div>
    </div>
    <div class="home-feature-card">
      <div class="home-feature-card-icon amber">
        <i class="fa-solid fa-plug"></i>
      </div>
      <h3>RESTful API 自动生成 <span class="home-feature-badge">开发中</span></h3>
      <p>基于模型定义自动生成标准化 RESTful API，支持 CRUD 操作、关联查询、分页过滤，零代码构建后端接口服务。</p>
      <div class="home-feature-card-footer">
        <i class="fa-regular fa-clock"></i> 预计 Q3 2025 完成
      </div>
    </div>
    <div class="home-feature-card">
      <div class="home-feature-card-icon violet">
        <i class="fa-solid fa-table-list"></i>
      </div>
      <h3>动态数据表格</h3>
      <p>配置化的数据表格组件，支持列定义、排序、筛选、分页、行内编辑、批量操作，自动适配不同数据源。</p>
      <div class="home-feature-card-footer">
        <i class="fa-solid fa-check-circle" style="color: #059669;"></i> 已就绪
      </div>
    </div>
    <div class="home-feature-card">
      <div class="home-feature-card-icon teal">
        <i class="fa-solid fa-sitemap"></i>
      </div>
      <h3>组织架构管理</h3>
      <p>树形组织架构管理，支持公司、部门、岗位、职级体系，灵活的人员归属和权限分配，适配各类企业结构。</p>
      <div class="home-feature-card-footer">
        <i class="fa-solid fa-check-circle" style="color: #059669;"></i> 已就绪
      </div>
    </div>
    <div class="home-feature-card">
      <div class="home-feature-card-icon rose">
        <i class="fa-solid fa-clock"></i>
      </div>
      <h3>定时任务调度</h3>
      <p>内置 Cron 定时任务引擎，支持任务管理、执行日志、日历视图，满足系统自动化运维与定时业务处理需求。</p>
      <div class="home-feature-card-footer">
        <i class="fa-solid fa-check-circle" style="color: #059669;"></i> 已就绪
      </div>
    </div>
  </div>
</div>

<div class="home-divider"></div>

<!-- ====== Tech Advantages ====== -->
<div class="home-section" style="background: #fff;">
  <div class="home-section-header">
    <div class="home-section-title">
      <span class="title-icon" style="background: #7c3aed;"><i class="fa-solid fa-star"></i></span>
      技术优势
    </div>
  </div>
  <div class="home-advantage-list">
    <div class="home-advantage-item">
      <div class="home-advantage-icon"><i class="fa-solid fa-bolt"></i></div>
      <h4>FrankenPHP Worker 模式</h4>
      <p>基于 Caddy + PHP 常驻内存运行，避免传统 FPM 每次请求启动的开销，请求延迟降低 80%，吞吐量提升 3-5 倍。</p>
    </div>
    <div class="home-advantage-item">
      <div class="home-advantage-icon"><i class="fa-solid fa-layer-group"></i></div>
      <h4>Symfony 7.4 LTS 全栈</h4>
      <p>基于 Symfony 7.4 LTS（2025.11 - 2029.11），充分利用 Doctrine ORM、Form、Security、Messenger、Mercure 等核心组件。</p>
    </div>
    <div class="home-advantage-item">
      <div class="home-advantage-icon"><i class="fa-solid fa-puzzle-piece"></i></div>
      <h4>sunui 组件库</h4>
      <p>自研 UI 组件库，包含表格、表单、树、选择器、抽屉、弹窗等 30+ 组件，jQuery 驱动，轻量无框架依赖。</p>
    </div>
    <div class="home-advantage-item">
      <div class="home-advantage-icon"><i class="fa-solid fa-tree"></i></div>
      <h4>Gedmo Nested Set</h4>
      <p>基于 Doctrine Tree 扩展实现高性能树形数据管理，支持菜单、组织架构、视图目录等场景。</p>
    </div>
    <div class="home-advantage-item">
      <div class="home-advantage-icon"><i class="fa-solid fa-code"></i></div>
      <h4>低代码 + 可扩展</h4>
      <p>低代码生成与手写代码无缝融合，生成的代码均为标准 Symfony 组件，可自由修改扩展，不被框架锁定。</p>
    </div>
    <div class="home-advantage-item">
      <div class="home-advantage-icon"><i class="fa-solid fa-satellite-dish"></i></div>
      <h4>Mercure 实时推送</h4>
      <p>基于 Mercure 协议的 SSE 实时通信，支持在线心跳、消息推送、数据同步，无需额外部署 WebSocket。</p>
    </div>
    <div class="home-advantage-item">
      <div class="home-advantage-icon"><i class="fa-solid fa-database"></i></div>
      <h4>多存储后端</h4>
      <p>基于 Flysystem 统一文件存储抽象，支持本地、阿里云 OSS、AWS S3 等多种存储后端，配置切换无需改代码。</p>
    </div>
    <div class="home-advantage-item">
      <div class="home-advantage-icon"><i class="fa-solid fa-shield-halved"></i></div>
      <h4>企业级安全</h4>
      <p>三员分立权限模型、WebAuthn 无密码认证、CSRF 防护、Session 安全管理，满足等保合规要求。</p>
    </div>
  </div>
</div>

<!-- ====== Footer ====== -->
<div class="home-footer">
  <span>狗狗框架 v0.1.0 · Built with Symfony 7.4 &amp; FrankenPHP</span>
  <div class="home-footer-links">
    <a href="#"><i class="fa-regular fa-file-lines"></i> 文档</a>
    <a href="#"><i class="fa-regular fa-circle-question"></i> 帮助</a>
    <a href="#"><i class="fa-brands fa-github"></i> GitHub</a>
  </div>
</div>
{% endblock %}
