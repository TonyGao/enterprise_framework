{% extends 'admin/layout.html.twig' %}

{% block title %}系统日历{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ================================================================
   系统日历页面样式（设计语言与定时任务页面一致）
================================================================ */
.cal-page {
    display: flex;
    flex-direction: column;
    position: absolute;
    inset: 0;
    background: var(--bg-base, #f5f7fb);
    padding: 24px;
    gap: 20px;
    overflow: auto;
    --primary: rgb(22, 93, 255);
    --primary-dark: rgb(18, 79, 216);
}

/* ---- 页头 ---- */
.cal-page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
}
.cal-page-header h1 {
    font-size: 20px;
    font-weight: 700;
    color: var(--text-primary, #1a1d2e);
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
}
.cal-page-header h1 i { color: var(--primary, #165dff); font-size: 18px; }
.cal-header-actions { display: flex; gap: 10px; align-items: center; }

/* ---- 统计卡片 ---- */
.cal-stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    flex-shrink: 0;
}
.stat-card {
    background: #fff;
    border-radius: 12px;
    padding: 20px 24px;
    display: flex;
    align-items: center;
    gap: 16px;
    box-shadow: 0 1px 4px rgba(0,0,0,.06);
    border: 1px solid rgba(0,0,0,.05);
    transition: box-shadow .2s;
}
.stat-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,.10); }
.stat-card-icon {
    width: 48px; height: 48px; border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px; flex-shrink: 0;
}
.stat-card-icon.red    { background: #fee2e2; color: #dc2626; }
.stat-card-icon.orange { background: #ffedd5; color: #ea580c; }
.stat-card-icon.blue   { background: #dbeafe; color: #2563eb; }
.stat-card-icon.gray   { background: #f3f4f6; color: #6b7280; }
.stat-card-value {
    font-size: 26px; font-weight: 700;
    color: var(--text-primary, #1a1d2e); line-height: 1.2;
}
.stat-card-label {
    font-size: 13px; color: var(--text-secondary, #8a8fa8); margin-top: 2px;
}

/* ---- 主内容区 ---- */
.cal-main-card {
    background: #fff;
    border-radius: 14px;
    box-shadow: 0 1px 4px rgba(0,0,0,.06);
    border: 1px solid rgba(0,0,0,.05);
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

/* ---- 工具栏 ---- */
.cal-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 1px solid var(--border, #f0f0f5);
    flex-shrink: 0;
    gap: 12px;
}
.cal-nav-group { display: flex; align-items: center; gap: 8px; }
.cal-nav-btn {
    width: 32px; height: 32px; border-radius: 8px;
    border: 1px solid var(--border, #e5e7ef); background: #fff;
    cursor: pointer; font-size: 13px;
    color: var(--text-secondary, #8a8fa8); transition: all .15s;
    display: flex; align-items: center; justify-content: center;
}
.cal-nav-btn:hover { border-color: var(--primary, #165dff); color: var(--primary, #165dff); }
.cal-month-title {
    font-size: 16px; font-weight: 700; color: var(--text-primary, #1a1d2e);
    min-width: 130px; text-align: center;
}
.cal-today-btn {
    height: 32px; padding: 0 14px; border-radius: 8px;
    border: 1px solid var(--border, #e5e7ef); background: #fff;
    font-size: 13px; color: var(--text-secondary, #8a8fa8);
    cursor: pointer; transition: all .15s;
}
.cal-today-btn:hover { border-color: var(--primary, #165dff); color: var(--primary, #165dff); }

/* ---- 视图 Tab ---- */
.view-tabs {
    display: flex; gap: 0; background: #fff;
    border-radius: 10px; padding: 4px;
    box-shadow: 0 1px 4px rgba(0,0,0,.06);
    border: 1px solid rgba(0,0,0,.05); width: fit-content;
}
.view-tab-btn {
    padding: 6px 16px; border-radius: 7px; border: none;
    background: transparent; font-size: 13px;
    color: var(--text-secondary, #8a8fa8); cursor: pointer;
    display: flex; align-items: center; gap: 6px;
    transition: all .15s; font-weight: 500;
}
.view-tab-btn.active,
.view-tab-btn:hover { background: var(--primary, #165dff); color: #fff; }

/* ---- 图例条 ---- */
.cal-legend-bar {
    display: flex; gap: 18px; align-items: center;
    padding: 8px 20px; border-bottom: 1px solid var(--border, #f0f0f5);
    flex-shrink: 0; flex-wrap: wrap;
}
.cal-legend-item { display: flex; align-items: center; gap: 5px; font-size: 12px; color: var(--text-secondary, #8a8fa8); }
.cal-legend-dot { width: 10px; height: 10px; border-radius: 3px; }

/* ---- 月视图 ---- */
#cal-month-view { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
.cal-weekday-row {
    display: grid; grid-template-columns: repeat(7, 1fr);
    background: var(--bg-base, #f8f9fc);
    border-bottom: 1px solid var(--border, #f0f0f5);
    flex-shrink: 0;
}
.cal-dow-cell {
    padding: 8px 10px; text-align: center; font-size: 11px;
    font-weight: 700; color: var(--text-secondary, #8a8fa8);
    text-transform: uppercase; letter-spacing: .5px;
}
.cal-month-grid {
    flex: 1; display: grid; grid-template-columns: repeat(7, 1fr);
    overflow-y: auto;
}
.cal-day-cell {
    min-height: 110px; padding: 8px;
    border-right: 1px solid var(--border, #f0f0f5);
    border-bottom: 1px solid var(--border, #f0f0f5);
    background: #fff; cursor: pointer; transition: background .12s;
}
.cal-day-cell:hover { background: #f8f9fc; }
.cal-day-cell.other-month { background: var(--bg-base, #fafafa); }
.cal-day-cell.other-month .cal-day-num { color: #d1d5db; }
.cal-day-num {
    font-size: 13px; font-weight: 600; color: var(--text-primary, #374151);
    margin-bottom: 6px; width: 26px; height: 26px;
    display: flex; align-items: center; justify-content: center;
    border-radius: 50%;
}
.cal-day-cell.today .cal-day-num {
    background: var(--primary, #165dff); color: #fff;
}
.cal-event-tag {
    display: flex; align-items: center; gap: 4px;
    padding: 2px 7px; border-radius: 5px; font-size: 11px;
    font-weight: 600; margin-bottom: 2px; cursor: pointer;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    transition: opacity .12s;
}
.cal-event-tag:hover { opacity: .85; }
.cal-event-tag.holiday    { background: #fee2e2; color: #dc2626; }
.cal-event-tag.workday    { background: #ffedd5; color: #ea580c; }
.cal-event-tag.makeup_day { background: #dbeafe; color: #2563eb; }
.cal-event-tag.custom,
.cal-event-tag.company_event { background: #f3f4f6; color: #4b5563; }
.cal-day-more { font-size: 11px; color: var(--text-tertiary, #b0b5cc); padding: 1px 7px; }

/* ---- 事务视图 ---- */
#cal-agenda-view { flex: 1; display: none; overflow: hidden; }
.cal-agenda-list { flex: 1; width: 100%; height: 100%; overflow-y: auto; padding: 16px 20px; }
.cal-agenda-item {
    display: flex; align-items: flex-start; gap: 16px;
    padding: 16px 18px; background: #fff; border-radius: 12px;
    margin-bottom: 10px; border-left: 4px solid #e5e7ef;
    box-shadow: 0 1px 3px rgba(0,0,0,.05); cursor: pointer;
    transition: box-shadow .15s, border-color .15s;
}
.cal-agenda-item:hover { box-shadow: 0 4px 12px rgba(0,0,0,.10); }
.cal-agenda-item.holiday    { border-left-color: #dc2626; }
.cal-agenda-item.workday    { border-left-color: #ea580c; }
.cal-agenda-item.makeup_day { border-left-color: #2563eb; }
.cal-agenda-item.custom,
.cal-agenda-item.company_event { border-left-color: #9ca3af; }
.cal-agenda-date-col { text-align: center; min-width: 44px; flex-shrink: 0; }
.cal-agenda-day { font-size: 30px; font-weight: 800; color: var(--text-primary, #1a1d2e); line-height: 1; }
.cal-agenda-weekday { font-size: 11px; color: var(--text-secondary, #8a8fa8); margin-top: 2px; }
.cal-agenda-body { flex: 1; min-width: 0; }
.cal-agenda-title { font-size: 15px; font-weight: 700; color: var(--text-primary, #1a1d2e); }
.cal-agenda-sub { display: flex; align-items: center; gap: 8px; margin-top: 5px; flex-wrap: wrap; }
.type-badge {
    display: inline-block; padding: 2px 9px; border-radius: 99px; font-size: 11px; font-weight: 500;
}
.type-badge.holiday    { background: #fee2e2; color: #dc2626; }
.type-badge.workday    { background: #ffedd5; color: #ea580c; }
.type-badge.makeup_day { background: #dbeafe; color: #2563eb; }
.type-badge.custom,
.type-badge.company_event { background: #f3f4f6; color: #4b5563; }
.cal-agenda-note { font-size: 12px; color: var(--text-secondary, #8a8fa8); }

/* ---- 空状态 ---- */
.cal-empty {
    display: flex; flex-direction: column; align-items: center;
    justify-content: center; height: 100%; min-height: 360px;
    color: var(--text-tertiary, #b0b5cc);
}
.cal-empty i { font-size: 72px; margin-bottom: 24px; }
.cal-empty p { font-size: 16px; margin: 0; }

/* ---- 导入弹窗 ---- */
.cal-import-tip {
    margin-top: 4px; font-size: 12px; line-height: 1.6;
    color: var(--text-secondary, #8a8fa8);
}
.cal-import-result {
    margin-top: 10px; min-height: 108px; border-radius: 12px;
    border: 1px solid var(--border, #eaecf4); background: var(--bg-base, #f8f9fc);
    padding: 16px; color: var(--text-primary, #1a1d2e);
}
.cal-import-result-empty {
    display: flex; align-items: center; justify-content: center; text-align: center;
    color: var(--text-tertiary, #b0b5cc);
}
.cal-import-summary { display: flex; gap: 10px; flex-wrap: wrap; }
.cal-import-chip {
    min-width: 92px; padding: 10px 12px; border-radius: 10px;
    background: #fff; border: 1px solid rgba(0,0,0,.05);
}
.cal-import-chip strong { display: block; font-size: 20px; line-height: 1.1; }
.cal-import-chip span { display: block; margin-top: 4px; font-size: 12px; color: var(--text-secondary, #8a8fa8); }
.cal-import-chip.success strong { color: #16a34a; }
.cal-import-chip.info strong { color: var(--primary, #165dff); }
.cal-import-chip.warn strong { color: #ea580c; }
.cal-import-detail-list {
    margin: 14px 0 0; padding-left: 18px; max-height: 160px; overflow-y: auto;
    color: var(--text-secondary, #5a5f7d); font-size: 12px;
}
.cal-import-detail-list li + li { margin-top: 6px; }

/* ---- 弹窗表单 ---- */
.cal-form-group { margin-bottom: 18px; }
.cal-form-label {
    display: block; font-size: 13px; font-weight: 600;
    color: var(--text-secondary, #5a5f7d); margin-bottom: 6px;
}
.cal-form-label .req { color: #ef4444; margin-left: 2px; }
.cal-form-error { font-size: 12px; color: #ef4444; margin-top: 6px; display: none; }

/* ---- 事务类型管理 ---- */
.type-manager-section { background: #fff; }
.type-manager-header {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 24px;
    background: linear-gradient(135deg, #f8f9fc 0%, #fff 100%);
    border-bottom: 1px solid #e5e7eb;
    flex-wrap: wrap;
}
.type-manager-form {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
    flex-wrap: wrap;
}
.type-manager-form .field-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
}
.type-manager-form .field-label {
    font-size: 11px;
    font-weight: 600;
    color: #8a8fa8;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}
.type-manager-form .field-input {
    display: flex;
    align-items: center;
    gap: 8px;
}
.type-manager-form .ef-input-wrapper {
    flex: 1;
}
.type-color-wrapper {
    display: flex;
    align-items: center;
    gap: 8px;
}
.type-badge-preview {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 500;
}
.type-badge-preview .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
}
.type-key { font-family: monospace; font-size: 12px; color: #8a8fa8; }
.type-label { font-weight: 500; color: #1a1d2e; }
.type-actions-cell { padding: 8px 16px; display: flex; gap: 6px; align-items: center; justify-content: center; }
.type-actions-cell .btn { height: 26px; padding: 0 10px; font-size: 12px; line-height: 26px; border-radius: 6px; border: 1px solid #e5e7ef; background: #fff; color: #374151; }
.type-actions-cell .btn:hover { border-color: #165dff; color: #165dff; }
.type-actions-cell .btn.type-save-btn { background: #165dff; color: #fff; border-color: #165dff; }
.type-actions-cell .btn.type-save-btn:hover { background: #1248d1; border-color: #1248d1; color: #fff; }
.type-system-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 500;
    background: #f3f4f6;
    color: #8a8fa8;
}
.type-custom-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 500;
    background: #e0e7ff;
    color: #4f46e5;
}
.type-color-cell {
    display: flex;
    align-items: center;
    justify-content: center;
}
.color-dot-trigger {
    cursor: pointer;
}
.color-dot-trigger:hover {
    outline: 2px solid #4a86e8;
    outline-offset: 1px;
    border-radius: 6px;
}

/* ---- 按钮 ---- */
.btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 0 16px; height: 36px; border-radius: 8px;
    font-size: 13px; font-weight: 500; cursor: pointer;
    border: 1px solid transparent; transition: all .15s;
    text-decoration: none; white-space: nowrap;
}
.btn-primary {
    background: var(--primary, #165dff); color: #fff;
    border-color: var(--primary, #165dff);
}
.btn-primary:hover {
    background: var(--primary-dark, #1248d1);
    border-color: var(--primary-dark, #1248d1); color: #fff;
}
.btn[disabled] {
    opacity: .45;
    cursor: not-allowed;
    pointer-events: none;
}
.btn-default {
    background: #fff; color: var(--text-secondary, #5a5f7d);
    border-color: var(--border, #e5e7ef);
}
.btn-default:hover { border-color: var(--primary, #165dff); color: var(--primary, #165dff); }
.btn-danger { background: #fef2f2; color: #ef4444; border-color: #fecaca; }
.btn-danger:hover { background: #ef4444; color: #fff; border-color: #ef4444; }

/* ---- Toast ---- */
.cal-toast-wrap {
    position: fixed; bottom: 28px; right: 28px; z-index: 9999;
    display: flex; flex-direction: column; gap: 8px; pointer-events: none;
}
.toast-item {
    background: #1a1d2e; color: #fff; padding: 12px 18px; border-radius: 10px;
    font-size: 13px; box-shadow: 0 8px 24px rgba(0,0,0,.2);
    display: flex; align-items: center; gap: 8px;
    animation: toast-in .3s ease; pointer-events: auto;
}
.toast-item.success i { color: #2dbe78; }
.toast-item.error   i { color: #ef4444; }
@keyframes toast-in {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
}

@media (max-width: 1200px) {
    .cal-stats-row { grid-template-columns: repeat(2, 1fr); }
}
</style>
{% endblock %}

{% block app_content_container %}
<div class="cal-page">

    {# ---- 页头 ---- #}
    <div class="cal-page-header">
        <h1>
            <i class="fa-solid fa-calendar-days"></i>
            系统日历
        </h1>
        <div class="cal-header-actions">
            <button class="btn btn-default" onclick="CalMgr.openImportModal()">
                <i class="fa-solid fa-cloud-arrow-down"></i> 导入假日
            </button>
            <button class="btn btn-primary" onclick="CalMgr.openCreate()">
                <i class="fa-solid fa-plus"></i> 添加事件
            </button>
            <button class="btn btn-default" onclick="CalMgr.openTypeManager()">
                <i class="fa-solid fa-tags"></i> 事务类型
            </button>
        </div>
    </div>

    {# ---- 统计卡片 ---- #}
    <div class="cal-stats-row">
        <div class="stat-card">
            <div class="stat-card-icon red"><i class="fa-solid fa-umbrella-beach"></i></div>
            <div>
                <div class="stat-card-value" id="stat-holiday">—</div>
                <div class="stat-card-label">本月法定假日</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-icon orange"><i class="fa-solid fa-briefcase"></i></div>
            <div>
                <div class="stat-card-value" id="stat-workday">—</div>
                <div class="stat-card-label">本月补班上班</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-icon blue"><i class="fa-solid fa-bed"></i></div>
            <div>
                <div class="stat-card-value" id="stat-makeup">—</div>
                <div class="stat-card-label">本月调休休息</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-icon gray"><i class="fa-solid fa-tag"></i></div>
            <div>
                <div class="stat-card-value" id="stat-custom">—</div>
                <div class="stat-card-label">本月其他事务</div>
            </div>
        </div>
    </div>

    {# ---- 主内容卡片 ---- #}
    <div class="cal-main-card">

        {# 工具栏 #}
        <div class="cal-toolbar">
            <div class="cal-nav-group">
                <button class="cal-nav-btn" onclick="CalMgr.nav(-1)" data-tip="上一月">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>
                <button class="cal-nav-btn" onclick="CalMgr.nav(1)" data-tip="下一月">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
                <button class="cal-today-btn" onclick="CalMgr.goToday()">今天</button>
                <span class="cal-month-title" id="cal-month-title">—</span>
            </div>
            <div class="view-tabs">
                <button class="view-tab-btn active" data-view="month" onclick="CalMgr.switchView('month')">
                    <i class="fa-solid fa-calendar-days"></i> 月视图
                </button>
                <button class="view-tab-btn" data-view="agenda" onclick="CalMgr.switchView('agenda')">
                    <i class="fa-solid fa-list"></i> 事务视图
                </button>
            </div>
        </div>

        {# 图例 #}
        <div class="cal-legend-bar">
            <div class="cal-legend-item">
                <div class="cal-legend-dot" style="background:#dc2626;"></div> 法定假日
            </div>
            <div class="cal-legend-item">
                <div class="cal-legend-dot" style="background:#ea580c;"></div> 补班上班
            </div>
            <div class="cal-legend-item">
                <div class="cal-legend-dot" style="background:#2563eb;"></div> 调休休息
            </div>
            <div class="cal-legend-item">
                <div class="cal-legend-dot" style="background:#6b7280;"></div> 自定义事务
            </div>
        </div>

        {# 月视图 #}
        <div id="cal-month-view">
            <div class="cal-weekday-row">
                <div class="cal-dow-cell">一</div>
                <div class="cal-dow-cell">二</div>
                <div class="cal-dow-cell">三</div>
                <div class="cal-dow-cell">四</div>
                <div class="cal-dow-cell">五</div>
                <div class="cal-dow-cell">六</div>
                <div class="cal-dow-cell">日</div>
            </div>
            <div class="cal-month-grid" id="cal-month-grid"></div>
        </div>

        {# 事务视图 #}
        <div id="cal-agenda-view">
            <div class="cal-agenda-list" id="cal-agenda-list"></div>
        </div>

    </div>{# /cal-main-card #}

</div>{# /cal-page #}

{# ---- 新建/编辑事件模态框 ---- #}
<div class="ef-modal-container" id="cal-event-modal" style="z-index: 1001; display: none;">
    <div class="ef-modal-mask" onclick="CalMgr.closeModal()"></div>
    <div class="ef-modal-wrapper ef-modal-wrapper-align-center">
        <div class="ef-modal" style="width: 480px; max-width: 96vw; max-height: 90vh; overflow: hidden; display: flex; flex-direction: column;">
            <div class="ef-modal-header">
                <div class="ef-modal-title ef-modal-title-align-left" id="cal-modal-title">添加事件</div>
                <div tabindex="-1" role="button" aria-label="Close" class="ef-modal-close-btn" onclick="CalMgr.closeModal()">
                    <span class="ef-icon-hover">
                        <svg viewbox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" class="ef-icon ef-icon-close" stroke-width="4" stroke-linecap="butt" stroke-linejoin="miter">
                            <path d="M9.857 9.858 24 24m0 0 14.142 14.142M24 24 38.142 9.858M24 24 9.857 38.142"></path>
                        </svg>
                    </span>
                </div>
            </div>
            <div class="ef-modal-body" style="overflow-y: auto; flex: 1;">
                <input type="hidden" id="cal-event-id">
                <div class="cal-form-group">
