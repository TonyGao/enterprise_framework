{% block javascripts %}
{{ parent() }}
<script src="{{ asset('platform/color_picker.js', 'admin') }}"></script>
<script>
const CalMgr = (function ($) {
    'use strict';
    const BASE = '/admin/calendar/api';
    const WEEK_DAYS = ['一', '二', '三', '四', '五', '六', '日'];
    // 动态加载的类型映射：key -> {label,color,sort}
    let typesMap = {};

    function loadTypes() {
        return request('GET', BASE + '/types').then(function (data) {
            var list = Array.isArray(data) ? data : [];
            typesMap = {};
            list.forEach(function (t) { typesMap[t.key] = t; });
            // 更新事件模态的 ef-select 选项
            var $opts = $('#f-cal-type-options');
            $opts.empty();
            list.forEach(function (t) {
                $opts.append('<li class="ef-select-option" value="' + t.key + '"><span class="ef-select-option-content">' + esc(t.label) + '</span></li>');
            });
            // 默认选中第一项
            if (list.length > 0) setTypeSelect(list[0].key, list[0].label);
            // 更新图例条
            var legendHtml = '';
            list.forEach(function (t) {
                legendHtml += '<div class="cal-legend-item"><div class="cal-legend-dot" style="background:' + (t.color || '#9ca3af') + '"></div> ' + esc(t.label) + '</div>';
            });
            $('.cal-legend-bar').html(legendHtml);
            // 更新类型管理列表（如果打开）
            renderTypeManager(list);
            return list;
        });
    }

    function renderTypeManager(list) {
        if (!$('#type-manager-list').length) return;
        if (!list || list.length === 0) {
            $('#type-manager-list').html('<tr class="ef-table-tr"><td colspan="5" class="ef-table-td"><span class="ef-table-cell ef-table-cell-align-center" style="color:#8a8fa8;padding:40px;">暂无事务类型</span></td></tr>');
            return;
        }
        var html = '';
        list.forEach(function (t) {
            var isSystem = t.isSystem;
            var color = t.color || '#6b7280';
            html += '<tr class="ef-table-tr" data-key="' + esc(t.key) + '" data-editing="false">'
                + '<td class="ef-table-td"><span class="ef-table-cell ef-table-cell-align-center">'
                + '<span class="type-color-dot color-dot-trigger" data-color="' + esc(color) + '" style="display:inline-block;width:28px;height:28px;border-radius:6px;background:' + color + ';box-shadow:0 0 0 2px #fff,0 0 0 3px #e5e7eb;vertical-align:middle;"></span>'
                + '</span></td>'
                + '<td class="ef-table-td"><span class="ef-table-cell ef-table-cell-align-left"><code class="type-key">' + esc(t.key) + '</code></span></td>'
                + '<td class="ef-table-td"><span class="ef-table-cell ef-table-cell-align-left">'
                + '<span class="type-label-view">' + esc(t.label) + '</span>'
                + '<span class="ef-input-wrapper ef-input-rounded" style="display:none;"><input type="text" class="ef-input ef-input-size-medium text type-label-input" value="' + esc(t.label) + '"></span>'
                + '</span></td>'
                + '<td class="ef-table-td"><span class="ef-table-cell ef-table-cell-align-center">' + (isSystem ? '<span class="type-system-badge">系统类型</span>' : '<span class="type-custom-badge">自定义</span>') + '</span></td>'
                + '<td class="ef-table-td"><span class="ef-table-cell ef-table-cell-align-center">'
                + '<button class="btn secondary medium type-edit-btn"><i class="fa-solid fa-pen"></i> 编辑</button>'
                + '<button class="btn primary medium type-save-btn" style="display:none;"><i class="fa-solid fa-check"></i> 保存</button>'
                + '<button class="btn default medium type-cancel-btn" style="display:none;"><i class="fa-solid fa-xmark"></i> 取消</button>'
                + '</span></td>'
                + '</tr>';
        });
        $('#type-manager-list').html(html);
        // 颜色选择器：点击色块打开 ColorPicker
        $('.type-color-dot').off('click').on('click', function (e) {
            e.stopPropagation();
            var $dot = $(this);
            if ($dot.closest('tr').attr('data-editing') !== 'true') return;
            var currentColor = $dot.data('color') || '#6b7280';
            if (!window.typeRowColorPicker) {
                window.typeRowColorPicker = new ColorPicker({
                    container: document.body,
                    defaultColor: currentColor,
                    onChange: function(color) {
                        var $activeDot = window._activeTypeColorDot;
                        if ($activeDot) {
                            $activeDot.css('background', color).attr('data-color', color);
                        }
                    }
                });
            }
            window._activeTypeColorDot = $dot;
            window.typeRowColorPicker.setColor(currentColor);
            window.typeRowColorPicker.open(this);
        });
        // 编辑按钮
        $('#type-manager-list .type-edit-btn').off('click').on('click', function () {
            var $row = $(this).closest('tr');
            $row.attr('data-editing', 'true');
            // 颜色色块保持可见，用于点击触发 ColorPicker
            $row.find('.type-label-view').hide();
            $row.find('.type-label-input').closest('.ef-input-wrapper').show();
            $row.find('.type-edit-btn').hide();
            $row.find('.type-save-btn').show();
            $row.find('.type-cancel-btn').show();
        });
        // 保存按钮
        $('#type-manager-list .type-save-btn').off('click').on('click', function () {
            var $row = $(this).closest('tr');
            var key = $row.data('key');
            var label = $row.find('.type-label-input').val().trim();
            var color = $row.find('.type-color-dot').data('color') || '#6b7280';
            if (!label) { toast('名称不能为空', 'error'); return; }
            request('PUT', BASE + '/type/' + encodeURIComponent(key), { label: label, color: color }).then(function () { loadTypes(); toast('已保存', 'success'); });
        });
        // 取消按钮
        $('#type-manager-list .type-cancel-btn').off('click').on('click', function () {
            loadTypes();
        });
    }

    function rgbToHex(rgb) {
        if (rgb.startsWith('#')) return rgb;
        var match = rgb.match(/^rgb\((\d+),\s*(\d+),\s*(\d+)\)$/);
        if (!match) return rgb;
        return '#' + [match[1], match[2], match[3]].map(function (x) {
            return parseInt(x).toString(16).padStart(2, '0');
        }).join('');
    }

    const state = {
        view:   'month',
        year:   new Date().getFullYear(),
        month:  new Date().getMonth() + 1,
        events: [],
    };

    // ─── 网络请求 ──────────────────────────────────────────────────────────
    function request(method, url, data) {
        return $.ajax({
            method,
            url,
            contentType: 'application/json',
            data: data ? JSON.stringify(data) : undefined,
        }).then(function (res) {
            if (typeof res.data === 'string') {
                try { return JSON.parse(res.data); } catch (e) { return res.data; }
            }
            return res.data !== undefined ? res.data : res;
        }).fail(function (xhr) {
            console.error('CalMgr request failed', xhr);
            toast(xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : '操作失败', 'error');
        });
    }

    // ─── 数据加载 ──────────────────────────────────────────────────────────
    function loadEvents() {
        request('GET', BASE + '/events?year=' + state.year + '&month=' + state.month).then(function (events) {
            state.events = Array.isArray(events) ? events : [];
            updateStats();
            render();
        });
    }

    function updateStats() {
        var ev = state.events;
        $('#stat-holiday').text(ev.filter(function (e) { return e.type === 'holiday'; }).length);
        $('#stat-workday').text(ev.filter(function (e) { return e.type === 'workday'; }).length);
        $('#stat-makeup').text(ev.filter(function (e) { return e.type === 'makeup_day'; }).length);
        $('#stat-custom').text(ev.filter(function (e) { return e.type !== 'holiday' && e.type !== 'workday' && e.type !== 'makeup_day'; }).length);
    }

    // ─── 渲染 ──────────────────────────────────────────────────────────────
    function render() {
        updateTitle();
        if (state.view === 'month') renderMonth(); else renderAgenda();
    }

    function updateTitle() {
        $('#cal-month-title').text(state.year + ' 年 ' + state.month + ' 月');
    }

    // ─── 月视图 ────────────────────────────────────────────────────────────
    function renderMonth() {
        var today = new Date(); today.setHours(0, 0, 0, 0);
        var firstDay = new Date(state.year, state.month - 1, 1);
        var lastDay  = new Date(state.year, state.month, 0);

        var startDow = firstDay.getDay();
        startDow = startDow === 0 ? 6 : startDow - 1; // Mon=0

        var cells = [];
        for (var i = startDow - 1; i >= 0; i--) {
            var d = new Date(firstDay); d.setDate(d.getDate() - i - 1);
            cells.push({ date: d, otherMonth: true });
        }
        for (var dd = 1; dd <= lastDay.getDate(); dd++) {
            cells.push({ date: new Date(state.year, state.month - 1, dd), otherMonth: false });
        }
        var rows = Math.ceil(cells.length / 7);
        while (cells.length < rows * 7) {
            var last = cells[cells.length - 1].date;
            var next = new Date(last); next.setDate(next.getDate() + 1);
            cells.push({ date: next, otherMonth: true });
        }

        var eventMap = {};
        for (var ei = 0; ei < state.events.length; ei++) {
            var ev = state.events[ei];
            if (!eventMap[ev.date]) eventMap[ev.date] = [];
            eventMap[ev.date].push(ev);
        }

        var html = '';
        for (var ci = 0; ci < cells.length; ci++) {
            var cell = cells[ci];
            var key  = fmt(cell.date);
            var evs  = eventMap[key] || [];
            var isToday = cell.date.toDateString() === today.toDateString();
            var cls = 'cal-day-cell' + (cell.otherMonth ? ' other-month' : '') + (isToday ? ' today' : '');
            var dateStr = fmt(cell.date);

            html += '<div class="' + cls + '" onclick="CalMgr.openCreate(\'' + dateStr + '\')">';
            html += '<div class="cal-day-num">' + cell.date.getDate() + '</div>';
            for (var ti = 0; ti < Math.min(evs.length, 3); ti++) {
                var ev = evs[ti];
                html += '<div class="cal-event-tag ' + (ev.type || 'custom') + '" title="' + esc(ev.title) + '" onclick="event.stopPropagation();CalMgr.openEdit(\'' + ev.id + '\')">' + esc(ev.title) + '</div>';
            }
            if (evs.length > 3) {
                html += '<div class="cal-day-more">+' + (evs.length - 3) + ' 更多</div>';
            }
            html += '</div>';
        }
        $('#cal-month-grid').html(html);
    }

    function fmt(d) {
        return d.getFullYear() + '-' +
            String(d.getMonth() + 1).padStart(2, '0') + '-' +
            String(d.getDate()).padStart(2, '0');
    }

    // ─── 事务视图 ──────────────────────────────────────────────────────────
    function renderAgenda() {
        var sorted = state.events.slice().sort(function (a, b) {
            return (a.date || '').localeCompare(b.date || '');
        });
        if (!sorted.length) {
            $('#cal-agenda-list').html('<div class="cal-empty"><i class="fa-regular fa-calendar-xmark"></i><p>本月暂无事件</p></div>');
            return;
        }

        var html = '';
        for (var i = 0; i < sorted.length; i++) {
            var ev    = sorted[i];
            var parts = (ev.date || '').split('-');
            var day   = parts[2] ? parseInt(parts[2], 10) : '?';
            var dow   = ev.date ? WEEK_DAYS[(new Date(ev.date).getDay() + 6) % 7] : '';
            var label = (typesMap[ev.type] && typesMap[ev.type].label) || ev.type;
            html += '<div class="cal-agenda-item ' + (ev.type || 'custom') + '" onclick="CalMgr.openEdit(\'' + ev.id + '\')">';
            html += '<div class="cal-agenda-date-col">';
            html += '<div class="cal-agenda-day">' + day + '</div>';
            html += '<div class="cal-agenda-weekday">周' + dow + '</div>';
            html += '</div>';
            html += '<div class="cal-agenda-body">';
            html += '<div class="cal-agenda-title">' + esc(ev.title) + '</div>';
            html += '<div class="cal-agenda-sub">';
            html += '<span class="type-badge ' + (ev.type || 'custom') + '">' + label + '</span>';
            if (ev.note) html += '<span class="cal-agenda-note">' + esc(ev.note) + '</span>';
            if (ev.recurring) html += '<i class="fa-solid fa-rotate" style="color:#9ca3af;font-size:11px;" data-tip="每年重复"></i>';
            html += '</div>';
            html += '</div>';
            html += '</div>';
        }
        $('#cal-agenda-list').html(html);
    }

    // ─── 导航 ──────────────────────────────────────────────────────────────
    function nav(delta) {
        state.month += delta;
        if (state.month > 12) { state.month = 1;  state.year++; }
        if (state.month < 1)  { state.month = 12; state.year--; }
        loadEvents();
    }

    function goToday() {
        var now = new Date();
        state.year  = now.getFullYear();
        state.month = now.getMonth() + 1;
        loadEvents();
    }

    function switchView(view) {
        state.view = view;
        document.querySelectorAll('.view-tab-btn[data-view]').forEach(function (b) {
            b.classList.toggle('active', b.dataset.view === view);
        });
        $('#cal-month-view').toggle(view === 'month');
        $('#cal-agenda-view').css('display', view === 'agenda' ? 'flex' : 'none');
        render();
    }

    // ─── 模态框 ────────────────────────────────────────────────────────────
    function openCreate(date) {
        resetForm();
        initDatePickerOnce();
        $('#cal-modal-title').text('添加事件');
        $('#cal-btn-delete').hide();
        if (date) $('#f-cal-date').val(date);
        $('#cal-event-modal').show();
        setTimeout(function () { $('#f-cal-title').focus(); }, 50);
    }

    function openEdit(id) {
        var ev = null;
        for (var i = 0; i < state.events.length; i++) {
            if (state.events[i].id === id) { ev = state.events[i]; break; }
        }
        if (!ev) return;
        resetForm();
        initDatePickerOnce();
        $('#cal-modal-title').text('编辑事件');
        $('#cal-btn-delete').show();
        $('#cal-event-id').val(ev.id);
        $('#f-cal-title').val(ev.title);
        // 设置 ef-select 类型
        var typeKey = ev.type || 'custom';
        var $typeOpt = $('#f-cal-type-options .ef-select-option[value="' + typeKey + '"]');
        if ($typeOpt.length) setTypeSelect(typeKey, $typeOpt.children('.ef-select-option-content').text());
        $('#f-cal-date').val(ev.date || '');
        setEfCheckbox('f-cal-recurring-label', !!ev.recurring);
        $('#f-cal-note').val(ev.note || '');
        $('#cal-event-modal').show();
    }

    function closeModal() {
        $('#cal-event-modal').hide();
    }

    // ef-checkbox 状态同步辅助
    var EF_CHECK_ICON = '<svg aria-hidden="true" focusable="false" viewBox="0 0 1024 1024" width="200" height="200" fill="currentColor" class="ef-checkbox-icon-check"><path d="M877.44815445 206.10060629a64.72691371 64.72691371 0 0 0-95.14856334 4.01306852L380.73381888 685.46812814 235.22771741 533.48933518a64.72691371 64.72691371 0 0 0-92.43003222-1.03563036l-45.82665557 45.82665443a64.72691371 64.72691371 0 0 0-0.90617629 90.61767965l239.61903446 250.10479331a64.72691371 64.72691371 0 0 0 71.19960405 15.14609778 64.33855261 64.33855261 0 0 0 35.08198741-21.23042702l36.24707186-42.71976334 40.5190474-40.77795556-3.36579926-3.49525333 411.40426297-486.74638962a64.72691371 64.72691371 0 0 0-3.88361443-87.64024149l-45.3088404-45.43829334z" p-id="840"></path></svg>';
    function setEfCheckbox(labelId, checked) {
        var $label = $('#' + labelId);
        var $icon  = $label.find('.ef-checkbox-icon');
        var $hover = $label.find('.ef-checkbox-icon-hover');
        $label.toggleClass('ef-checkbox-checked', checked);
        $hover.toggleClass('ef-icon-hover-disabled', checked);
        $icon.html(checked ? EF_CHECK_ICON : '');
        $label.find('.ef-checkbox-target').prop('checked', checked);
    }

    function setTypeSelect(key, label) {
        var $hidden = $('#f-cal-type');
        var $select = $('#f-cal-type-select');
        $hidden.val(key);
        $select.attr('chosen', 'true');
        $select.children('.ef-select-view-input').addClass('ef-select-view-input-hidden');
        $select.children('.ef-select-view-value').html(esc(label)).removeClass('ef-select-view-value-hidden');
        var closeIcon = '<i class="fa-regular fa-circle-xmark"></i>';
        $select.children('.ef-select-view-suffix').find('.ef-select-view-icon').html(closeIcon);
        // mark option active
        $('#f-cal-type-options .ef-select-option-active').removeClass('ef-select-option-active');
        $('#f-cal-type-options .ef-select-option[value="' + key + '"]').addClass('ef-select-option-active');
    }

    function resetTypeSelect() {
        var $hidden = $('#f-cal-type');
        var $select = $('#f-cal-type-select');
        $hidden.val('');
        $select.attr('chosen', 'false');
        $select.children('.ef-select-view-input').removeClass('ef-select-view-input-hidden').val('');
        $select.children('.ef-select-view-value').addClass('ef-select-view-value-hidden').html('');
        var expandIcon = '<svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" class="ef-icon ef-icon-expand" stroke-width="4" stroke-linecap="butt" stroke-linejoin="miter" style="transform: rotate(-45deg);"><path d="M7 26v14c0 .552.444 1 .996 1H22m19-19V8c0-.552-.444-1-.996-1H26"></path></svg>';
        $select.children('.ef-select-view-suffix').find('.ef-select-view-icon').html(expandIcon);
        $('#f-cal-type-options .ef-select-option-active').removeClass('ef-select-option-active');
    }

    function initDatePickerOnce() {
        var $input = $('#f-cal-date');
        if ($input.data('daterangepicker')) return;
        $input.daterangepicker({
            ...EFDate.getDefaultOptions('YYYY-MM-DD'),
            singleDatePicker: true,
            showDropdowns: true,
            autoUpdateInput: false
        }).on('apply.daterangepicker', function (ev, picker) {
            $(this).val(picker.startDate.format('YYYY-MM-DD'));
        }).on('cancel.daterangepicker', function (ev, picker) {
            $(this).val('');
        });
    }

    function resetForm() {
        $('#cal-event-id, #f-cal-title, #f-cal-date, #f-cal-note').val('');
        resetTypeSelect();
        // 默认选中第一个类型
        var $firstOpt = $('#f-cal-type-options .ef-select-option:first');
        if ($firstOpt.length) setTypeSelect($firstOpt.attr('value'), $firstOpt.children('.ef-select-option-content').text());
        setEfCheckbox('f-cal-recurring-label', false);
        $('#cal-form-error').hide().text('');
    }

    function saveEvent() {
        var title = $('#f-cal-title').val().trim();
        var date  = $('#f-cal-date').val().trim();
        if (!title) { showError('标题不能为空'); return; }
        if (!date)  { showError('请选择日期');   return; }

        var id        = $('#cal-event-id').val();
        var recurring = $('#f-cal-recurring').is(':checked');
        var dateParts = date.split('-');
        var payload   = {
            title:  title,
            date:   date,
            type:   $('#f-cal-type').val(),
            recurring: recurring,
            note:   $('#f-cal-note').val().trim() || null,
            recurringRule: recurring ? {
                type:  'annual',
                month: parseInt(dateParts[1], 10),
                day:   parseInt(dateParts[2], 10),
            } : null,
        };

        var method = id ? 'PUT'  : 'POST';
        var url    = id ? BASE + '/event/' + id : BASE + '/event';

        request(method, url, payload).then(function () {
            closeModal();
            loadEvents();
            toast(id ? '事件已更新' : '事件已添加', 'success');
        });
    }

    function deleteEvent() {
        var id = $('#cal-event-id').val();
        if (!id || !confirm('确认删除此事件？')) return;
        request('DELETE', BASE + '/event/' + id).then(function () {
            closeModal();
            loadEvents();
            toast('事件已删除', 'success');
        });
    }

    function showError(msg) {
        $('#cal-form-error').text(msg).show();
    }

    // ─── 工具 ──────────────────────────────────────────────────────────────
    function esc(s) {
        return String(s)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function toast(msg, type) {
        type = type || 'success';
        var icon = type === 'success' ? 'fa-circle-check' : 'fa-circle-xmark';
        var $t = $('<div class="toast-item ' + type + '"><i class="fa-solid ' + icon + '"></i>' + esc(msg) + '</div>');
        $('#cal-toast-wrap').append($t);
        setTimeout(function () { $t.fadeOut(300, function () { $t.remove(); }); }, 2800);
    }

    // ─── 初始化 ────────────────────────────────────────────────────────────
    function openTypeManager() {
        loadTypes();
        $('#type-manager-modal').show();
    }

    function openImportModal() {
        $('#f-import-year').val(state.year);
        if (!$('#f-import-source').val()) {
            $('#f-import-source').val('timor');
        }
        resetImportResult();
        $('#holiday-import-modal').show();
    }

    function closeImportModal() {
        $('#holiday-import-modal').hide();
        setImportLoading(false);
    }

    function resetImportResult() {
        $('#cal-import-result')
            .addClass('cal-import-result-empty')
            .html('选择年份和数据源后开始导入');
    }

    function setImportLoading(loading) {
        var $btn = $('#cal-import-submit');
        if (!$btn.data('default-html')) {
            $btn.data('default-html', $btn.html());
        }

        $btn.prop('disabled', loading);
        $btn.html(loading ? '<i class="fa-solid fa-spinner fa-spin"></i> 导入中...' : $btn.data('default-html'));
    }

    function renderImportResult(result) {
        result = result || {};
        var details = Array.isArray(result.details) ? result.details : [];
        var html = '';

        html += '<div class="cal-import-summary">';
        html += '<div class="cal-import-chip success"><strong>' + esc(result.imported || 0) + '</strong><span>新增</span></div>';
        html += '<div class="cal-import-chip info"><strong>' + esc(result.skipped || 0) + '</strong><span>跳过</span></div>';
        html += '<div class="cal-import-chip warn"><strong>' + esc(result.errors || 0) + '</strong><span>错误</span></div>';
        html += '</div>';

        if (details.length) {
            html += '<ul class="cal-import-detail-list">';
            details.slice(0, 12).forEach(function (detail) {
                html += '<li>' + esc(detail) + '</li>';
            });
            html += '</ul>';
        }

        $('#cal-import-result').removeClass('cal-import-result-empty').html(html);
    }

    function importHolidays() {
        var year = parseInt($('#f-import-year').val(), 10);
        var source = $('#f-import-source').val() || 'timor';

        if (!year || year < 2000 || year > 2100) {
            new Alert($('#holiday-import-modal .ef-modal-body')).error('年份范围需在 2000-2100 之间', { percent: '320px', title: '提示', closable: true });
            return;
        }

        setImportLoading(true);

        request('POST', BASE + '/import-holidays', { year: year, source: source })
            .then(function (result) {
                renderImportResult(result);
                state.year = year;
                loadEvents();
                toast('法定假日已导入', 'success');
            })
            .always(function () {
                setImportLoading(false);
            });
    }

    function initColorPickers() {
        if (!window.ColorPicker) return;
        // "新建类型" 颜色选择器
        if (!window.newTypeColorPicker) {
            window.newTypeColorPicker = new ColorPicker({
                container: document.body,
                defaultColor: '#6b7280',
                onChange: function(color) {
                    $('#new-type-color-preview').css('background-color', color);
                }
            });
            $(document).on('click', '#new-type-color-trigger', function(e) {
                e.stopPropagation();
                if (window.newTypeColorPicker) window.newTypeColorPicker.open(this);
            });
        }
    }

    function init() {
        initColorPickers();
        // 先加载类型，再加载事件
        loadTypes().then(function () { loadEvents(); });
        // 新建类型
        $('#new-type-create').on('click', function () {
            var key   = $('#new-type-key').val().trim();
            var label = $('#new-type-label').val().trim();
            var color = $('#new-type-color-preview').css('background-color');
            color = rgbToHex(color) || '#6b7280';
            if (!key || !label) { new Alert($('#type-manager-modal .ef-modal-body')).error('请填写 key 和 名称', {percent: '320px', title: '提示', closable: true}); return; }
            request('POST', BASE + '/type', { key: key, label: label, color: color }).then(function () {
                $('#new-type-key, #new-type-label').val('');
                $('#new-type-color-preview').css('background-color', '#6b7280');
                if (window.newTypeColorPicker) window.newTypeColorPicker.setColor('#6b7280');
                loadTypes();
                toast('已添加', 'success');
            });
        });
    }

    return {
        init:       init,
        nav:        nav,
        goToday:    goToday,
        switchView: switchView,
        openCreate: openCreate,
        openEdit:   openEdit,
        openImportModal: openImportModal,
        closeImportModal: closeImportModal,
        importHolidays: importHolidays,
        closeModal: closeModal,
        openTypeManager: openTypeManager,
        saveEvent:  saveEvent,
        deleteEvent: deleteEvent,
    };

}(jQuery));

$(document).ready(function () { CalMgr.init(); });
</script>
{% endblock %}
