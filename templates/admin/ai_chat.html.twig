<div id="ai-chat-panel" class="ai-chat-panel" style="display: none;">
    <div class="ai-chat-resize-handle" id="ai-chat-resize-handle"></div>
    <div class="ai-chat-header">
        <span>{{ "aiChat.2"|trans }}</span>
        <button class="ai-chat-close" id="ai-chat-close" type="button">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>
    <div class="ai-chat-messages" id="ai-chat-messages">
        <div class="ai-message ai-assistant">
            <div class="ai-message-content">{{ "aiChat.3"|trans }}</div>
        </div>
    </div>
    <div class="ai-chat-attachment" id="ai-chat-attachment" style="display:none;">
        <div class="ai-chat-attachment-body">
            <i class="fa-solid fa-cube"></i>
            <span class="ai-chat-attachment-name" id="ai-chat-attachment-name"></span>
        </div>
        <button class="ai-chat-attachment-line" id="ai-chat-attachment-line" type="button" title="{{ "aiChat.attach.line"|trans }}"><i class="fa-solid fa-crosshairs"></i></button>
        <button class="ai-chat-attachment-remove" id="ai-chat-attachment-remove" type="button" title="{{ "aiChat.attachmentRemove"|trans }}"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="ai-chat-images" id="ai-chat-images" style="display:none;"></div>
    <div class="ai-chat-upload-hint" id="ai-chat-upload-hint">
        <i class="fa-solid fa-image"></i>
        <span>{{ "aiChat.uploadHint"|trans }}</span>
    </div>
    <div class="ai-chat-input-area">
        <input type="file" id="ai-chat-file-input" accept="image/*" multiple style="display:none;" />
        <button class="ai-chat-attach" id="ai-chat-attach" type="button" title="{{ "aiChat.uploadHint"|trans }}">
            <i class="fa-solid fa-paperclip"></i>
        </button>
        <textarea class="ai-chat-input" id="ai-chat-input" placeholder="{{ "aiChat.1"|trans }}" rows="2"></textarea>
        <button class="ai-chat-send" id="ai-chat-send" type="button" disabled>
            <i class="fa-solid fa-paper-plane"></i>
        </button>
    </div>
</div>

<style>
    .ai-chat-rollback {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        margin-left: 6px;
        padding: 0;
        font-size: 11px;
        color: #94a3b8;
        background: transparent;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        vertical-align: middle;
        transition: all .15s;
    }
    .ai-chat-rollback:hover { color: #6366f1; background: #eef2ff; }
    .ai-chat-rollback:disabled { opacity: .5; cursor: not-allowed; }

    .ai-loading-row { display: flex; align-items: center; gap: 8px; }
    .ai-loading-spinner {
        width: 14px; height: 14px; border-radius: 50%;
        border: 2px solid #c7d2fe; border-top-color: #6366f1;
        animation: ai-spin .8s linear infinite; flex-shrink: 0;
    }
    @keyframes ai-spin { to { transform: rotate(360deg); } }
    .ai-loading-status { font-size: 13px; color: #64748b; }
    .ai-loading-timer { font-size: 12px; color: #94a3b8; font-variant-numeric: tabular-nums; }
    .ai-loading-progress { margin-top: 8px; height: 4px; border-radius: 4px; background: #eef2ff; overflow: hidden; }
    .ai-loading-progress-bar {
        height: 100%; width: 30%; border-radius: 4px;
        background: linear-gradient(90deg, #c7d2fe, #6366f1, #c7d2fe);
        background-size: 200% 100%;
        animation: ai-shimmer 1.2s linear infinite;
    }
    @keyframes ai-shimmer { 0% { background-position: 0 0; } 100% { background-position: 200% 0; } }

    .ai-clarify { margin-top: 4px; }
    .ai-clarify-question { font-size: 13px; color: #334155; font-weight: 600; margin-bottom: 8px; }
    .ai-clarify-options { display: flex; flex-direction: column; gap: 6px; margin-bottom: 8px; }
    .ai-clarify-option {
        text-align: left;
        padding: 8px 12px;
        font-size: 12px;
        color: #475569;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        cursor: pointer;
        transition: all .15s;
    }
    .ai-clarify-option:hover { border-color: #c7d2fe; background: #eef2ff; color: #4f46e5; }
    .ai-clarify-free { display: flex; gap: 6px; }
    .ai-clarify-input {
        flex: 1;
        padding: 7px 10px;
        font-size: 12px;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        outline: none;
        transition: border-color .15s;
    }
    .ai-clarify-input:focus { border-color: #6366f1; }
    .ai-clarify-submit {
        padding: 7px 14px;
        font-size: 12px;
        color: #fff;
        background: #6366f1;
        border: none;
        border-radius: 8px;
        cursor: pointer;
    }
    .ai-clarify-submit:hover { background: #4f46e5; }
    .ai-clarify-chosen {
        margin-top: 8px;
        font-size: 12px;
        color: #16a34a;
        font-weight: 600;
    }
    .ai-chat-viewresult {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin-top: 8px;
        margin-left: 6px;
        padding: 4px 12px;
        font-size: 12px;
        color: #fff;
        background: #6366f1;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        transition: background .15s;
        vertical-align: middle;
    }
    .ai-chat-viewresult:hover { background: #4f46e5; }
    .ai-chat-meta {
        margin-top: 6px;
        font-size: 11px;
        color: #94a3b8;
    }

    /* 选中 DOM 作为聊天附件 / selected DOM as a chat attachment */
    .ai-chat-attachment {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0 12px 8px;
        padding: 6px 8px 6px 10px;
        background: #eef2ff;
        border: 1px solid #c7d2fe;
        border-radius: 10px;
        font-size: 12px;
        color: #3730a3;
    }
    .ai-chat-attachment-body {
        display: flex;
        align-items: center;
        gap: 6px;
        flex: 1 1 auto;
        min-width: 0;
    }
    .ai-chat-attachment-body i { color: #6366f1; flex-shrink: 0; }
    .ai-chat-attachment-name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 11px;
    }
    .ai-chat-attachment-remove {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 18px;
        height: 18px;
        padding: 0;
        border: none;
        border-radius: 50%;
        background: transparent;
        color: #6366f1;
        cursor: pointer;
        flex-shrink: 0;
        transition: background .15s;
    }
    .ai-chat-attachment-remove:hover { background: #dbe3fe; }

    /* 连线按钮 / connect-line button */
    .ai-chat-attachment-line {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 18px;
        height: 18px;
        padding: 0;
        border: none;
        border-radius: 50%;
        background: transparent;
        color: #6366f1;
        cursor: pointer;
        flex-shrink: 0;
        transition: background .15s, color .15s;
    }
    .ai-chat-attachment-line:hover { background: #dbe3fe; }
    .ai-chat-attachment-line.active { background: #6366f1; color: #fff; }

    /* LeaderLine 连线置于聊天面板之上 / keep LeaderLine above the chat panel */
    .leader-line { z-index: 10002 !important; }

    /* 用户消息内的元素目标 chip / element-target chip inside a user message */
    .ai-chat-msg-target {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 6px;
        padding: 3px 8px;
        background: rgba(255, 255, 255, 0.92);
        border-radius: 8px;
        font-size: 11px;
        color: #3730a3;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    }
    .ai-chat-msg-target i { color: #6366f1; }

    /* 拖拽上传的图片缩略图区 / attached image thumbnails */
    .ai-chat-images {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding: 0 12px 8px;
    }
    .ai-chat-image {
        position: relative;
        width: 72px;
        height: 72px;
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        box-shadow: 0 2px 8px rgba(15,23,42,.08);
    }
    .ai-chat-image img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .ai-chat-image-remove {
        position: absolute;
        top: 3px;
        right: 3px;
        width: 18px;
        height: 18px;
        border: none;
        border-radius: 50%;
        background: rgba(15,23,42,.55);
        color: #fff;
        cursor: pointer;
        font-size: 11px;
        line-height: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .ai-chat-image-remove:hover { background: rgba(15,23,42,.8); }
</style>

<button class="toggle-ai-chat" id="toggle-ai-chat" type="button" title="{{ "aiChat.2"|trans }}">    <i class="fa-solid fa-robot"></i>
</button>

<script src="{{ asset('lib/marked/marked.min.js') }}"></script>
<script>
(function() {
    var panel = document.getElementById('ai-chat-panel');
    var toggleBtn = document.getElementById('toggle-ai-chat');
    var closeBtn = document.getElementById('ai-chat-close');
    var messagesEl = document.getElementById('ai-chat-messages');
    var inputEl = document.getElementById('ai-chat-input');
    var sendBtn = document.getElementById('ai-chat-send');

    // ── 图片拖拽/粘贴上传 ──────────────────────────────────────────────
    var uploadedImages = [];   // [{id, name}]
    var imagesEl = document.getElementById('ai-chat-images');

    function renderUploadedImages() {
        if (!imagesEl) return;
        imagesEl.innerHTML = '';
        if (!uploadedImages.length) { imagesEl.style.display = 'none'; return; }
        imagesEl.style.display = 'flex';
        uploadedImages.forEach(function (img, idx) {
            var wrap = document.createElement('div');
            wrap.className = 'ai-chat-image';
            var image = document.createElement('img');
            image.src = img.url;
            wrap.appendChild(image);
            var rm = document.createElement('button');
            rm.className = 'ai-chat-image-remove';
            rm.type = 'button';
            rm.innerHTML = '&times;';
            rm.title = t('aiChat.imageRemove');
            rm.addEventListener('click', function () {
                uploadedImages.splice(idx, 1);
                renderUploadedImages();
            });
            wrap.appendChild(rm);
            imagesEl.appendChild(wrap);
        });
    }

    function uploadImages(files) {
        var imageFiles = Array.prototype.filter.call(files || [], function (f) {
            return f && f.type && String(f.type).indexOf('image/') === 0;
        });
        imageFiles.forEach(function (file) {
            var fd = new FormData();
            fd.append('file', file);
            fd.append('name', file.name || 'image.png');
            fetch('/api/admin/ai/chat/upload', { method: 'POST', body: fd })
                .then(function (r) { return r.json(); })
                .then(function (json) {
                    if (json.code === 200 && json.data && json.data.imageId) {
                        uploadedImages.push({ id: json.data.imageId, name: json.data.name || file.name, url: URL.createObjectURL(file) });
                        renderUploadedImages();
                    } else {
                        console.warn('image upload failed', json);
                    }
                })
                .catch(function (e) { console.warn('image upload error', e); });
        });
    }

    // 拖拽上传
    var panelEl = document.getElementById('ai-chat-panel');
    var inputAreaEl = document.querySelector('.ai-chat-input-area');
    function setDragover(on) {
        if (panelEl) panelEl.classList.toggle('ai-chat-dragover', on);
        if (inputAreaEl) inputAreaEl.classList.toggle('ai-chat-dragover', on);
    }
    ['dragenter', 'dragover'].forEach(function (ev) {
        (panelEl || document).addEventListener(ev, function (e) { e.preventDefault(); e.stopPropagation(); setDragover(true); });
    });
    ['dragleave', 'dragend'].forEach(function (ev) {
        (panelEl || document).addEventListener(ev, function (e) { e.preventDefault(); e.stopPropagation(); setDragover(false); });
    });
    (panelEl || document).addEventListener('drop', function (e) {
        e.preventDefault(); e.stopPropagation(); setDragover(false);
        if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length) {
            uploadImages(e.dataTransfer.files);
        }
    });

    // 附件按钮 → 打开文件选择器（让用户知道可点可拖）
    var attachBtn = document.getElementById('ai-chat-attach');
    var fileInput = document.getElementById('ai-chat-file-input');
    if (attachBtn && fileInput) {
        attachBtn.addEventListener('click', function () { fileInput.click(); });
        fileInput.addEventListener('change', function () {
            if (fileInput.files && fileInput.files.length) {
                uploadImages(fileInput.files);
                fileInput.value = '';
            }
        });
    }

    // 粘贴上传（剪贴板里的图片）
    inputEl.addEventListener('paste', function (e) {
        var items = (e.clipboardData || window.clipboardData) && e.clipboardData.items;
        if (!items) return;
        var found = false;
        for (var i = 0; i < items.length; i++) {
            if (items[i].kind === 'file' && items[i].type && String(items[i].type).indexOf('image/') === 0) {
                var file = items[i].getAsFile();
                if (file) { found = true; uploadImages([file]); }
            }
        }
        if (found) e.preventDefault();
    });

    function clearUploadedImages() {
        uploadedImages = [];
        if (imagesEl) { imagesEl.innerHTML = ''; imagesEl.style.display = 'none'; }
    }

    var isSending = false;
    var currentSessionId = null;

    function getContext() {
        return window.__AI_CONTEXT__ || null;
    }

    function getContextId() {
        var ctx = getContext();
        if (!ctx) return null;
        // 视图编辑器：传完整 URL（含 version 参数），供后端区分当前编辑的版本
        if (ctx.name === 'view_editor') {
            return window.location.href;
        }
        return ctx.pageId || window.location.pathname;
    }

    function getSessionContextId() {
        var ctx = getContext();
        if (ctx && ctx.name === 'view_editor') {
            return window.location.href;
        }
        return window.location.pathname;
    }

    function getSessionStorageKey() {
        var ctx = getContext();
        if (!ctx) return null;
        return 'ai_chat_session:' + ctx.name + ':' + getSessionContextId();
    }

    function saveSessionId(sessionId) {
        var key = getSessionStorageKey();
        if (!key) return;
        try {
            localStorage.setItem(key, sessionId);
        } catch(e) {}
    }

    function loadSessionId() {
        var key = getSessionStorageKey();
        if (!key) return null;
        try {
            return localStorage.getItem(key);
        } catch(e) {
            return null;
        }
    }

    function togglePanel() {
        if (panel.style.display === 'none') {
            panel.style.display = 'flex';
            toggleBtn.style.display = 'none';
            localStorage.setItem('ai_chat_panel_open', '1');
            subscribeChatProgress();
            inputEl.focus();
            loadHistoryFromBackend();
        }
    }

    function closePanel() {
        panel.style.display = 'none';
        toggleBtn.style.display = 'flex';
        localStorage.setItem('ai_chat_panel_open', '0');
    }

    function renderMarkdown(text) {
        if (typeof marked !== 'undefined') {
            if (!window._twRenderer) {
                marked.use({
                    renderer: {
                        table(header, body) {
                            return '<table class="w-full border-collapse text-sm mb-2">' + header + body + '</table>';
                        },
                        tablerow(content) {
                            return '<tr>' + content + '</tr>';
                        },
                        tablecell(content, flags) {
                            var tag = flags.header ? 'th' : 'td';
                            var cls = flags.header ? 'text-left px-2 py-1.5 bg-gray-50 font-semibold text-gray-700 border border-gray-200' : 'px-2 py-1.5 border border-gray-200';
                            return '<' + tag + ' class="' + cls + '">' + content + '</' + tag + '>';
                        },
                        heading(text, level) {
                            var sizes = ['', 'text-lg font-bold mt-4 mb-2 text-gray-900', 'text-base font-semibold mt-3 mb-1.5 text-gray-800', 'text-sm font-semibold mt-2 mb-1 text-gray-700', 'text-xs font-semibold mt-2 mb-1 text-gray-600'];
                            return '<h' + level + ' class="' + (sizes[level] || '') + '">' + text + '</h' + level + '>';
                        },
                        paragraph(text) {
                            return '<p class="mb-2 leading-relaxed text-sm">' + text + '</p>';
                        },
                        list(body, ordered) {
                            var tag = ordered ? 'ol' : 'ul';
                            var cls = ordered ? 'list-decimal pl-5 mb-2 space-y-0.5' : 'list-disc pl-5 mb-2 space-y-0.5';
                            return '<' + tag + ' class="' + cls + '">' + body + '</' + tag + '>';
                        },
                        listitem(text) {
                            return '<li class="text-sm leading-relaxed">' + text + '</li>';
                        },
                        codespan(text) {
                            return '<code class="bg-gray-100 text-rose-600 px-1 rounded text-xs font-mono">' + text + '</code>';
                        },
                        code(text) {
                            return '<pre class="bg-gray-900 text-gray-100 rounded-lg p-3 mb-2 text-xs overflow-x-auto"><code>' + text + '</code></pre>';
                        },
                        blockquote(text) {
                            return '<blockquote class="border-l-4 border-gray-300 pl-3 italic text-gray-500 mb-2 text-sm">' + text + '</blockquote>';
                        },
                        hr() {
                            return '<hr class="my-3 border-t border-gray-200">';
                        },
                        link(href, title, text) {
                            return '<a class="text-blue-600 underline" href="' + href + '"' + (title ? ' title="' + title + '"' : '') + '>' + text + '</a>';
                        },
                        strong(text) {
                            return '<strong class="font-semibold">' + text + '</strong>';
                        },
                        em(text) {
                            return '<em class="italic">' + text + '</em>';
                        },
                    }
                });
                window._twRenderer = true;
            }
            return marked.parse(text);
        }
        return text;
    }

    function addMessage(role, content, messageId, elementLabel) {
        var div = document.createElement('div');
        div.className = 'ai-message ' + (role === 'user' ? 'ai-user' : 'ai-assistant');
        if (messageId) div.setAttribute('data-message-id', messageId);
        var contentDiv = document.createElement('div');
        contentDiv.className = 'ai-message-content' + (role === 'user' ? ' bg-blue-500 text-white' : ' rounded-lg');
        if (role === 'assistant') {
            contentDiv.innerHTML = renderMarkdown(content);
        } else {
            if (elementLabel) {
                var chip = document.createElement('div');
                chip.className = 'ai-chat-msg-target';
                chip.innerHTML = '<i class="fa-solid fa-cube"></i> <span></span>';
                chip.querySelector('span').textContent = elementLabel;
                contentDiv.appendChild(chip);
                var textDiv = document.createElement('div');
                textDiv.textContent = content;
                contentDiv.appendChild(textDiv);
            } else {
                contentDiv.textContent = content;
            }
        }
        div.appendChild(contentDiv);
        messagesEl.appendChild(div);
        messagesEl.scrollTop = messagesEl.scrollHeight;
        return div;
    }

    // 解析消息开头内嵌的元素上下文块（兼容新格式与旧的中/英文格式）/
    // parse the element-context block embedded at the start of a message (new format + legacy zh/en)
    function parseElementContext(content) {
        if (typeof content !== 'string') return null;
        var m = content.match(/^\[Element\]:\s*([^\n]*)\n\[Selector\]:\s*([^\n]*)\n\[Style\]:\s*([^\n]*)\n*[\s]*\n*/)
            || content.match(/^\[当前选中元素:([^\n]*)\]\n\[内联样式:([^\n]*)\]\s*\n*/)
            || content.match(/^\[Currently selected element:([^\n]*)\]\n\[Inline style:([^\n]*)\]\s*\n*/);
        if (!m) return null;
        var label = m[1].trim();
        // 旧格式只有 <tag> 摘要，无法还原文本；按 tag 推导可读类型名（如 <div> → "区域"）/
        // legacy format only has a <tag> summary; derive a readable type name (e.g. <div> → "区域")
        if (/^<[a-zA-Z][a-zA-Z0-9]*/.test(label)) {
            label = describeFromSummary(label);
        }
        return { label: label, style: m[2].trim(), text: content.substring(m[0].length) };
    }

    // 从旧格式摘要 <tag...> 推导类型名 / derive a type name from a legacy <tag...> summary
    function describeFromSummary(summary) {
        var m = String(summary).match(/^<([a-zA-Z0-9]+)/);
        var tag = m ? m[1].toLowerCase() : '';
        if (tag === 'button') return t('aiChat.attach.type.button');
        if (tag === 'input') return t('aiChat.attach.type.input');
        if (tag === 'select') return t('aiChat.attach.type.select');
        if (tag === 'textarea') return t('aiChat.attach.type.textarea');
        if (tag === 'a') return t('aiChat.attach.type.link');
        if (tag === 'img') return t('aiChat.attach.type.image');
        if (/^h[1-6]$/.test(tag)) return t('aiChat.attach.type.heading');
        if (tag === 'table') return t('aiChat.attach.type.table');
        if (tag === 'form') return t('aiChat.attach.type.form');
        if (tag === 'label') return t('aiChat.attach.type.label');
        if (tag === 'section') return t('aiChat.attach.type.section');
        return t('aiChat.attach.type.element');
    }

    // 视图编辑器消息级回退：在消息内容尾部挂一个小图标按钮，hover 提示"回退到此"
    function attachCheckpointButton(msgEl, checkpointId) {
        if (!msgEl || !checkpointId) return;
        var contentEl = msgEl.querySelector('.ai-message-content');
        if (!contentEl) return;
        if (contentEl.querySelector('.ai-chat-rollback')) return;
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'ai-chat-rollback';
        btn.title = t('aiChat.js1');
        btn.innerHTML = '<i class="fa-solid fa-rotate-left"></i>';
        btn.addEventListener('click', function () {
            if (!confirm(t('aiChat.js2'))) return;
            btn.disabled = true;
            var viewId = window.__VIEW_ID__;
            var version = window.__ACTIVE_VERSION__;
            if (!viewId || !version) { btn.disabled = false; return; }
            fetch('/api/admin/platform/view/' + viewId + '/versions/' + version + '/checkpoint/' + checkpointId + '/restore', { method: 'POST' })
                .then(function (r) { return r.json(); })
                .then(function (json) {
                    if (json.code === 200) {
                        window.location.reload();
                    } else {
                        alert(t('aiChat.js3') + (json.message || ''));
                        btn.disabled = false;
                    }
                })
                .catch(function () { btn.disabled = false; });
        });
        contentEl.appendChild(btn);
    }

    function createCheckpointForMessage(messageId, msgEl) {
        var ctx = getContext();
        if (!ctx || ctx.name !== 'view_editor' || !messageId) return;
        var viewId = window.__VIEW_ID__;
        var version = window.__ACTIVE_VERSION__;
        if (!viewId || !version) return;
        fetch('/api/admin/platform/view/' + viewId + '/versions/' + version + '/checkpoint', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message_id: messageId })
        })
        .then(function (r) { return r.json(); })
        .then(function (json) {
            if (json.code === 200 && json.data && json.data.checkpoint && json.data.checkpoint.created) {
                attachCheckpointButton(msgEl, json.data.checkpoint.id);
            }
        });
    }

    function fetchCheckpointsAndAttach() {
        var ctx = getContext();
        if (!ctx || ctx.name !== 'view_editor') return;
        var viewId = window.__VIEW_ID__;
        var version = window.__ACTIVE_VERSION__;
        if (!viewId || !version) return;
        fetch('/api/admin/platform/view/' + viewId + '/versions/' + version + '/checkpoints')
            .then(function (r) { return r.json(); })
            .then(function (json) {
                if (json.code !== 200 || !json.data) return;
                (json.data.checkpoints || []).forEach(function (cp) {
                    if (!cp.messageId) return;
                    var msg = messagesEl.querySelector('.ai-message[data-message-id="' + cp.messageId + '"]');
                    if (msg) attachCheckpointButton(msg, cp.id);
                });
            });
    }

    // 旧消息无 meta 时，用内容启发式识别"澄清征询"（问句 + 若干短选项列表），尽力重建卡片样式
    function looksLikeClarification(content) {
        if (!content) return null;
        var text = String(content).trim();
        if (text.length > 400) return null;
        if (/^#|^\*\*|<h[1-6]|<strong|```/.test(text)) return null;
        var lines = text.split('\n').map(function (l) { return l.trim(); }).filter(Boolean);
        if (lines.length < 3) return null;
        var question = lines[0];
        var options = [];
        for (var i = 1; i < lines.length; i++) {
            var m = lines[i].match(/^[-•*]\s+(.+)$/);
            if (!m || m[1].length > 120) return null;
            options.push(m[1]);
        }
        if (options.length < 2) return null;
        return { question: question, options: options };
    }

    // 历史消息重载：根据持久化的 meta 重建澄清卡片/执行效率/重构结果等特殊 UI，
    // 避免刷新后退化为普通对话样式、丢失选中标记与统计数据。
    function renderHistoryMessage(msg, idx, allMsgs) {
        var meta = msg.meta || null;
        var clarify = null;
        if (msg.role === 'assistant') {
            clarify = meta && meta.type === 'clarification'
                ? { question: meta.question, options: meta.options || [] }
                : (meta ? null : looksLikeClarification(msg.content));
        }
        if (clarify) {
            var div = document.createElement('div');
            div.className = 'ai-message ai-assistant';
            if (msg.id) div.setAttribute('data-message-id', msg.id);
            var contentDiv = document.createElement('div');
            contentDiv.className = 'ai-message-content rounded-lg';
            var html = '<div class="ai-clarify">';
            html += '<div class="ai-clarify-question">' + renderMarkdown(clarify.question || t('aiChat.js4')) + '</div>';
            if (clarify.options && clarify.options.length) {
                html += '<div class="ai-clarify-options">';
                for (var i = 0; i < clarify.options.length; i++) {
                    html += '<div class="ai-clarify-option" style="cursor:default">' + escHtml(clarify.options[i]) + '</div>';
                }
                html += '</div>';
            }
            // 用户当时的选择 = 紧跟该澄清消息之后的用户消息（静默发送的选择已入库）
            var nextMsg = allMsgs[idx + 1];
            if (nextMsg && nextMsg.role === 'user' && nextMsg.content) {
                html += '<div class="ai-clarify-chosen">' + t('aiChat.selected') + escHtml(nextMsg.content) + '</div>';
            }
            html += '</div>';
            contentDiv.innerHTML = html;
            div.appendChild(contentDiv);
            messagesEl.appendChild(div);
            messagesEl.scrollTop = messagesEl.scrollHeight;
            return;
        }

        var el;
        if (msg.role === 'user') {
            var parsed = parseElementContext(msg.content);
            el = parsed ? addMessage('user', parsed.text, msg.id, parsed.label) : addMessage('user', msg.content, msg.id);
            return;
        }
        el = addMessage(msg.role, msg.content, msg.id);
        if (msg.role === 'assistant' && el && meta) {
            var contentEl = el.querySelector('.ai-message-content');
            if (!contentEl) return;
            if (meta.elapsedMs) {
                var metaEl = document.createElement('div');
                metaEl.className = 'ai-chat-meta';
                var secs = Math.round(meta.elapsedMs / 1000);
                metaEl.textContent = t('aiChat.elapsed') + secs + t('aiChat.js5') + (meta.toolCount || 0) + t('aiChat.js6');
                contentEl.appendChild(metaEl);
            }
            if (meta.redesignApplied) {
                var viewBtn = document.createElement('button');
                viewBtn.type = 'button';
                viewBtn.className = 'ai-chat-viewresult';
                viewBtn.innerHTML = t('aiChat.js7');
                viewBtn.addEventListener('click', function () { window.location.reload(); });
                contentEl.appendChild(viewBtn);
            }
        }
    }

    // AI 征询用户：渲染澄清问题 + 选项按钮 + 自由输入，用户选择后作为新消息继续
    function renderClarification(question, options, messageId) {
        var div = document.createElement('div');
        div.className = 'ai-message ai-assistant';
        if (messageId) div.setAttribute('data-message-id', messageId);
        var contentDiv = document.createElement('div');
        contentDiv.className = 'ai-message-content rounded-lg';
        var html = '<div class="ai-clarify">';
        html += '<div class="ai-clarify-question">' + renderMarkdown(question || t('aiChat.js4')) + '</div>';
        if (options && options.length) {
            html += '<div class="ai-clarify-options">';
            for (var i = 0; i < options.length; i++) {
                html += '<button type="button" class="ai-clarify-option" data-choice="' + escAttr(options[i]) + '">' + escHtml(options[i]) + '</button>';
            }
            html += '</div>';
        }
        html += '<div class="ai-clarify-free">';
        html += '<input class="ai-clarify-input" type="text" placeholder="' + escAttr(t('aiChat.js8')) + '">';
        html += '<button class="ai-clarify-submit" type="button">' + escHtml(t('aiChat.freeSubmit')) + '</button>';
        html += '</div></div>';
        contentDiv.innerHTML = html;
        div.appendChild(contentDiv);
        messagesEl.appendChild(div);
        messagesEl.scrollTop = messagesEl.scrollHeight;

        var submitChoice = function (choice) {
            if (!choice) return;
            var trimmed = choice.trim();
            if (!trimmed) return;
            // 在澄清卡片上标注已选择（不新增用户气泡）
            var mark = div.querySelector('.ai-clarify-chosen');
            if (mark) mark.remove();
            mark = document.createElement('div');
            mark.className = 'ai-clarify-chosen';
            mark.textContent = t('aiChat.selected') + trimmed;
            div.querySelector('.ai-clarify').appendChild(mark);
            // 静默发送选择（不渲染为用户消息，避免重复与混淆）
            inputEl.value = trimmed;
            inputEl.disabled = false;
            sendBtn.disabled = false;
            sendMessage({ silent: true });
        };
        div.querySelectorAll('.ai-clarify-option').forEach(function (btn) {
            btn.addEventListener('click', function () { submitChoice(btn.getAttribute('data-choice')); });
        });
        var input = div.querySelector('.ai-clarify-input');
        var submitBtn = div.querySelector('.ai-clarify-submit');
        if (input && submitBtn) {
            submitBtn.addEventListener('click', function () { submitChoice(input.value); });
            input.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') { e.preventDefault(); submitChoice(input.value); }
            });
        }
    }

    function escHtml(s) {
        return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
    function escAttr(s) {
        return escHtml(s).replace(/'/g, '&#39;');
    }

    function addLoading() {
        var div = document.createElement('div');
        div.className = 'ai-message ai-assistant ai-loading';
        var contentDiv = document.createElement('div');
        contentDiv.className = 'ai-message-content rounded-lg';
        contentDiv.innerHTML =
            '<div class="ai-loading-row">' +
                '<span class="ai-loading-spinner"></span>' +
                t('aiChat.js10') +
                '<span class="ai-loading-timer" id="ai-loading-timer">0s</span>' +
            '</div>' +
            '<div class="ai-loading-progress"><div class="ai-loading-progress-bar"></div></div>';
        div.appendChild(contentDiv);
        messagesEl.appendChild(div);
        messagesEl.scrollTop = messagesEl.scrollHeight;
        startLoadingTimer();
        return div;
    }

    var loadingTimer = null;
    var loadingSeconds = 0;

    function startLoadingTimer() {
        stopLoadingTimer();
        loadingSeconds = 0;
        var t = document.getElementById('ai-loading-timer');
        if (t) t.textContent = '0s';
        loadingTimer = setInterval(function () {
            loadingSeconds++;
            var el = document.getElementById('ai-loading-timer');
            if (el) el.textContent = loadingSeconds + 's';
        }, 1000);
    }

    function stopLoadingTimer() {
        if (loadingTimer) { clearInterval(loadingTimer); loadingTimer = null; }
    }

    function removeLoading(el) {
        stopLoadingTimer();
        if (el && el.parentNode) {
            el.parentNode.removeChild(el);
        }
    }

    // 进度订阅：Mercure 实时接收 AI 执行过程中的工具调用进度
    var chatProgressSubscribed = false;

    function getChatProgressTopic() {
        return 'https://enterprise.local/ai/chat/' + encodeURIComponent(getContextId());
    }

    function subscribeChatProgress() {
        if (chatProgressSubscribed) return;
        if (!window.EF || !window.EF.Mercure || !window.EF.Mercure.subscribe) return;
        chatProgressSubscribed = true;
        window.EF.Mercure.on('ai_chat_progress', handleChatProgress);
        try {
            window.EF.Mercure.subscribe(getChatProgressTopic());
        } catch (e) {}
    }

    function handleChatProgress(data) {
        if (!data) return;
        var statusEl = document.getElementById('ai-loading-status');
        if (!statusEl) return;
        if (data.status === 'tool') {
            statusEl.textContent = t('aiChat.js11') + (data.tool || t('aiChat.js12')) + '…';
        } else if (data.status === 'tool_error') {
            statusEl.textContent = t('aiChat.js13');
        } else if (data.status === 'started') {
            statusEl.textContent = t('aiChat.js14');
        } else if (data.status === 'done') {
            statusEl.textContent = t('aiChat.js15');
        }
    }

    function loadHistoryFromBackend() {
        var ctx = getContext();
        if (!ctx) return;

        var contextId = getSessionContextId();
        var sessionId = loadSessionId();

        var body = {
            context: ctx.name,
            context_id: contextId,
        };
        if (sessionId) {
            body.session_id = sessionId;
        }

        fetch('/api/admin/ai/chat/history', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
        })
        .then(function(res) { return res.json(); })
        .then(function(json) {
            if (json.code === 200 && json.data) {
                if (json.data.session_id) {
                    currentSessionId = json.data.session_id;
                    saveSessionId(currentSessionId);
                }
                if (json.data.messages && json.data.messages.length > 0) {
                    // Clear welcome message
                    var welcome = messagesEl.querySelector('.ai-message');
                    if (welcome) welcome.remove();
                    // Render history
                    for (var i = 0; i < json.data.messages.length; i++) {
                        var msg = json.data.messages[i];
                        renderHistoryMessage(msg, i, json.data.messages);
                    }
                    // 给有检查点的历史消息挂「回退到此」
                    fetchCheckpointsAndAttach();
                }
            }
        })
        .catch(function(err) {
            console.warn('Failed to load history:', err);
        });
    }

    function getSelectedElementContext() {
        var ctx = getContext();
        if (ctx && ctx._selectedElement) {
            var sel = ctx._selectedElement;
            // 优先用选中时缓存的人类可读描述；否则用 describeElement；再退回 summary /
            // prefer the described label cached at selection time; else describeElement; else raw summary
            var label = sel.describedLabel
                || ((window.CssProperties && window.CssProperties.getSelectedElement())
                    ? describeElement(window.CssProperties.getSelectedElement())
                    : (sel.summary || sel.tag || 'element'));
            return '[Element]: ' + label + '\n[Selector]: ' + (sel.summary || '') + '\n[Style]: ' + (sel.style || t('aiChat.js16')) + '\n\n';
        }
        return '';
    }

    // 选中 DOM 作为聊天附件：随画布选中态显示/隐藏，可移除后不针对该元素聊天 /
    // selected DOM as a chat attachment: shown/hidden with canvas selection; removable to chat without targeting it
    var activeAttachmentElement = null;
    var activeLine = null;
    var attachmentLineBtn = document.getElementById('ai-chat-attachment-line');

    // 生成人类可读的元素描述（文本/属性 + 类型），如 "「编辑模式」区域" /
    // produce a human-readable element description (text/attr + type), e.g. "「编辑模式」区域"
    function elementTypeName(tag, el) {
        if (tag === 'button' || (el.classList && el.classList.contains('btn'))) return t('aiChat.attach.type.button');
        if (tag === 'input') return t('aiChat.attach.type.input');
        if (tag === 'select') return t('aiChat.attach.type.select');
        if (tag === 'textarea') return t('aiChat.attach.type.textarea');
        if (tag === 'a') return t('aiChat.attach.type.link');
        if (tag === 'img') return t('aiChat.attach.type.image');
        if (/^h[1-6]$/.test(tag)) return t('aiChat.attach.type.heading');
        if (tag === 'table') return t('aiChat.attach.type.table');
        if (tag === 'form') return t('aiChat.attach.type.form');
        if (tag === 'label') return t('aiChat.attach.type.label');
        if (tag === 'section' || (el.classList && el.classList.contains('section'))) return t('aiChat.attach.type.section');
        return t('aiChat.attach.type.element');
    }

    function describeElement(el) {
        if (!el || !el.tagName) return t('aiChat.attach.element');
        var tag = el.tagName.toLowerCase();
        // 取直接文本节点，忽略子元素文本（避免拼接整块内容）
        var direct = '';
        for (var i = 0; i < el.childNodes.length; i++) {
            if (el.childNodes[i].nodeType === 3) direct += el.childNodes[i].textContent;
        }
        direct = direct.replace(/\s+/g, ' ').trim();
        // 清理图标/符号前缀（如 ● ◆ → 等）
        direct = direct.replace(/^[\u2190-\u21ff\u25a0-\u25ff\u2600-\u27bf\u2b00-\u2bff\uf000-\uf8ff\u2022\u00b7]+/, '').trim();
        var text = direct;
        if (!text && el.getAttribute) {
            text = String(el.getAttribute('title') || el.getAttribute('aria-label') || el.getAttribute('placeholder') || el.getAttribute('alt') || '').trim();
        }
        text = text.substring(0, 40);
        var type = elementTypeName(tag, el);
        return text ? t('aiChat.attach.format', {text: text, type: type}) : type;
    }

    function syncLine() {
        if (activeLine) { try { activeLine.position(); } catch (e) {} }
    }

    function updateLineBtnState(active) {
        if (!attachmentLineBtn) return;
        attachmentLineBtn.classList.toggle('active', active);
        attachmentLineBtn.title = active ? t('aiChat.attach.unline') : t('aiChat.attach.line');
    }

    function destroyLine() {
        if (activeLine) {
            try { activeLine.remove(); } catch (e) {}
            activeLine = null;
        }
        updateLineBtnState(false);
    }

    function renderAttachment(e) {
        var ctx = getContext();
        var sel = ctx && ctx._selectedElement;
        var el = document.getElementById('ai-chat-attachment');
        if (!el) return;
        var targetEl = (e && e.detail && e.detail.element) || (window.CssProperties && window.CssProperties.getSelectedElement()) || null;
        if (targetEl !== activeAttachmentElement) {
            destroyLine();
            activeAttachmentElement = targetEl;
        }
        if (sel) {
            var nameEl = document.getElementById('ai-chat-attachment-name');
            if (nameEl) nameEl.textContent = describeElement(targetEl || sel);
            // 缓存描述标签，保证发送/历史记录里用一致的可读文案 /
            // cache the described label so sent messages & history use the same readable text
            if (targetEl) sel.describedLabel = describeElement(targetEl);
            el.style.display = 'flex';
        } else {
            el.style.display = 'none';
            destroyLine();
            activeAttachmentElement = null;
        }
    }

    var attachmentRemoveBtn = document.getElementById('ai-chat-attachment-remove');
    if (attachmentRemoveBtn) {
        attachmentRemoveBtn.addEventListener('click', function() {
            // 同时清除画布选中（触发 cssElementDeselected → 同步清空 _selectedElement 与附件）
            if (window.CssProperties && window.CssProperties.clearSelection) {
                window.CssProperties.clearSelection();
            } else {
                var ctx = getContext();
                if (ctx && ctx._selectedElement) delete ctx._selectedElement;
                renderAttachment();
            }
        });
    }
    if (attachmentLineBtn) {
        attachmentLineBtn.addEventListener('click', function() {
            if (activeLine) { destroyLine(); return; }
            var target = (window.CssProperties && window.CssProperties.getSelectedElement());
            var startEl = document.getElementById('ai-chat-attachment');
            if (!target || !startEl || typeof LeaderLine === 'undefined') return;
            try {
                activeLine = new LeaderLine(startEl, target, {
                    color: '#6366f1',
                    size: 2,
                    startPlug: 'disc',
                    endPlug: 'arrow1',
                    startSocket: 'auto',
                    endSocket: 'auto',
                    outline: true,
                    outlineColor: '#ffffff',
                    outlineSize: 0.2
                });
                updateLineBtnState(true);
            } catch (err) {}
        });
    }
    document.addEventListener('cssElementSelected', renderAttachment);
    document.addEventListener('cssElementDeselected', renderAttachment);
    var canvasEl = document.getElementById('canvas');
    if (canvasEl) canvasEl.addEventListener('scroll', syncLine);
    window.addEventListener('resize', syncLine);

    // sendMessage(opts) 支持 opts.silent=true：不把消息渲染为用户气泡（用于澄清选项等系统交互）
    function sendMessage(opts) {
        opts = opts || {};
        var text = inputEl.value.trim();
        if (!text || isSending) return;

        var ctx = getContext();
        if (!ctx) {
            addMessage('user', text);
            inputEl.value = '';
            addMessage('assistant', t('aiChat.js17'));
            return;
        }

        var selContext = getSelectedElementContext();
        // 静默发送（如澄清选项选择）是直接回答，不前置选中元素上下文，避免改变对话内容
        var fullMessage = opts.silent ? text : (selContext + text);

        if (!opts.silent) {
            var liveEl = (window.CssProperties && window.CssProperties.getSelectedElement());
            addMessage('user', text, null, liveEl ? describeElement(liveEl) : null);
        }
        inputEl.value = '';
        clearUploadedImages();
        sendBtn.disabled = true;
        inputEl.disabled = true;
        isSending = true;

        subscribeChatProgress();
        var loadingEl = addLoading();

        var contextId = getSessionContextId();

        fetch('/api/admin/ai/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                context: ctx.name,
                context_id: contextId,
                message: fullMessage,
                session_id: currentSessionId,
                image_ids: uploadedImages.map(function (img) { return img.id; }),
            }),
        })
        .then(function(res) { return res.json(); })
        .then(function(json) {
            removeLoading(loadingEl);
            if (json.code === 200) {
                // 澄清响应：渲染问题与选项，征询用户后再执行
                if (json.data && json.data.type === 'clarification') {
                    renderClarification(json.data.question, json.data.options || [], json.data.assistantMessageId);
                    return;
                }
                var reply = (json.data && json.data.reply) ? json.data.reply : t('aiChat.js18');
                var msgEl = addMessage('assistant', reply, json.data && json.data.assistantMessageId);
                if (json.data && json.data.sessionId) {
                    currentSessionId = json.data.sessionId;
                    saveSessionId(currentSessionId);
                }
                // 显示执行效率：耗时 + 工具调用数
                if (json.data && json.data.elapsedMs && msgEl) {
                    var metaEl = document.createElement('div');
                    metaEl.className = 'ai-chat-meta';
                    var secs = Math.round(json.data.elapsedMs / 1000);
                    metaEl.textContent = t('aiChat.elapsed') + secs + t('aiChat.js5') + (json.data.toolCount || 0) + t('aiChat.js6');
                    var contentEl = msgEl.querySelector('.ai-message-content');
                    if (contentEl) contentEl.appendChild(metaEl);
                }
                // 该回复可能修改了视图：创建检查点，让用户可「回退到此」
                createCheckpointForMessage(json.data && json.data.assistantMessageId, msgEl);
                // 整体重构走"文件重写"：完成后自动刷新编辑器画布以展示新设计（保留按钮作手动兜底）
                if (json.data && json.data.redesignApplied && msgEl) {
                    var viewBtn = document.createElement('button');
                    viewBtn.type = 'button';
                    viewBtn.className = 'ai-chat-viewresult';
                    viewBtn.innerHTML = t('aiChat.js7');
                    viewBtn.addEventListener('click', function () { window.location.reload(); });
                    var contentEl = msgEl.querySelector('.ai-message-content');
                    if (contentEl) contentEl.appendChild(viewBtn);
                    // 延迟自动刷新，让用户先看到 AI 回复，随后画布加载全新设计
                    setTimeout(function () { window.location.reload(); }, 1500);
                }
            } else {
                addMessage('assistant', t('aiChat.js19') + (json.message || t('aiChat.js20')));
            }
        })
        .catch(function(err) {
            removeLoading(loadingEl);
            addMessage('assistant', t('aiChat.js21') + err.message);
        })
        .finally(function() {
            isSending = false;
            sendBtn.disabled = false;
            inputEl.disabled = false;
            inputEl.focus();
        });
    }

    toggleBtn.addEventListener('click', togglePanel);
    closeBtn.addEventListener('click', closePanel);
    // 刷新/重构自动刷新后恢复聊天面板打开状态
    if (localStorage.getItem('ai_chat_panel_open') === '1') {
        panel.style.display = 'flex';
        toggleBtn.style.display = 'none';
        subscribeChatProgress();
        loadHistoryFromBackend();
    }
    sendBtn.addEventListener('click', sendMessage);
    inputEl.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            sendMessage();
        }
    });
    inputEl.addEventListener('input', function() {
        sendBtn.disabled = !this.value.trim() || isSending;
    });

    // Restore saved panel width
    try {
        var savedWidth = localStorage.getItem('ai_chat_panel_width');
        if (savedWidth) {
            panel.style.width = savedWidth;
        }
    } catch(e) {}

    // Resize handle
    var resizeHandle = document.getElementById('ai-chat-resize-handle');
    var isResizing = false;

    resizeHandle.addEventListener('mousedown', function(e) {
        isResizing = true;
        document.body.style.cursor = 'col-resize';
        document.body.style.userSelect = 'none';
        e.preventDefault();
    });

    document.addEventListener('mousemove', function(e) {
        if (!isResizing) return;
        var newWidth = window.innerWidth - e.clientX;
        if (newWidth < 280) newWidth = 280;
        if (newWidth > window.innerWidth * 0.8) newWidth = window.innerWidth * 0.8;
        panel.style.width = newWidth + 'px';
    });

    document.addEventListener('mouseup', function() {
        if (!isResizing) return;
        isResizing = false;
        document.body.style.cursor = '';
        document.body.style.userSelect = '';
        try {
            localStorage.setItem('ai_chat_panel_width', panel.style.width);
        } catch(e) {}
    });
})();
</script>
