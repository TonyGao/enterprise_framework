{% extends 'admin/layout.html.twig' %}

{% block title %}{{ "admin_security.page_title"|trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" type="text/css" href="{{ asset('corporation.css', 'admin') }}">
    <style>
        .security-page {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            color: #1d1d1f;
        }
        .security-title {
            font-size: 28px;
            font-weight: 600;
            margin-bottom: 24px;
        }
        .security-tabs {
            display: flex;
            border-bottom: 1px solid #e5e5ea;
            margin-bottom: 32px;
        }
        .security-tab {
            padding: 12px 0;
            margin-right: 32px;
            font-size: 15px;
            font-weight: 500;
            color: #86868b;
            cursor: pointer;
            text-decoration: none;
        }
        .security-tab.active {
            color: #0066cc;
            border-bottom: 2px solid #0066cc;
        }
        .policy-section {
            background: #fff;
            border: 1px solid #e5e5ea;
            border-radius: 12px;
            padding: 24px;
            margin-bottom: 24px;
        }
        .policy-section-title {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 16px;
            padding-bottom: 12px;
            border-bottom: 1px solid #f5f5f7;
        }
        .form-row {
            display: flex;
            align-items: center;
            margin-bottom: 16px;
        }
        .form-label {
            width: 200px;
            font-weight: 500;
            font-size: 14px;
            color: #1d1d1f;
        }
        .form-control {
            flex: 1;
            max-width: 300px;
        }
        .checkbox-group {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .checkbox-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            color: #1d1d1f;
        }
        .side-card {
            background: #f5f5f7;
            border-radius: 16px;
            padding: 24px;
            margin-bottom: 16px;
        }
        .side-card-title {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 8px;
        }
        .side-card-text {
            font-size: 14px;
            color: #555;
            margin-bottom: 16px;
            line-height: 1.5;
        }
        .side-card-link {
            color: #0066cc;
            font-weight: 500;
            text-decoration: none;
            font-size: 14px;
        }
        .side-card-link:hover {
            text-decoration: underline;
        }
        .ai-chat-box {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 16px;
            margin-bottom: 16px;
        }
        .ai-input-group {
            display: flex;
            gap: 8px;
        }
        .ai-input {
            flex: 1;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            padding: 10px 16px;
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s;
        }
        .ai-input:focus {
            border-color: #3b82f6;
        }
        .rule-tag {
            display: inline-block;
            background: #e0f2fe;
            color: #0369a1;
            padding: 4px 10px;
            border-radius: 16px;
            font-size: 12px;
            font-weight: 500;
            margin-right: 8px;
            margin-bottom: 8px;
        }
    </style>
{% endblock %}

{% block app_content_container %}
<div class="org-structure-container security-page">
    <div class="outside-wrapper" style="padding: 40px; max-width: 1200px; margin: 0; background: #fff; min-height: calc(100vh - 60px);">
        
        <div class="security-title">{{ "admin_security.title"|trans }}</div>
        
        <div class="security-tabs">
            <a href="{{ path('admin_security_index') }}" class="security-tab">{{ "admin_security.tabs.2fa_settings"|trans }}</a>
            <a href="{{ path('admin_security_password_policy') }}" class="security-tab active">{{ "admin_security.tabs.password_policy"|trans }}</a>
        </div>

        <div class="ef-row ef-row-align-start ef-row-justify-start">
            <div class="ef-col-16" style="padding-right: 60px;">
                
                {% for message in app.flashes('success') %}
                    <div role="alert" class="ef-alert ef-alert-success" style="margin-bottom: 32px; border-radius: 12px; padding: 20px; background-color: #f0fdf4; color: #166534;">
                        <div class="ef-alert-icon" style="color: #16a34a;"><i class="fa-solid fa-circle-check" style="font-size: 18px;"></i></div>
                        <div class="ef-alert-body">
                            <div class="ef-alert-content" style="font-size: 14px;">{{ message }}</div>
                        </div>
                    </div>
                {% endfor %}

                <div role="alert" class="ef-alert ef-alert-info" style="margin-bottom: 32px; background-color: #f0f4f8; border: none; border-radius: 12px; padding: 20px;">
                    <div class="ef-alert-icon" style="color: #0066cc; align-self: flex-start; margin-top: 2px;">
                        <i class="fa-solid fa-shield-halved" style="font-size: 18px;"></i>
                    </div>
                    <div class="ef-alert-body">
                        <div class="ef-alert-title" style="font-weight: 600; font-size: 15px; margin-bottom: 4px; color: #1d1d1f;">{{ "passPolicy.3"|trans }}</div>
                        <div class="ef-alert-content" style="color: #555; font-size: 14px; line-height: 1.5;">{{ "passPolicy.4"|trans }}</div>
                    </div>
                </div>

                <form action="{{ path('admin_security_password_policy_update') }}" method="post">
                    
                    <!-- 基础配置区 -->
                    <div class="policy-section">
                        <div class="policy-section-title">{{ "passPolicy.5"|trans }} (Password Policy)</div>
                        
                        <div class="form-row">
                            <div class="form-label">{{ "passPolicy.6"|trans }}</div>
                            <div class="form-control">
                                <span class="ef-input-wrapper">
                                    <input type="number" name="min_length" class="ef-input ef-input-size-medium" value="{{ policy.minLength }}" min="1" max="128">
                                </span>
                            </div>
                        </div>
                        
                        <div class="form-row">
                            <div class="form-label">{{ "passPolicy.7"|trans }}</div>
                            <div class="form-control">
                                <span class="ef-input-wrapper">
                                    <input type="number" name="max_length" class="ef-input ef-input-size-medium" value="{{ policy.maxLength }}" min="1" max="128">
                                </span>
                            </div>
                        </div>

                        <div class="form-row" style="align-items: flex-start;">
                            <div class="form-label" style="margin-top: 4px;">{{ "passPolicy.8"|trans }}</div>
                            <div class="form-control checkbox-group">
                                <label class="checkbox-item">
                                    <input type="checkbox" name="require_uppercase" {% if policy.requireUppercase %}checked{% endif %}> {{ "passPolicy.9"|trans }}
                                </label>
                                <label class="checkbox-item">
                                    <input type="checkbox" name="require_lowercase" {% if policy.requireLowercase %}checked{% endif %}> {{ "passPolicy.10"|trans }}
                                </label>
                                <label class="checkbox-item">
                                    <input type="checkbox" name="require_number" {% if policy.requireNumber %}checked{% endif %}> {{ "passPolicy.11"|trans }}
                                </label>
                                <label class="checkbox-item">
                                    <input type="checkbox" name="require_special" {% if policy.requireSpecial %}checked{% endif %}> {{ "passPolicy.12"|trans }}
                                </label>
                            </div>
                        </div>

                        <div class="form-row" style="align-items: flex-start; margin-top: 24px;">
                            <div class="form-label" style="margin-top: 4px;">{{ "passPolicy.13"|trans }}</div>
                            <div class="form-control checkbox-group">
                                <label class="checkbox-item">
                                    <input type="checkbox" name="forbid_username" {% if policy.forbidUsername %}checked{% endif %}> {{ "passPolicy.14"|trans }} / {{ "passPolicy.15"|trans }}
                                </label>
                                <label class="checkbox-item">
                                    <input type="checkbox" name="forbid_common_password" {% if policy.forbidCommonPassword %}checked{% endif %}> {{ "passPolicy.16"|trans }}
                                </label>
                            </div>
                        </div>

                        <div class="form-row" style="align-items: flex-start; margin-top: 24px;">
                            <div class="form-label" style="margin-top: 4px;">{{ "passPolicy.17"|trans }}</div>
                            <div class="form-control" style="display: flex; flex-direction: column; gap: 12px;">
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    <span class="ef-input-wrapper" style="flex: 1; max-width: 240px;">
                                        <input type="text" name="default_password" class="ef-input ef-input-size-medium" value="{{ policy.defaultPassword }}" placeholder="{{ "passPolicy.1"|trans }}">
                                    </span>
                                    <span style="font-size: 12px; color: #86868b;">{{ "passPolicy.18"|trans }}</span>
                                </div>
                                <label class="checkbox-item">
                                    <input type="checkbox" name="force_reset_password_on_first_login" {% if policy.forceResetPasswordOnFirstLogin %}checked{% endif %}> {{ "passPolicy.19"|trans }}
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- AI 智能配置区 -->
                    <div class="policy-section">
                        <div class="policy-section-title">
                            {{ "passPolicy.20"|trans }} (Strength Rules) 
                            <span class="rule-tag" style="background: #fdf4ff; color: #0284c7; border: 1px solid #e0f2fe; margin-left: 8px;">
                                <i class="fa-solid fa-wand-magic-sparkles"></i> {{ "passPolicy.21"|trans }}
                            </span>
                        </div>
                        
                        <div style="font-size: 14px; color: #64748b; margin-bottom: 16px;">
                            {{ "passPolicy.22"|trans }}"{{ "passPolicy.23"|trans }}"。
                        </div>

                        <div class="ai-chat-box">
                            <div class="ai-input-group">
                                <input type="text" class="ai-input" placeholder="{{ "passPolicy.2"|trans }}" id="aiInstructionInput">
                                <button type="button" class="btn primary medium" style="border-radius: 6px; padding: 0 16px; white-space: nowrap;" onclick="generateRulesViaAI()">
                                    <i class="fa-solid fa-robot"></i> {{ "passPolicy.24"|trans }}
                                </button>
                            </div>
                            
                            <div id="aiResultArea" style="margin-top: 16px; padding-top: 16px; border-top: 1px dashed #e2e8f0; display: none;">
                                <div style="font-size: 13px; font-weight: 500; color: #475569; margin-bottom: 8px;">{{ "passPolicy.25"|trans }} ({{ "passPolicy.26"|trans }}):</div>
                                <div>
                                    <span class="rule-tag">[{{ "passPolicy.27"|trans }} ≥ 12]</span>
                                    <span class="rule-tag">[{{ "passPolicy.28"|trans }}]</span>
                                    <span class="rule-tag">[{{ "passPolicy.29"|trans }}]</span>
                                    <span class="rule-tag">[{{ "passPolicy.30"|trans }}]</span>
                                    <span class="rule-tag">[{{ "passPolicy.31"|trans }}]</span>
                                    <span class="rule-tag">[{{ "passPolicy.32"|trans }}]</span>
                                </div>
                                <div style="font-size: 12px; color: #94a3b8; margin-top: 8px;">*{{ "passPolicy.33"|trans }}</div>
                            </div>
                        </div>

                        <!-- 现有的规则列表占位 -->
                        <table class="ef-table ef-table-border" style="width: 100%; margin-top: 16px;">
                            <thead>
                                <tr class="ef-table-tr">
                                    <th class="ef-table-th">{{ "passPolicy.34"|trans }}</th>
                                    <th class="ef-table-th">{{ "passPolicy.35"|trans }} / {{ "passPolicy.36"|trans }} ({{ "passPolicy.37"|trans }})</th>
                                    <th class="ef-table-th" style="width: 100px;">{{ "passPolicy.38"|trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if rules|length > 0 %}
                                    {% for rule in rules %}
                                        <tr class="ef-table-tr">
                                            <td class="ef-table-td">{{ rule.name }}</td>
                                            <td class="ef-table-td">
                                                <code style="font-size: 12px; color: #d946ef; background: #fdf4ff; padding: 2px 6px; border-radius: 4px;">{{ rule.expression|json_encode }}</code>
                                            </td>
                                            <td class="ef-table-td">
                                                <a href="#" class="ef-link">{{ "passPolicy.39"|trans }}</a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                {% else %}
                                    <tr class="ef-table-tr">
                                        <td class="ef-table-td">{{ "passPolicy.40"|trans }}</td>
                                        <td class="ef-table-td"><span class="rule-tag">[{{ "passPolicy.27"|trans }} ≥ 6]</span></td>
                                        <td class="ef-table-td"><a href="#" class="ef-link">{{ "passPolicy.39"|trans }}</a></td>
                                    </tr>
                                    <tr class="ef-table-tr">
                                        <td class="ef-table-td">{{ "passPolicy.41"|trans }}</td>
                                        <td class="ef-table-td"><span class="rule-tag">[{{ "passPolicy.27"|trans }} ≥ 8]</span> <span class="rule-tag">[{{ "passPolicy.28"|trans }}]</span></td>
                                        <td class="ef-table-td"><a href="#" class="ef-link">{{ "passPolicy.39"|trans }}</a></td>
                                    </tr>
                                    <tr class="ef-table-tr">
                                        <td class="ef-table-td">{{ "passPolicy.42"|trans }}</td>
                                        <td class="ef-table-td"><span class="rule-tag">[{{ "passPolicy.27"|trans }} ≥ 10]</span> <span class="rule-tag">[{{ "passPolicy.28"|trans }}]</span> <span class="rule-tag">[{{ "passPolicy.43"|trans }}]</span></td>
                                        <td class="ef-table-td"><a href="#" class="ef-link">{{ "passPolicy.39"|trans }}</a></td>
                                    </tr>
                                {% endif %}
                            </tbody>
                        </table>
                    </div>

                    <!-- 生命周期与附加策略 -->
                    <div class="policy-section">
                        <div class="policy-section-title">{{ "passPolicy.44"|trans }}</div>
                        
                        <div class="form-row">
                            <div class="form-label">{{ "passPolicy.45"|trans }} ({{ "passPolicy.46"|trans }})</div>
                            <div class="form-control">
                                <span class="ef-input-wrapper">
                                    <input type="number" name="expire_days" class="ef-input ef-input-size-medium" value="{{ policy.expireDays }}" min="0">
                                </span>
                                <div style="font-size: 12px; color: #86868b; margin-top: 4px;">{{ "passPolicy.47"|trans }}</div>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-label">{{ "passPolicy.48"|trans }}</div>
                            <div class="form-control">
                                <span class="ef-input-wrapper">
                                    <input type="number" name="history_limit" class="ef-input ef-input-size-medium" value="{{ policy.historyLimit }}" min="0">
                                </span>
                                <div style="font-size: 12px; color: #86868b; margin-top: 4px;">{{ "passPolicy.49"|trans }}</div>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-label">{{ "passPolicy.50"|trans }}</div>
                            <div class="form-control">
                                <span class="ef-input-wrapper">
                                    <input type="number" name="max_retry" class="ef-input ef-input-size-medium" value="{{ policy.maxRetry }}" min="0">
                                </span>
                                <div style="font-size: 12px; color: #86868b; margin-top: 4px;">{{ "passPolicy.51"|trans }}</div>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-label">{{ "passPolicy.52"|trans }} ({{ "passPolicy.53"|trans }})</div>
                            <div class="form-control">
                                <span class="ef-input-wrapper">
                                    <input type="number" name="lock_minutes" class="ef-input ef-input-size-medium" value="{{ policy.lockMinutes }}" min="1">
                                </span>
                            </div>
                        </div>
                    </div>

                    <div style="margin-top: 24px; padding: 24px; background: #fff; border: 1px solid #e5e5ea; border-radius: 12px; display: flex; justify-content: center;">
                        <button type="submit" class="btn primary medium" style="border-radius: 20px; padding: 0 32px;">
                            <i class="fa-solid fa-save"></i> &nbsp;{{ "passPolicy.54"|trans }}
                        </button>
                    </div>
                </form>

            </div>
            
            <div class="ef-col-8">
                <div class="side-card">
                    <div class="side-card-title">{{ "passPolicy.55"|trans }}</div>
                    <div class="side-card-text">
                        {{ "passPolicy.56"|trans }}
                    </div>
                </div>

                <div class="side-card" style="background: #fdf4ff;">
                    <div class="side-card-title" style="color: #a21caf;"><i class="fa-solid fa-wand-magic-sparkles"></i> {{ "passPolicy.57"|trans }}</div>
                    <div class="side-card-text">
                        {{ "passPolicy.58"|trans }} <strong>PasswordPolicyAgent</strong>{{ "passPolicy.59"|trans }}
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function generateRulesViaAI() {
            const input = document.getElementById('aiInstructionInput').value;
            if (!input) {
                ui.alert.show({title: t('passPolicy.js7'), content: t('passPolicy.js8'), type: 'warning'});
                return;
            }
            
            const btn = document.querySelector('.ai-input-group button');
            const originalText = btn.innerHTML;
            btn.innerHTML = t('passPolicy.js9');
            btn.disabled = true;

            fetch('{{ path('api_admin_ai_parse_policy') }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ text: input })
            })
            .then(response => response.json())
            .then(data => {
                btn.innerHTML = originalText;
                btn.disabled = false;
                
                if (data.error) {
                    ui.alert.show({title: t('passPolicy.js10'), content: data.error, type: 'error'});
                    return;
                }

                const resultArea = document.getElementById('aiResultArea');
                resultArea.style.display = 'block';
                
                // Clear existing tags except the label div and disclaimer
                const tagsContainer = resultArea.querySelector('div:nth-child(2)');
                tagsContainer.innerHTML = '';
                
                // Render DSL into UI tags
                const expression = data.expression;
                renderDslToTags(expression, tagsContainer);
                
            })
            .catch(error => {
                btn.innerHTML = originalText;
                btn.disabled = false;
                ui.alert.show({title: t('passPolicy.js11'), content: t('passPolicy.js12'), type: 'error'});
            });
        }

        function renderDslToTags(expression, container) {
            if (expression.and) {
                expression.and.forEach(cond => appendTag(cond, container));
            } else if (expression.field) {
                appendTag(expression, container);
            } else {
                container.innerHTML = '<span class="rule-tag" style="background: #fee2e2; color: #991b1b;">{{ "passPolicy.unparseable"|trans }}</span>';
            }
        }

        function appendTag(cond, container) {
            let text = '';
            if (cond.field === 'length') {
                text = t('passPolicy.js1', {p1: cond.operator, p2: cond.value});
            } else if (cond.field === 'has_number' && cond.value === true) {
                text = t('passPolicy.js2');
            } else if (cond.field === 'has_uppercase' && cond.value === true) {
                text = t('passPolicy.js3');
            } else if (cond.field === 'has_lowercase' && cond.value === true) {
                text = t('passPolicy.js4');
            } else if (cond.field === 'has_special' && cond.value === true) {
                text = t('passPolicy.js5');
            } else if (cond.field === 'has_case' && cond.value === 'mixed') {
                text = t('passPolicy.js6');
            } else {
                text = `${cond.field} ${cond.operator} ${cond.value}`;
            }

            const span = document.createElement('span');
            span.className = 'rule-tag';
            span.textContent = `[${text}]`;
            container.appendChild(span);
        }
    </script>
{% endblock %}
