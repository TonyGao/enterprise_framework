{# Toast 容器 #}
<div class="task-toast" id="task-toast-container"></div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
/* ==============================================================
   定时任务管理页面 JS
   依赖：jQuery（框架已全局引入）
============================================================== */

const TaskMgr = (function($) {
    'use strict';

    // ---- 状态 ----
    let state = {
        view: 'list',          // list | calendar | week | day
        tasks: [],
        total: 0,
        page: 1,
        pageSize: 20,
        calYear:  new Date().getFullYear(),
        calMonth: new Date().getMonth() + 1,
        calDate:  new Date(), // 用于周视图、天视图的基准日期
        searchTimer: null,
        editingId: null,
        taskType: 'recurring', // recurring | once
        cronPeriod: 'minute',  // minute | interval | hour | day | week | month
        logTaskId: null,
        logPage: 1,
        logPageSize: 20,
        logTotal: 0,
        logOutputMap: {},
    };

    // ---- API 基础路径 ----
    const BASE = '/admin/task/api';

    // ================================================================
    //  公共工具
    // ================================================================
    function toast(msg, type = 'info') {
        const icons = { success: 'fa-circle-check', error: 'fa-circle-xmark', info: 'fa-circle-info' };
        const el = $(`<div class="toast-item ${type}"><i class="fa-solid ${icons[type]}"></i><span>${msg}</span></div>`);
        $('#task-toast-container').append(el);
        setTimeout(() => el.fadeOut(300, () => el.remove()), 3000);
    }

    function request(method, url, data) {
        return $.ajax({
            method,
            url,
            contentType: 'application/json',
            data: data ? JSON.stringify(data) : undefined,
        }).then(res => {
            // 兼容 ApiResponse 标准格式 {code, message, data}
            if (res && typeof res === 'object' && 'data' in res) {
                return res.data;
            }
            return res;
        }).fail((xhr) => {
            const body = xhr.responseJSON;
            const err = body?.message || body?.error || '请求失败，请稍后重试';
            toast(err, 'error');
        });
    }

    function normalizeBool(v) {
        if (v === true || v === false) return v;
        if (typeof v === 'number') return v === 1;
        if (typeof v === 'string') {
            const s = v.trim().toLowerCase();
            if (s === 'true' || s === '1' || s === 'yes' || s === 'on') return true;
            if (s === 'false' || s === '0' || s === 'no' || s === 'off' || s === '') return false;
        }
        return !!v;
    }

    function toggleFormEnabledSwitch() {
        const $btn = $('#f-enabled');
        const next = !normalizeBool($btn.attr('aria-checked'));
        $btn.attr('aria-checked', next ? 'true' : 'false');
        $btn.toggleClass('ef-switch-checked', next);
    }

    // ================================================================
    //  类别颜色映射
    // ================================================================
    const CATEGORY_COLORS = {
        'system':  'cat-system',
        'report':  'cat-report',
        'data':    'cat-data',
        'notify':  'cat-notify',
    };

    function catClass(cat) {
        if (!cat) return 'cat-default';
        return CATEGORY_COLORS[cat.toLowerCase()] || 'cat-default';
    }

    const CATEGORY_LABELS = {
        'system':  '系统',
        'report':  '报表',
        'data':    '数据',
        'notify':  '通知',
    };

    function catLabel(cat) {
        return cat ? (CATEGORY_LABELS[cat.toLowerCase()] || cat) : '-';
    }

    // ================================================================
    //  统计卡片
    // ================================================================
    function loadStats() {
        request('GET', `${BASE}/list?pageSize=1000`).then(res => {
            const all = res.items;
            const enabled = all.filter(t => t.enabled).length;
            let errors = 0;
            all.forEach(t => { if (t.latestStatus === 'error') errors++; });

            $('#stat-total').text(res.total);
            $('#stat-enabled').text(enabled);
            $('#stat-today').text('-'); // 需要专门统计接口
            $('#stat-errors').text(errors);
        });
    }

    // ================================================================
    //  加载统计 + 分类（合并为单一请求 /api/stats）
    // ================================================================
    function loadStats() {
        request('GET', `${BASE}/stats`).then(res => {
            $('#stat-total').text(res.total ?? '-');
            $('#stat-enabled').text(res.enabled ?? '-');
            $('#stat-today').text(res.todayCount ?? '-');
            $('#stat-errors').text(res.errors ?? '-');

            // 同步更新分类下拉
            const cats = res.categories || [];
            const sel = $('#filter-category');
            const cur = sel.val();
            sel.find('option:not(:first)').remove();
            cats.forEach(c => sel.append(`<option value="${c}">${catLabel(c)} (${c})</option>`));
            if (cur) sel.val(cur);
        });
    }

    // ================================================================
    //  任务列表
    // ================================================================
    function loadTasks() {
        const keyword  = encodeURIComponent($('#search-keyword').val().trim());
        const enabled  = $('#filter-enabled').val();
        const category = encodeURIComponent($('#filter-category').val());
        const { page, pageSize } = state;

        let url = `${BASE}/list?page=${page}&pageSize=${pageSize}`;
        if (keyword)  url += `&keyword=${keyword}`;
        if (enabled !== '') url += `&enabled=${enabled}`;
        if (category) url += `&category=${category}`;

        request('GET', url).then(res => {
            state.tasks = res.items;
            state.total = res.total;
            renderTaskTable(res.items);
            renderPagination();
        });
    }

    function renderTaskTable(tasks) {
        const $tbody = $('#task-table-body');
        if (!tasks.length) {
            $tbody.html(`<tr><td colspan="9"><div class="task-empty"><i class="fa-solid fa-clock-rotate-left"></i><p>{{ 'admin.task.empty'|trans({}, 'messages')|default('暂无任务') }}</p></div></td></tr>`);
            return;
        }

        const rows = tasks.map((t, idx) => {
            const isEnabled = normalizeBool(t.enabled);
            const statusHtml = t.latestStatus
                ? `<span class="status-badge ${t.latestStatus}">${statusLabel(t.latestStatus)}</span>`
                : `<span class="status-badge none">未执行</span>`;

            const catHtml = t.category
                ? `<span class="task-category-badge ${catClass(t.category)}" style="background:inherit;font-size:13px;">${catLabel(t.category)}</span>`
                : '<span style="color:#b0b5cc;">-</span>';

            // 单次执行任务：cron badge 显示日期时间而非表达式
            const cronHtml = isOnceCron(t.cronExpression)
                ? `<span class="cron-once-badge"><i class="fa-solid fa-clock" style="font-size:10px;"></i>${formatOnceExpr(t.cronExpression, t.nextRunAt)}</span>`
                : `<span class="cron-human-badge" title="${escHtml(t.cronExpression)}"><i class="fa-solid fa-rotate" style="font-size:10px;"></i>${escHtml(cronToHuman(t.cronExpression))}</span>`;

            return `<tr data-id="${t.id}">
                <td style="color:#b0b5cc;font-size:12px;text-align:center;">${(state.page-1)*state.pageSize + idx + 1}</td>
                <td>
                    <div class="task-name-cell">
                        <span class="task-name">${escHtml(t.name)}</span>
                        <span class="task-handler">${escHtml(shortHandler(t.handler))}</span>
                    </div>
                </td>
                <td>${cronHtml}</td>
                <td>${catHtml}</td>
                <td style="font-size:13px;color:#8a8fa8;">${t.lastRunAt || '-'}</td>
                <td style="font-size:13px;color:#8a8fa8;">${t.nextRunAt ? formatDatetime(t.nextRunAt) : '-'}</td>
                <td>${statusHtml}</td>
                <td>
                    <button type="button" role="switch"
                        aria-checked="${isEnabled ? 'true' : 'false'}"
                        class="ef-switch ef-switch-type-circle${isEnabled ? ' ef-switch-checked' : ''}"
                        onclick="toggleTask('${t.id}', this)">
                        <span class="ef-switch-handle"><span class="ef-switch-handle-icon"></span></span>
                    </button>
                </td>
                <td>
                    <div class="task-actions">
                        <button class="task-action-btn run" data-tip="立即执行" onclick="runNow('${t.id}', '${escHtml(t.name)}')">
                            <i class="fa-solid fa-play"></i>
                        </button>
                        <button class="task-action-btn" data-tip="编辑任务" onclick="openEditDrawer('${t.id}')">
                            <i class="fa-solid fa-pen"></i>
                        </button>
                        <button class="task-action-btn logs" data-tip="执行日志" onclick="openLogs('${t.id}', '${escHtml(t.name)}')">
                            <i class="fa-solid fa-scroll"></i>
                        </button>
                        <button class="task-action-btn del" data-tip="删除任务" onclick="deleteTask('${t.id}', '${escHtml(t.name)}')">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                </td>
            </tr>`;
        });

        $tbody.html(rows.join(''));
    }

    function renderPagination() {
        const totalPages = Math.max(1, Math.ceil(state.total / state.pageSize));
        $('#pagination-info').text(state.total > 0 ? "{{ 'admin.task.total_tasks'|trans({}, 'messages')|default('任务总数') }}: " + state.total : "{{ 'admin.task.empty'|trans({}, 'messages')|default('暂无任务') }}");

        const $btns = $('#pagination-btns').empty();
        const addBtn = (label, page, disabled = false, active = false) => {
            const cls = `page-btn${active ? ' active' : ''}`;
            const btn = $(`<button class="${cls}" ${disabled ? 'disabled' : ''}>${label}</button>`);
            if (!disabled) btn.on('click', () => { state.page = page; loadTasks(); });
            $btns.append(btn);
        };

        addBtn('<i class="fa-solid fa-angles-left"></i>', 1, state.page === 1);
        addBtn('<i class="fa-solid fa-chevron-left"></i>', state.page - 1, state.page === 1);

        const startPage = Math.max(1, state.page - 2);
        const endPage   = Math.min(totalPages, state.page + 2);
        for (let p = startPage; p <= endPage; p++) {
            addBtn(p, p, false, p === state.page);
        }

        addBtn('<i class="fa-solid fa-chevron-right"></i>', state.page + 1, state.page >= totalPages);
        addBtn('<i class="fa-solid fa-angles-right"></i>', totalPages, state.page >= totalPages);
    }

    // ================================================================
    //  启用/禁用（列表行 ef-switch）
    // ================================================================
    function toggleTask(id, btn) {
        request('POST', `${BASE}/${id}/toggle`).then(res => {
            // 同步按钮状态
            const enabled = res.enabled;
            btn.setAttribute('aria-checked', enabled ? 'true' : 'false');
            enabled ? btn.classList.add('ef-switch-checked') : btn.classList.remove('ef-switch-checked');
            toast(enabled ? '任务已启用' : '任务已禁用', 'info');
        }).fail(() => {
            // 回滚
            const cur = btn.getAttribute('aria-checked') === 'true';
            btn.setAttribute('aria-checked', cur ? 'true' : 'false');
        });
    }

