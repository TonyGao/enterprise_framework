    function fillForm(task) {
        $('#task-id').val(task.id);
        $('#f-name').val(task.name);
        $('#f-description').val(task.description || '');
        $('#f-cron').val(task.cronExpression);
        $('#f-handler').val(task.handler);
        $('#f-payload').val(JSON.stringify(task.payload, null, 2));
        $('#f-category').val(task.category || '');
        $('#f-sort').val(task.sortOrder);
        $('#f-retries').val(task.maxRetries);
        $('#f-timeout').val(task.timeout);
        const enabled = normalizeBool(task.enabled);
        $('#f-enabled').attr('aria-checked', enabled ? 'true' : 'false');
        enabled ? $('#f-enabled').addClass('ef-switch-checked') : $('#f-enabled').removeClass('ef-switch-checked');
        updateCronDesc(task.cronExpression);

        // 判断是否为单次执行任务（Cron 中 日 和 月 均为具体数字而非通配符）
        if (isOnceCron(task.cronExpression)) {
            switchTaskType('once');
            const dt = onceCronToDatetime(task.cronExpression, task.nextRunAt);
            $('#f-once-datetime').val(dt);
        } else {
            switchTaskType('recurring');
            parseCronToUI(task.cronExpression);
        }
    }

    /** 判断 cron 表达式是否为"单次执行"模式（日和月都是具体数字） */
    function isOnceCron(expr) {
        if (!expr) return false;
        const parts = expr.trim().split(/\s+/);
        if (parts.length < 5) return false;
        const day   = parts[2];
        const month = parts[3];
        return /^\d+$/.test(day) && /^\d+$/.test(month);
    }

    /** 将单次执行 Cron 转换回可显示的 datetime 字符串，优先使用 nextRunAt */
    function onceCronToDatetime(expr, nextRunAt) {
        if (nextRunAt) return nextRunAt.substring(0, 16); // "YYYY-MM-DD HH:mm"
        if (!expr) return '';
        const parts = expr.trim().split(/\s+/);
        if (parts.length < 5) return '';
        const now = new Date();
        const year = now.getFullYear();
        const m = parts[3].padStart(2, '0');
        const d = parts[2].padStart(2, '0');
        const h = parts[1].padStart(2, '0');
        const min = parts[0].padStart(2, '0');
        return `${year}-${m}-${d} ${h}:${min}`;
    }

    /** 格式化 datetime 字符串用于表格显示 "YYYY-MM-DD HH:mm" → "Y年M月D日 HH:mm" */
    function formatDatetime(dt) {
        if (!dt) return '-';
        const s = dt.replace('T', ' ').substring(0, 16);
        const [datePart, timePart] = s.split(' ');
        if (!datePart) return s;
        const [y, mo, dd] = datePart.split('-');
        const year = parseInt(y, 10);
        const prefix = Number.isFinite(year) ? `${year}年` : '';
        return `${prefix}${parseInt(mo, 10)}月${parseInt(dd, 10)}日 ${timePart ? timePart.substring(0, 5) : ''}`;
    }

    /** 将单次执行 Cron 转成可读的日期时间用于徽章显示 */
    function formatOnceExpr(expr, nextRunAt) {
        const dt = onceCronToDatetime(expr, nextRunAt);
        if (!dt) return '单次执行';
        const [datePart, timePart] = dt.replace('T', ' ').split(' ');
        if (!datePart) return dt;
        const [y, mo, dd] = datePart.split('-');
        const year = parseInt(y, 10);
        const prefix = Number.isFinite(year) ? `${year}年` : '';
        return `${prefix}${parseInt(mo, 10)}月${parseInt(dd, 10)}日 ${timePart ? timePart.substring(0, 5) : ''}`;
    }

    /** 切换任务类型：recurring（循环）| once（单次）| ai（AI 表达） */
    function switchTaskType(type) {
        const tabs = document.querySelectorAll('#task-type-tabs .task-type-tab');
        tabs.forEach(t => t.classList.toggle('active', t.dataset.type === type));
        $('#cron-group, #once-group, #ai-group').hide();
        if (type === 'once') {
            $('#once-group').show();
        } else if (type === 'ai') {
            $('#ai-group').show();
        } else {
            $('#cron-group').show();
        }
        state.taskType = type;
    }

    // ================================================================
    //  可视化 Cron 构建器
    // ================================================================
    const CRON_PERIODS = ['second', 'interval', 'hour', 'day', 'week', 'month', 'quarter'];

    function switchCronPeriod(period) {
        document.querySelectorAll('#cron-period-row .cron-period-btn').forEach(b => {
            b.classList.toggle('active', b.dataset.period === period);
        });
        CRON_PERIODS.forEach(p => $(`#cron-sub-${p}`).hide());
        $(`#cron-sub-${period}`).show();
        state.cronPeriod = period;
        buildCronFromUI();
    }

    function toggleMonthDayInput() {
        const type = $('#cron-month-day-type').val();
        $('#cron-month-specific-wrap').toggle(type === 'specific');
    }

    function toggleWeekDay(btn) {
        $(btn).toggleClass('selected');
        buildCronFromUI();
    }

    function buildCronFromUI() {
        const period = state.cronPeriod || 'second';
        let cron = '@seconds:30';
        switch (period) {
            case 'second': {
                const n = Math.max(1, parseInt($('#cron-second').val()) || 30);
                cron = `@seconds:${n}`;
                break;
            }
            case 'interval': {
                const n = Math.max(1, Math.min(59, parseInt($('#cron-interval').val()) || 5));
                cron = `*/${n} * * * *`;
                break;
            }
            case 'hour': {
                const n = Math.max(1, Math.min(23, parseInt($('#cron-hour-n').val()) || 1));
                const m = Math.max(0, Math.min(59, parseInt($('#cron-hour-min').val()) || 0));
                cron = n === 1 ? `${m} * * * *` : `${m} */${n} * * *`;
                break;
            }
            case 'day': {
                const n = Math.max(1, parseInt($('#cron-day-n').val()) || 1);
                const [h, m] = ($('#cron-day-time').val() || '00:00').split(':');
                const hh = parseInt(h)||0, mm = parseInt(m)||0;
                cron = n === 1 ? `${mm} ${hh} * * *` : `${mm} ${hh} */${n} * *`;
                break;
            }
            case 'week': {
                const n = Math.max(1, parseInt($('#cron-week-n').val()) || 1);
                const days = [...document.querySelectorAll('#cron-week-days .cron-week-day-btn.selected')]
                    .map(el => el.dataset.day);
                const dayStr = days.length ? days.join(',') : '1';
                const [h, m] = ($('#cron-week-time').val() || '00:00').split(':');
                const hh = parseInt(h)||0, mm = parseInt(m)||0;
                cron = n === 1 ? `${mm} ${hh} * * ${dayStr}` : `@weekly:${n}:${dayStr}:${hh}:${mm}`;
                break;
            }
            case 'month': {
                const n = Math.max(1, Math.min(12, parseInt($('#cron-month-n').val()) || 1));
                const dayType = $('#cron-month-day-type').val() || 'specific';
                const [h, m] = ($('#cron-month-time').val() || '00:00').split(':');
                const hh = parseInt(h)||0, mm = parseInt(m)||0;
                if (dayType === 'last') {
                    cron = `@monthly-last:${n}:${hh}:${mm}`;
                } else {
                    const day = dayType === 'first' ? 1 : Math.max(1, Math.min(31, parseInt($('#cron-month-day').val()) || 1));
                    cron = n === 1 ? `${mm} ${hh} ${day} * *` : `${mm} ${hh} ${day} */${n} *`;
                }
                break;
            }
            case 'quarter': {
                const n = Math.max(1, Math.min(4, parseInt($('#cron-quarter-n').val()) || 1));
                const mon = Math.max(1, Math.min(3, parseInt($('#cron-quarter-month').val()) || 1));
                const day = Math.max(1, Math.min(31, parseInt($('#cron-quarter-day').val()) || 1));
                const [h, m] = ($('#cron-quarter-time').val() || '09:00').split(':');
                cron = `@quarterly:${n}:${mon}:${day}:${parseInt(h)||9}:${parseInt(m)||0}`;
                break;
            }
        }
        $('#f-cron').val(cron);
        updateCronDesc(cron);
        return cron;
    }

    /** 反向解析 Cron 表达式并填充到 UI */
    function parseCronToUI(expr) {
        if (!expr) { switchCronPeriod('second'); return; }

        if (expr.startsWith('@seconds:')) {
            switchCronPeriod('second');
            $('#cron-second').val(expr.substring(9));
            return;
        }
        if (expr.startsWith('@weekly:')) {
            const parts = expr.split(':'); // @weekly:N:DOWS:H:M
            switchCronPeriod('week');
            $('#cron-week-n').val(parts[1]);
            const dows = (parts[2]||'1').split(',');
            document.querySelectorAll('#cron-week-days .cron-week-day-btn').forEach(btn => {
                btn.classList.toggle('selected', dows.includes(btn.dataset.day));
            });
            $('#cron-week-time').val(`${String(parseInt(parts[3])||0).padStart(2,'0')}:${String(parseInt(parts[4])||0).padStart(2,'0')}`);
            return;
        }
        if (expr.startsWith('@monthly-last:')) {
            const parts = expr.split(':'); // @monthly-last:N:H:M
            switchCronPeriod('month');
            $('#cron-month-n').val(parts[1]);
            $('#cron-month-day-type').val('last');
            toggleMonthDayInput();
            $('#cron-month-time').val(`${String(parseInt(parts[2])||0).padStart(2,'0')}:${String(parseInt(parts[3])||0).padStart(2,'0')}`);
            return;
        }
        if (expr.startsWith('@quarterly:')) {
            const parts = expr.substring(11).split(':'); // N:MON:DAY:H:M
            switchCronPeriod('quarter');
            $('#cron-quarter-n').val(parts[0]);
            $('#cron-quarter-month').val(parts[1]);
            $('#cron-quarter-day').val(parts[2]);
            $('#cron-quarter-time').val(`${String(parseInt(parts[3])||0).padStart(2,'0')}:${String(parseInt(parts[4])||0).padStart(2,'0')}`);
            return;
        }

        const parts = expr.trim().split(/\s+/);
        if (parts.length < 5) { switchCronPeriod('second'); return; }
        const [min, hour, day, month, dow] = parts;

        if (/^\*\/\d+$/.test(min) && hour==='*' && day==='*' && month==='*' && dow==='*') {
            switchCronPeriod('interval');
            $('#cron-interval').val(min.substring(2));
        } else if (/^\d+$/.test(min) && /^\*\/\d+$/.test(hour) && day==='*' && month==='*' && dow==='*') {
            switchCronPeriod('hour');
            $('#cron-hour-n').val(hour.substring(2));
            $('#cron-hour-min').val(min);
        } else if (/^\d+$/.test(min) && /^\d+$/.test(hour) && /^\*\/\d+$/.test(day) && month==='*' && dow==='*') {
            switchCronPeriod('day');
            $('#cron-day-n').val(day.substring(2));
            $('#cron-day-time').val(`${String(parseInt(hour)).padStart(2,'0')}:${String(parseInt(min)).padStart(2,'0')}`);
        } else if (/^\d+$/.test(min) && /^\d+$/.test(hour) && day==='*' && month==='*' && dow==='*') {
            switchCronPeriod('day');
            $('#cron-day-n').val(1);
            $('#cron-day-time').val(`${String(parseInt(hour)).padStart(2,'0')}:${String(parseInt(min)).padStart(2,'0')}`);
        } else if (/^\d+$/.test(min) && /^\d+$/.test(hour) && day==='*' && month==='*' && /^[\d,]+$/.test(dow)) {
            switchCronPeriod('week');
            $('#cron-week-n').val(1);
            $('#cron-week-time').val(`${String(parseInt(hour)).padStart(2,'0')}:${String(parseInt(min)).padStart(2,'0')}`);
            const selectedDays = dow.split(',');
            document.querySelectorAll('#cron-week-days .cron-week-day-btn').forEach(btn => {
                btn.classList.toggle('selected', selectedDays.includes(btn.dataset.day));
            });
        } else if (/^\d+$/.test(min) && /^\d+$/.test(hour) && /^\d+$/.test(day) && /^\*\/\d+$/.test(month) && dow==='*') {
            switchCronPeriod('month');
            $('#cron-month-n').val(month.substring(2));
            const d = parseInt(day);
            $('#cron-month-day-type').val(d === 1 ? 'first' : 'specific');
            if (d !== 1) $('#cron-month-day').val(d);
            toggleMonthDayInput();
            $('#cron-month-time').val(`${String(parseInt(hour)).padStart(2,'0')}:${String(parseInt(min)).padStart(2,'0')}`);
        } else if (/^\d+$/.test(min) && /^\d+$/.test(hour) && /^\d+$/.test(day) && month==='*' && dow==='*') {
            switchCronPeriod('month');
            $('#cron-month-n').val(1);
            const d = parseInt(day);
            $('#cron-month-day-type').val(d === 1 ? 'first' : 'specific');
            if (d !== 1) $('#cron-month-day').val(d);
            toggleMonthDayInput();
            $('#cron-month-time').val(`${String(parseInt(hour)).padStart(2,'0')}:${String(parseInt(min)).padStart(2,'0')}`);
        } else {
            switchCronPeriod('day');
        }
    }

    function clearErrors() {
        ['name','cron','handler','payload','once','ai'].forEach(f => $(`#e-${f}`).text(''));
    }

    function submitTask() {
        clearErrors();
        let valid = true;

        const name     = $('#f-name').val().trim();
        const handler  = $('#f-handler').val().trim();
        const taskType = state.taskType;
        let   cron     = '';
        let   nextRunAt = null;
        let   payload  = {};

        if (!name)    { $('#e-name').text('任务名称不能为空');        valid = false; }
        if (!handler) { $('#e-handler').text('Handler 类名不能为空'); valid = false; }

        if (taskType === 'once') {
            const dt = $('#f-once-datetime').val().trim();
            if (!dt) { $('#e-once').text('请选择执行时间'); valid = false; }
            else {
                const d = new Date(dt.replace(' ', 'T'));
                cron = `${d.getMinutes()} ${d.getHours()} ${d.getDate()} ${d.getMonth() + 1} *`;
                nextRunAt = dt + ':00';
            }
        } else if (taskType === 'ai') {
            cron = state.aiResultCron || '';
            if (!cron) { $('#e-ai').text('请先点击“智能解析”并应用解析结果'); valid = false; }
        } else {
            cron = $('#f-cron').val().trim();
            if (!cron) { $('#e-cron').text('Cron 表达式不能为空'); valid = false; }
        }

        try {
            payload = JSON.parse($('#f-payload').val() || '{}');
        } catch(e) {
            $('#e-payload').text('Payload 必须是合法的 JSON 格式');
            valid = false;
        }

        if (taskType === 'once') {
            payload.once = true;
            // 单次任务重设执行时间默认重新启用，避免已执行后保持禁用。
            $('#f-enabled').attr('aria-checked', 'true').addClass('ef-switch-checked');
        }

        if (!valid) return;

        const data = {
            name,
            description:    $('#f-description').val().trim() || null,
            cronExpression: cron,
            handler,
            payload,
            category:    $('#f-category').val().trim() || null,
            sortOrder:   parseInt($('#f-sort').val()) || 0,
            maxRetries:  parseInt($('#f-retries').val()) || 3,
            timeout:     parseInt($('#f-timeout').val()) || 0,
            enabled:     normalizeBool($('#f-enabled').attr('aria-checked')),
        };

        if (nextRunAt) data.nextRunAt = nextRunAt;

        const isEdit = !!state.editingId;
        const method = isEdit ? 'PUT' : 'POST';
        const url    = isEdit ? `${BASE}/${state.editingId}/update` : `${BASE}/create`;

        request(method, url, data).then(() => {
            toast(isEdit ? '任务已更新' : '任务已创建', 'success');
            closeDrawer();
            loadTasks();
            loadStats();
        });
    }

    // ================================================================
    //  Cron 人工可读化
    // ================================================================
    function cronToHuman(expr) {
        if (!expr) return '未配置';
        const p2 = n => String(parseInt(n)||0).padStart(2,'0');
        const WDAYS = {'0':'日','1':'一','2':'二','3':'三','4':'四','5':'五','6':'六'};

        if (expr.startsWith('@seconds:'))
            return `每隔 ${expr.substring(9)} 秒`;

        if (expr.startsWith('@weekly:')) {
            const [, n, dows, h, m] = expr.split(':');
            const dayStr = (dows||'1').split(',').map(d => `周${WDAYS[d]||d}`).join('、');
            return `每隔 ${n} 周，${dayStr}，${p2(h)}:${p2(m)}`;
        }
        if (expr.startsWith('@monthly-last:')) {
            const [, n, h, m] = expr.split(':');
            return `每隔 ${n} 个月，月末，${p2(h)}:${p2(m)}`;
        }
        if (expr.startsWith('@quarterly:')) {
            const [n, mon, day, h, m] = expr.substring(11).split(':');
            return `每隔 ${n} 季度，第 ${mon} 月第 ${day} 天，${p2(h)}:${p2(m)}`;
        }

        const parts = expr.trim().split(/\s+/);
        if (parts.length < 5) return expr;
        const [min, hour, day, month, dow] = parts;

        if (/^\*\/\d+$/.test(min) && hour==='*' && day==='*' && month==='*' && dow==='*')
            return `每隔 ${min.substring(2)} 分钟`;
        if (/^\d+$/.test(min) && /^\*\/\d+$/.test(hour) && day==='*' && month==='*' && dow==='*')
            return `每隔 ${hour.substring(2)} 小时，:${p2(min)}`;
        if (/^\d+$/.test(min) && /^\d+$/.test(hour) && /^\*\/\d+$/.test(day) && month==='*' && dow==='*')
            return `每隔 ${day.substring(2)} 天，${p2(hour)}:${p2(min)}`;
        if (/^\d+$/.test(min) && /^\d+$/.test(hour) && day==='*' && month==='*' && dow==='*')
            return `每天 ${p2(hour)}:${p2(min)}`;
        if (/^\d+$/.test(min) && /^\d+$/.test(hour) && day==='*' && month==='*' && /^[\d,]+$/.test(dow)) {
            const dayStr = dow.split(',').map(d => `周${WDAYS[d]||d}`).join('、');
            return `每周 ${dayStr}，${p2(hour)}:${p2(min)}`;
        }
        if (/^\d+$/.test(min) && /^\d+$/.test(hour) && /^\d+$/.test(day) && /^\*\/\d+$/.test(month) && dow==='*')
            return `每隔 ${month.substring(2)} 个月，第 ${day} 天，${p2(hour)}:${p2(min)}`;
        if (/^\d+$/.test(min) && /^\d+$/.test(hour) && /^\d+$/.test(day) && month==='*' && dow==='*')
            return `每月第 ${day} 天，${p2(hour)}:${p2(min)}`;

        return expr;
    }

    function updateCronDesc(expr) {
        if (!expr) { $('#cron-desc').text('-'); return; }
        const e = expr.trim().split(/\s+/);
        if (e.length < 5) { $('#cron-desc').text('格式不正确（需5段：分 时 日 月 周）'); return; }

        const map = [
            [e[0], '分'], [e[1], '时'], [e[2], '日'], [e[3], '月'], [e[4], '周'],
        ];
        const readable = {
            '* * * * *':    '每分钟执行一次',
            '*/5 * * * *':  '每5分钟执行一次',
            '0 * * * *':    '每小时整点执行',
            '0 0 * * *':    '每天凌晨0点执行',
            '0 2 * * *':    '每天凌晨2点执行',
            '0 0 * * 1':    '每周一凌晨0点执行',
            '0 0 1 * *':    '每月1日凌晨0点执行',
        };
        $('#cron-desc').text(readable[expr.trim()] || `分:${e[0]} 时:${e[1]} 日:${e[2]} 月:${e[3]} 周:${e[4]}`);
    }

    // ================================================================
    //  AI 表达解析
    // ================================================================
    function parseAiSchedule() {
        const text = $('#f-ai-text').val().trim();
        if (!text) { $('#e-ai').text('请输入调度规则描述'); return; }
        $('#e-ai').text('');
        const $btn = $('#btn-ai-parse');
        $btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin"></i> 解析中...');
        $('#ai-parse-result').hide();

        $.ajax({
            method: 'POST',
            url: '/admin/task/api/parse-schedule',
            contentType: 'application/json',
            data: JSON.stringify({ text }),
        }).then(res => {
            if (res.code === 200 && res.data) {
                const d = typeof res.data === 'string' ? JSON.parse(res.data) : res.data;
                $('#ai-result-human').text(d.human || cronToHuman(d.cronExpression) || '');
                $('#ai-result-cron').text(d.cronExpression || '');
                state.aiResultCron = d.cronExpression || '';
                $('#ai-parse-result').show();
            } else {
                $('#e-ai').text('解析失败，请尝试重新描述');
            }
        }).fail(xhr => {
            $('#e-ai').text(xhr.responseJSON?.message || '解析服务异常，请稍后重试');
        }).always(() => {
            $btn.prop('disabled', false).html('<i class="fa-solid fa-magic-wand-sparkles"></i> 智能解析');
        });
    }

    function applyAiResult() {
        if (!state.aiResultCron) return;
        switchTaskType('recurring');
        parseCronToUI(state.aiResultCron);
        toast('配置已应用', 'success');
    }

    // ================================================================
    //  执行日志模态框（含分页）
    // ================================================================
    function openLogs(taskId, taskName) {
        state.logTaskId   = taskId;
        state.logPage     = 1;
        state.logTotal    = 0;
        $('#log-modal-title').text(`执行日志 — ${taskName}`);
        $('#log-modal-overlay').addClass('open');
        loadLogPage(1);
    }

    function loadLogPage(page) {
        state.logPage = page;
        state.logOutputMap = {};
        $('#log-table-body').html('<tr><td colspan="6" style="text-align:center;padding:24px;color:#b0b5cc;">加载中...</td></tr>');
        $('#log-pagination-btns').empty();
        $('#log-pagination-info').text('');

        request('GET', `${BASE}/${state.logTaskId}/logs?page=${page}&pageSize=${state.logPageSize}`).then(res => {            state.logTotal = res.total;
            const totalPages = Math.max(1, Math.ceil(res.total / state.logPageSize));

            // 分页信息
            const start = res.total ? (page - 1) * state.logPageSize + 1 : 0;
            const end   = Math.min(page * state.logPageSize, res.total);
            $('#log-pagination-info').text(res.total > 0 ? `第 ${start}–${end} 条，共 ${res.total} 条` : '暂无日志');

            // 分页按钮
            const $btns = $('#log-pagination-btns').empty();
            const addBtn = (label, p, disabled = false, active = false) => {
                const cls = `page-btn${active ? ' active' : ''}`;
                const btn = $(`<button class="${cls}" ${disabled ? 'disabled' : ''}>${label}</button>`);
                if (!disabled) btn.on('click', () => loadLogPage(p));
                $btns.append(btn);
            };
            addBtn('<i class="fa-solid fa-chevron-left"></i>', page - 1, page === 1);
            const startP = Math.max(1, page - 2);
            const endP   = Math.min(totalPages, page + 2);
            for (let p = startP; p <= endP; p++) addBtn(p, p, false, p === page);
            addBtn('<i class="fa-solid fa-chevron-right"></i>', page + 1, page >= totalPages);

            // 日志行
            if (!res.items.length) {
                $('#log-table-body').html('<tr><td colspan="6" style="text-align:center;padding:24px;color:#b0b5cc;">暂无日志</td></tr>');
                return;
            }
            const rows = res.items.map(l => {
                state.logOutputMap[l.id] = l.output || '';
                return `
                <tr>
                    <td class="log-col-status"><span class="status-badge ${l.status}">${statusLabel(l.status)}</span></td>
                    <td class="log-col-started" style="font-size:12px;">${l.startedAt}</td>
                    <td style="font-size:12px;">${l.executionMs != null ? l.executionMs + ' ms' : '-'}</td>
                    <td class="log-col-memory" style="font-size:12px;">${l.memoryPeak || '-'}</td>
                    <td style="font-size:12px;">${escHtml(l.hostName || '-')}</td>
                    <td class="log-col-output">${l.output ? `<button type="button" class="btn btn-default log-output-view-btn" onclick="openLogOutputById('${l.id}')">查看</button>` : '<span style="color:#b0b5cc;">-</span>'}</td>
                </tr>
            `;
            });
            $('#log-table-body').html(rows.join(''));
        }).fail((xhr) => {
            const msg = xhr.responseJSON?.message || '加载失败，请稍后重试';
            $('#log-table-body').html(`<tr><td colspan="6" style="text-align:center;padding:24px;color:#ef4444;"><i class="fa-solid fa-circle-exclamation" style="margin-right:6px;"></i>${escHtml(msg)}</td></tr>`);
            $('#log-pagination-info').text('');
            $('#log-pagination-btns').empty();
        });
    }

    function closeLogModal() {
        $('#log-modal-overlay').removeClass('open');
    }

    function openLogOutputById(logId) {
        const output = state.logOutputMap[logId] || '';
        $('#log-output-modal-content').text(output || '-');
        $('#log-output-modal-overlay').addClass('open');
    }

    function closeLogOutputModal() {
        $('#log-output-modal-overlay').removeClass('open');
    }

    // ================================================================
    //  视图切换
    // ================================================================
    function switchView(view) {
        state.view = view;

        // 更新 URL hash，支持直接访问和浏览器前进/后退
        if (location.hash !== '#' + view) {
            history.pushState(null, '', '#' + view);
        }

        $('#tab-list, #tab-calendar, #tab-week, #tab-day').removeClass('active');
        $('#task-list-view, #task-calendar-view, #task-week-view, #task-day-view').removeClass('active').hide();
        
        $(`#tab-${view}`).addClass('active');

        if (view === 'list') {
            $('#task-list-view').show();
            $('#task-pagination').show();
            loadTasks();
        } else if (view === 'calendar') {
            // 从 week/day 视图切换时同步月份
            if (state.calDate) {
                state.calYear = state.calDate.getFullYear();
                state.calMonth = state.calDate.getMonth() + 1;
            }
            $('#task-calendar-view').addClass('active').show();
            $('#task-pagination').hide();
            renderCalendar();
        } else if (view === 'week') {
            $('#task-week-view').addClass('active').css('display', 'flex');
            $('#task-pagination').hide();
            renderWeek();
        } else if (view === 'day') {
            $('#task-day-view').addClass('active').css('display', 'flex');
            $('#task-pagination').hide();
            renderDay();
        }
    }

    // ================================================================
    //  日历视图
    // ================================================================
    function renderCalendar() {
        const { calYear: y, calMonth: m } = state;
        const formatStr = "{{ 'admin.task.month_format'|trans({}, 'messages')|default('%year%年%month%月') }}";
        $('#cal-title').text(formatStr.replace('%year%', y).replace('%month%', m));

        request('GET', `${BASE}/calendar?year=${y}&month=${m}`).then(res => {
            buildCalendarGrid(y, m, res.tasks || [], res.stats || {}, res.events || []);
        });
    }

    function buildCalendarGrid(year, month, tasks, statMap, plannedEvents) {
        const plannedMap = {};
        (plannedEvents || []).forEach(ev => {
            if (!ev || !ev.date) return;
            if (!plannedMap[ev.date]) plannedMap[ev.date] = [];
            plannedMap[ev.date].push(ev);
        });

        const taskMap = {};
        (tasks || []).forEach(t => {
            if (t && t.id) taskMap[t.id] = t;
        });

        const firstDay = new Date(year, month - 1, 1);
        const lastDay  = new Date(year, month, 0);
        let startDow = firstDay.getDay(); // 0=Sun
        startDow = startDow === 0 ? 6 : startDow - 1; // Mon=0

        const cells = [];
        for (let i = startDow - 1; i >= 0; i--) {
            const d = new Date(firstDay);
            d.setDate(d.getDate() - i - 1);
            cells.push({ date: d, otherMonth: true });
        }

        for (let d = 1; d <= lastDay.getDate(); d++) {
            cells.push({ date: new Date(year, month - 1, d), otherMonth: false });
        }

        const rows = Math.ceil(cells.length / 7);
        while (cells.length < rows * 7) {
            const tail = cells[cells.length - 1].date;
            const next = new Date(tail);
            next.setDate(next.getDate() + 1);
            cells.push({ date: next, otherMonth: true });
        }

        const today = new Date();
        const todayStr = `${today.getFullYear()}-${String(today.getMonth()+1).padStart(2,'0')}-${String(today.getDate()).padStart(2,'0')}`;

        let html = '';
        const MAX_VISIBLE = 3;

        cells.forEach(cell => {
            const d = cell.date;
            const dateStr = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
            const isToday = dateStr === todayStr;
            const cls = `cal-day-cell${cell.otherMonth ? ' other-month' : ''}${isToday ? ' today' : ''}`;

            const plannedForDate = (plannedMap[dateStr] || []).map(ev => {
                const statKey = ev.taskId + '_' + dateStr;
                const stat = statMap[statKey];
                let status = 'pending';
                if (stat) {
                    if (stat.error) status = 'error';
                    else if (stat.success) status = 'success';
                }
                return { ...ev, status };
            });

            const merged = plannedForDate;
            html += `<div class="${cls}">`;
            html += `<div class="cal-day-num">${d.getDate()}</div>`;
            html += '<div class="cal-day-events">';

            merged.slice(0, MAX_VISIBLE).forEach(item => {
                const tip = buildTaskTipText({
                    name: item.name,
                    category: item.category,
                    status: item.status,
                    date: dateStr,
                    time: item.time || '',
                });
                html += `<div class="cal-event-item ${catClass(item.category)}" title="${escHtml(tip)}">
                    <span class="event-dot"></span>
                    <span style="overflow:hidden;text-overflow:ellipsis;">${escHtml(item.name)}</span>
                </div>`;
            });

            if (merged.length > MAX_VISIBLE) {
                html += `<div class="cal-event-more">+${merged.length - MAX_VISIBLE} 更多</div>`;
            }

            html += '</div>';
            html += '</div>';
        });

        $('#calendar-grid').html(html);
    }

    function calNav(delta) {
        state.calMonth += delta;
        if (state.calMonth > 12) { state.calMonth = 1;  state.calYear++; }
        if (state.calMonth < 1)  { state.calMonth = 12; state.calYear--; }
        renderCalendar();
    }

    function calGoToday() {
        state.calYear  = new Date().getFullYear();
        state.calMonth = new Date().getMonth() + 1;
        renderCalendar();
    }

    // ================================================================
    //  通用构建 TimeGrid
    // ================================================================
    function buildTimeGrid($container, dates, tasks, statMap, plannedEvents) {
        $container.empty();

        const plannedByDate = {};
        (plannedEvents || []).forEach(ev => {
            if (!ev || !ev.date) return;
            if (!plannedByDate[ev.date]) plannedByDate[ev.date] = [];
            plannedByDate[ev.date].push(ev);
        });

        // 1. 头栏: 左侧空列 + 右侧日期列
        const $head = $('<div class="fc-head"></div>');
        $head.append('<div class="fc-time-col-head"></div>');
        const $dayColsHead = $('<div class="fc-day-cols"></div>');
        
        const weekDays = ['日', '一', '二', '三', '四', '五', '六'];
        const todayStrLocal = new Date().toDateString();

        dates.forEach(d => {
            const isToday = d.toDateString() === todayStrLocal;
            const $dayCol = $(`<div class="fc-day-col-head${isToday ? ' fc-today' : ''}">
                <a style="font-size:11px;font-weight:500;">周${weekDays[d.getDay()]}</a>
                <a style="font-size:18px;line-height:1.2;">${d.getDate()}</a>
            </div>`);
            $dayColsHead.append($dayCol);
        });
        $head.append($dayColsHead);
        $container.append($head);

        // 2. All Day 行
        const $allDayRow = $('<div class="fc-all-day-row"></div>');
        $allDayRow.append('<div class="fc-all-day-label">全天</div>');
        const $allDayContent = $('<div class="fc-all-day-content"></div>');
        dates.forEach((d, i) => {
            const isToday = d.toDateString() === todayStrLocal;
            $allDayContent.append(`<div class="fc-all-day-cell${isToday ? ' fc-today' : ''}" id="fc-all-day-col-${i}"></div>`);
        });
        $allDayRow.append($allDayContent);
        $container.append($allDayRow);

        // 3. Body: 时间列 + 日期列
        const $body = $('<div class="fc-body"></div>');
        const $timeCol = $('<div class="fc-time-col"></div>');
        for (let hour = 0; hour < 24; hour++) {
            const ampm = hour < 12 ? 'am' : 'pm';
            let labelHour = hour % 12;
            if (labelHour === 0) labelHour = 12;
            const label = labelHour + ampm;
            $timeCol.append(`<div class="fc-time-slot">${label}</div>`);
        }
        $body.append($timeCol);

        const $dayColsBody = $('<div class="fc-day-cols-body"></div>');
        dates.forEach((d, i) => {
            const isToday = d.toDateString() === todayStrLocal;
            const $dayCol = $(`<div class="fc-day-col${isToday ? ' fc-today' : ''}"></div>`);
            
            // 背景格子线
            const $bgGrid = $('<div class="fc-day-grid-bg"></div>');
            for (let hour = 0; hour < 24; hour++) {
                $bgGrid.append('<div class="fc-bg-slot"></div>');
            }
            $dayCol.append($bgGrid);
            
            // 放置事件的容器
            // id: fc-col-<index>
            const $eventsContainer = $(`<div class="fc-events-container" id="fc-col-${i}"></div>`);
            $dayCol.append($eventsContainer);
            
            $dayColsBody.append($dayCol);
        });
        $body.append($dayColsBody);
        $container.append($body);

        // 4. 填充数据
        dates.forEach((date, i) => {
            const y = date.getFullYear();
            const m = String(date.getMonth() + 1).padStart(2, '0');
            const dStr = String(date.getDate()).padStart(2, '0');
            const dateStr = `${y}-${m}-${dStr}`;

            // 只显示计划事件，用 statMap 更新执行状态
            const dayEvents = (plannedByDate[dateStr] || []).map(ev => {
                const rawTime = ev.time || '00:00';
                const time = rawTime.length <= 5 ? rawTime : rawTime.substring(0, 5);
                const statKey = ev.taskId + '_' + dateStr;
                const stat = statMap[statKey];
                let status = 'pending';
                if (stat) {
                    if (stat.error) status = 'error';
                    else if (stat.success) status = 'success';
                }
                return {
                    name: ev.name,
                    category: ev.category,
                    status,
                    time,
                };
            });
            dayEvents.sort((a, b) => (a.time || '').localeCompare(b.time || ''));
            const renderedKey = new Set();
            const laneCountByMinute = {};

            dayEvents.forEach(ev => {
                const timePart = ev.time || '00:00:00';
                const [hh, mm] = timePart.split(':');
                const targetHour = parseInt(hh || '0', 10);
                const targetMinute = parseInt(mm || '0', 10);
                const uniq = `${ev.name}|${targetHour}|${targetMinute}|${ev.status}`;
                if (renderedKey.has(uniq)) return;
                renderedKey.add(uniq);

                if (Number.isNaN(targetHour) || targetHour < 0 || targetHour > 23) {
                    const statusDot = ev.status === 'error' ? '🔴' : (ev.status === 'success' ? '🟢' : '🔵');
                    $container.find(`#fc-all-day-col-${i}`).append(`
                        <div class="cal-event-item ${catClass(ev.category)}" title="${escHtml(ev.name)}" style="padding:2px 4px; border-radius:4px; font-size:10px;">
                            ${statusDot} ${escHtml(ev.name)}
                        </div>
                    `);
                    return;
                }

                const SLOT_HEIGHT = 60;
                const top = targetHour * SLOT_HEIGHT + (targetMinute / 60) * SLOT_HEIGHT;
                const topPercent = (top / (24 * SLOT_HEIGHT)) * 100;
                const eventHeight = 40;
                const cc = catClass(ev.category);
                const titleStr = escHtml(ev.name);
                const timeLabel = `${String(targetHour).padStart(2,'0')}:${String(targetMinute).padStart(2,'0')}`;
                const minuteKey = `${targetHour}:${targetMinute}`;
                const lane = laneCountByMinute[minuteKey] || 0;
                laneCountByMinute[minuteKey] = lane + 1;
                const leftPx = 4 + Math.min(lane, 5) * 8;
                const rightPx = 4;
                const zIndex = 5 + lane;

                const eventEl = $(`
                    <div class="fc-event ${cc}" style="top: ${topPercent}%; height: ${eventHeight}px; left:${leftPx}px; right:${rightPx}px; z-index:${zIndex};" title="${titleStr} [${statusLabel(ev.status)}] ${timeLabel}">
                        <div class="fc-event-time">${timeLabel}</div>
                        <div class="fc-event-title">${titleStr}</div>
                    </div>
                `);
                $container.find(`#fc-col-${i}`).append(eventEl);
            });
        });
    }
    // ================================================================
    //  时间网格自动滚动
    // ================================================================
    function autoScrollTimeGrid($grid, dates, opts = {}) {
        const options = { autoScrollToNow: true, ...opts };
        const el = $grid[0];
        if (!el) return;

        const GRID_FULL_HEIGHT = 24 * 60; // 24小时 × 60px = 1440px

        const tryScroll = (retries) => {
            // 等待容器有高度且内容已溢出（scrollHeight > clientHeight）
            if ((el.clientHeight === 0 || el.scrollHeight <= el.clientHeight) && retries < 10) {
                setTimeout(() => tryScroll(retries + 1), 50);
                return;
            }
            const todayStrLocal = new Date().toDateString();
            const hasToday = dates.some(d => d.toDateString() === todayStrLocal);
            const maxScroll = Math.max(0, el.scrollHeight - el.clientHeight);

            if (hasToday && options.autoScrollToNow) {
                const currentHour = new Date().getHours();
                $grid.scrollTop(Math.min(maxScroll, Math.max(0, currentHour * 60 - 60)));
            } else {
                // 根据第一个事件的 CSS top 百分比计算滚动位置
                const allEvents = el.querySelectorAll('.fc-event');
                let targetScroll = 8 * 60; // 默认 08:00
                if (allEvents.length > 0) {
                    const topPct = parseFloat(allEvents[0].style.top) || 0;
                    const topPx = (topPct / 100) * GRID_FULL_HEIGHT;
                    targetScroll = Math.max(0, Math.floor(topPx) - 60);
                }
                // 如果 scrollHeight 未就绪，直接用计算值
                const effectiveMax = maxScroll > 0 ? maxScroll : GRID_FULL_HEIGHT - el.clientHeight;
                $grid.scrollTop(Math.min(effectiveMax, targetScroll));
            }
        };
        // 延迟执行，确保浏览器完成布局
        setTimeout(() => tryScroll(0), 100);
    }

    // ================================================================
    //  周视图
    // ================================================================
    function renderWeek() {
        if (!state.calDate) state.calDate = new Date();
        const date = new Date(state.calDate);
        
        // 找到本周日 (Fullcalendar 周日开头或周一开头，这里用周日开头比较常见，但要求说 Mon-Sun 也行，咱们按之前周一开头就好)
        const day = date.getDay();
        const diff = date.getDate() - day + (day == 0 ? -6 : 1);
        const monday = new Date(date.setDate(diff));
        monday.setHours(0, 0, 0, 0);

        let weekDates = [];
        for (let i = 0; i < 7; i++) {
            let nextDay = new Date(monday);
            nextDay.setDate(monday.getDate() + i);
            weekDates.push(nextDay);
        }

        const year = monday.getFullYear();
        const month = monday.getMonth() + 1;
        
        function getWeekNumber(d) {
            d = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
            d.setUTCDate(d.getUTCDate() + 4 - (d.getUTCDay() || 7));
            var yearStart = new Date(Date.UTC(d.getUTCFullYear(), 0, 1));
            return Math.ceil((((d - yearStart) / 86400000) + 1)/7);
        }

        const formatStr = "{{ 'admin.task.week_format'|trans({}, 'messages')|default('%year%年%month%月 第%week%周') }}";
        $('#week-title').text(formatStr.replace('%year%', year).replace('%month%', month).replace('%week%', getWeekNumber(monday)));

        const from = `${weekDates[0].getFullYear()}-${String(weekDates[0].getMonth() + 1).padStart(2, '0')}-${String(weekDates[0].getDate()).padStart(2, '0')} 00:00:00`;
        const endDate = weekDates[6];
        const to = `${endDate.getFullYear()}-${String(endDate.getMonth() + 1).padStart(2, '0')}-${String(endDate.getDate()).padStart(2, '0')} 23:59:59`;

        request('GET', `${BASE}/calendar?from=${encodeURIComponent(from)}&to=${encodeURIComponent(to)}`).then(res => {
            const { tasks, stats, events } = res;
            buildTimeGrid($('#week-grid'), weekDates, tasks || [], stats || {}, events || []);
            autoScrollTimeGrid($('#week-grid'), weekDates);
        });
    }

    function weekNav(delta) {
        if (!state.calDate) state.calDate = new Date();
        const d = new Date(state.calDate);
        d.setDate(d.getDate() + (delta * 7));
        state.calDate = d;
        renderWeek();
    }

    function weekGoToday() {
        state.calDate = new Date();
        renderWeek();
    }

    // ================================================================
    //  天视图
    // ================================================================
    function renderDay() {
        if (!state.calDate) state.calDate = new Date();
        const d = state.calDate;
        
        const y = d.getFullYear();
        const m = d.getMonth() + 1;
        const dt = d.getDate();
        
        const formatStr = "{{ 'admin.task.day_format'|trans({}, 'messages')|default('%year%年%month%月%day%日') }}";
        $('#day-title').text(formatStr.replace('%year%', y).replace('%month%', m).replace('%day%', dt));

        const from = `${y}-${String(m).padStart(2, '0')}-${String(dt).padStart(2, '0')} 00:00:00`;
        const to = `${y}-${String(m).padStart(2, '0')}-${String(dt).padStart(2, '0')} 23:59:59`;

        request('GET', `${BASE}/calendar?from=${encodeURIComponent(from)}&to=${encodeURIComponent(to)}`).then(res => {
            const { tasks, stats, events } = res;
            buildTimeGrid($('#day-timeline'), [new Date(d)], tasks || [], stats || {}, events || []);
            autoScrollTimeGrid($('#day-timeline'), [new Date(d)]);
        });
    }

    function dayNav(delta) {
        if (!state.calDate) state.calDate = new Date();
        const d = new Date(state.calDate);
        d.setDate(d.getDate() + delta);
        state.calDate = d;
        renderDay();
    }

    function dayGoToday() {
        state.calDate = new Date();
        renderDay();
    }

    // ================================================================
    //  工具函数
    // ================================================================
    function statusLabel(s) {
        return { success: '成功', error: '失败', running: '执行中', pending: '计划中', none: '未执行' }[s] || s;
    }

    function buildTaskTipText(item) {
        const lines = [];
        lines.push(`任务: ${item.name || '-'}`);
        lines.push(`状态: ${statusLabel(item.status || 'none')}`);
        lines.push(`分类: ${catLabel(item.category)}`);
        if (item.date) {
            const timePart = item.time ? ` ${item.time.slice(0, 5)}` : '';
            lines.push(`时间: ${item.date}${timePart}`);
        }
        return lines.join('\n');
    }

    function escHtml(str) {
        if (!str) return '';
        return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function shortHandler(h) {
        if (!h) return '';
        const parts = h.split('\\');
        return parts[parts.length - 1];
    }

    function debounceSearch() {
        clearTimeout(state.searchTimer);
        state.page = 1;
        state.searchTimer = setTimeout(loadTasks, 400);
    }

    function setCron(expr) {
        $('#f-cron').val(expr);
        updateCronDesc(expr);
    }

    // ================================================================
    //  初始化
    // ================================================================
    function init() {
        loadStats(); // 统计卡片 + 分类下拉，合并为一次请求

        // 根据 URL hash 确定初始视图（支持直接访问 /admin/task/#week 等）
        const validViews = ['list', 'calendar', 'week', 'day'];
        const hashView = (location.hash || '').replace('#', '');
        const initialView = validViews.includes(hashView) ? hashView : 'list';
        switchView(initialView);

        // 初始化 Cron 构建器（默认"每隔N秒"）
        switchCronPeriod('second');

        // 监听浏览器前进/后退按钮
        window.addEventListener('hashchange', function() {
            const newView = (location.hash || '').replace('#', '');
            if (validViews.includes(newView) && newView !== state.view) {
                switchView(newView);
            }
        });
    }

    // 暴露给模板 onclick 使用
    return {
        init,
        loadTasks,
        debounceSearch,
        switchView,
        openCreateDrawer,
        openEditDrawer,
        closeDrawer,
        submitTask,
        toggleTask,
        runNow,
        deleteTask,
        openLogs,
        openLogOutputById,
        closeLogOutputModal,
        closeLogModal,
        calNav,
        calGoToday,
        weekNav,
        weekGoToday,
        dayNav,
        dayGoToday,
        setCron,
        switchTaskType,
        switchCronPeriod,
        buildCronFromUI,
        toggleWeekDay,
        toggleMonthDayInput,
        parseAiSchedule,
        applyAiResult,
        loadLogPage,
        cronToHuman,
    };

})(jQuery);

// 全局代理函数（供 HTML onclick 调用）
function switchView(v)         { TaskMgr.switchView(v); }
function openCreateDrawer()    { TaskMgr.openCreateDrawer(); }
function openEditDrawer(id)    { TaskMgr.openEditDrawer(id); }
function closeDrawer()         { TaskMgr.closeDrawer(); }
function submitTask()          { TaskMgr.submitTask(); }
function toggleTask(id, el)    { TaskMgr.toggleTask(id, el); }
function runNow(id, name)      { TaskMgr.runNow(id, name); }
function deleteTask(id, name)  { TaskMgr.deleteTask(id, name); }
function openLogs(id, name)    { TaskMgr.openLogs(id, name); }
function openLogOutputById(id)  { TaskMgr.openLogOutputById(id); }
function closeLogOutputModal()  { TaskMgr.closeLogOutputModal(); }
function closeLogModal()       { TaskMgr.closeLogModal(); }
function calNav(d)             { TaskMgr.calNav(d); }
function calGoToday()          { TaskMgr.calGoToday(); }
function weekNav(d)            { TaskMgr.weekNav(d); }
function weekGoToday()         { TaskMgr.weekGoToday(); }
function dayNav(d)             { TaskMgr.dayNav(d); }
function dayGoToday()          { TaskMgr.dayGoToday(); }
function setCron(e)            { TaskMgr.setCron(e); }
function debounceSearch()      { TaskMgr.debounceSearch(); }
function loadTasks()           { TaskMgr.loadTasks(); }
function switchTaskType(t)     { TaskMgr.switchTaskType(t); }
function switchCronPeriod(p)   { TaskMgr.switchCronPeriod(p); }
function buildCronFromUI()     { TaskMgr.buildCronFromUI(); }
function toggleWeekDay(btn)    { TaskMgr.toggleWeekDay(btn); }
function toggleMonthDayInput() { TaskMgr.toggleMonthDayInput(); }
function parseAiSchedule()     { TaskMgr.parseAiSchedule(); }
function applyAiResult()       { TaskMgr.applyAiResult(); }

$(document).ready(function() {
    TaskMgr.init();
});
</script>
{% endblock %}
