    function resetForm() {
        $('#task-id').val('');
        $('#f-name').val('');
        $('#f-description').val('');
        $('#f-cron').val('');
        $('#f-handler').val('');
        $('#f-payload').val('{}');
        $('#f-category').val('');
        $('#f-sort').val('0');
        $('#f-retries').val('3');
        $('#f-timeout').val('0');
        $('#f-enabled').attr('aria-checked', 'true').addClass('ef-switch-checked');
