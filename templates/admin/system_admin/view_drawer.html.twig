<link rel="stylesheet" href="{{ asset('sunui/components/position-drawer.css') }}">
<div class="ef-drawer-container" style="z-index: 1001; display: none;" id="{{ drawerId }}">
    <div class="ef-drawer-mask" maskid="{{ drawerId }}"></div>
    <div class="ef-drawer" style="right: -650px; width: 650px; box-shadow: -4px 0 20px rgba(0,0,0,0.15);">
        <div class="ef-drawer-header">
            <div class="ef-drawer-title">
                <i class="fa-solid fa-user-shield" style="margin-right: 12px; font-size: 18px;"></i>
                {{ admin.name }}
                <span style="font-size: 14px; font-weight: 400; margin-left: 8px; opacity: 0.8;">{{ "sysAdminView.1"|trans }}</span>
            </div>
            <div tabindex="-1" role="button" aria-label="Close" class="ef-drawer-close-btn">
                <span class="ef-icon-hover">
                    <svg viewbox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" class="ef-icon ef-icon-close" stroke-width="4" stroke-linecap="butt" stroke-linejoin="miter">
                        <path d="M9.857 9.858 24 24m0 0 14.142 14.142M24 24 38.142 9.858M24 24 9.857 38.142"></path>
                    </svg>
                </span>
            </div>
        </div>
        <div class="ef-drawer-body">
            <div class="ef-drawer-content">
                <div class="ef-section">
                    <div class="ef-section-header">
                        <i class="fa-solid fa-info-circle"></i>
                        <span>{{ "sysAdminView.2"|trans }}</span>
                    </div>
                    <div class="ef-detail-view ef-detail-two-columns">
                        <div class="ef-detail-row-group">
                            <div class="ef-detail-item">
                                <div class="ef-detail-label">{{ "sysAdminView.3"|trans }}</div>
                                <div class="ef-detail-value">{{ admin.username }}</div>
                            </div>
                            <div class="ef-detail-item">
                                <div class="ef-detail-label">{{ "sysAdminView.4"|trans }}</div>
                                <div class="ef-detail-value">{{ admin.name }}</div>
                            </div>
                        </div>
                        <div class="ef-detail-row-group">
                            <div class="ef-detail-item">
                                <div class="ef-detail-label">{{ "sysAdminView.5"|trans }}</div>
                                <div class="ef-detail-value">{{ admin.email }}</div>
                            </div>
                            <div class="ef-detail-item">
                                <div class="ef-detail-label">{{ "sysAdminView.6"|trans }}</div>
                                <div class="ef-detail-value">{{ admin.mobile ?: '-' }}</div>
                            </div>
                        </div>
                        <div class="ef-detail-row-group">
                            <div class="ef-detail-item">
                                <div class="ef-detail-label">{{ "sysAdminView.7"|trans }}</div>
                                <div class="ef-detail-value">{{ admin.employeeNo ?: '-' }}</div>
                            </div>
                            <div class="ef-detail-item">
                                <div class="ef-detail-label">{{ "sysAdminView.8"|trans }}</div>
                                <div class="ef-detail-value">
                                    {% for role in admin.roles %}
                                        <span class="badge badge-info">{{ role }}</span>
                                    {% else %}
                                        -
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                        <div class="ef-detail-row-group">
                            <div class="ef-detail-item">
                                <div class="ef-detail-label">{{ "sysAdminView.9"|trans }}</div>
                                <div class="ef-detail-value">
                                    {% if admin.isActive %}
                                        <span class="badge badge-success">{{ "sysAdminView.10"|trans }}</span>
                                    {% else %}
                                        <span class="badge badge-danger">{{ "sysAdminView.11"|trans }}</span>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="ef-detail-item">
                                <div class="ef-detail-label">{{ "sysAdminView.12"|trans }}</div>
                                <div class="ef-detail-value">{{ admin.lastLoginAt ? admin.lastLoginAt|date('Y-m-d H:i:s') : '-' }}</div>
                            </div>
                        </div>
                        <div class="ef-detail-row-group">
                            <div class="ef-detail-item">
                                <div class="ef-detail-label">{{ "sysAdminView.13"|trans }}</div>
                                <div class="ef-detail-value">{{ admin.createdAt ? admin.createdAt|date('Y-m-d H:i:s') : '-' }}</div>
                            </div>
                            <div class="ef-detail-item">
                                <div class="ef-detail-label">{{ "sysAdminView.14"|trans }}</div>
                                <div class="ef-detail-value">{{ admin.updatedAt ? admin.updatedAt|date('Y-m-d H:i:s') : '-' }}</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
