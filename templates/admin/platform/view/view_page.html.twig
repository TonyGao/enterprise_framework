{% extends "admin/layout.html.twig" %}

{% block app_content_container %}
	<div class="view-page-container" style="padding: 24px; background: #f2f3f5; min-height: 100%;">
		<div style="max-width: 1200px; margin: 0 auto;">
			<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
				<div style="font-size: 18px; font-weight: 700; color: #1e293b;">{{ viewName }}</div>
				<a href="javascript:history.back()" class="btn secondary small" style="text-decoration: none;">{{ "viewPage.1"|trans }}</a>
			</div>
			{{ content|raw }}
		</div>
	</div>
{% endblock %}
