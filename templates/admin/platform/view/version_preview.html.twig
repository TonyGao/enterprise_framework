<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>预览 {{ viewName }} · v{{ version }}</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      padding: 16px;
      background: #eef1f5;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'PingFang SC', sans-serif;
    }
    .preview-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      max-width: 1100px;
      margin: 0 auto 12px;
      font-size: 12px;
      color: #64748b;
    }
    .preview-head strong { color: #0f172a; font-size: 13px; }
    .preview-frame {
      max-width: 1100px;
      margin: 0 auto;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 24px;
      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.08);
    }
    .preview-empty {
      text-align: center;
      padding: 48px 0;
      color: #94a3b8;
      font-size: 13px;
    }
  </style>
</head>
<body>
  <div class="preview-head">
    <span><strong>{{ viewName }}</strong> · 版本 {{ version }} 预览</span>
    <span>（用于切换前查看效果）</span>
  </div>
  <div class="preview-frame">
    {% if found and content is not empty %}
      {{ content|raw }}
    {% else %}
      <div class="preview-empty">
        <i class="fa-regular fa-eye" style="font-size: 28px; display:block; margin-bottom: 8px;"></i>
        该版本暂无内容
      </div>
    {% endif %}
  </div>
</body>
</html>
