{% import 'ui/template/ui.html.twig' as ui %}
<div class="view-detail-container">
  <div class="view-detail-header">
    <div class="view-detail-title-row">
      <div class="view-detail-icon"><i class="fa-regular fa-eye"></i></div>
      <div class="view-detail-title">
        <h2>{{ view.label|default(view.name) }}</h2>
        <span class="view-detail-meta">{{ view.name }}</span>
        {% if view.builtIn %}
          <span class="ef-tag ef-tag-blue ef-tag-small" style="margin-left: 8px;">{{ "viewDetail.3"|trans }}</span>
        {% else %}
          <span class="ef-tag ef-tag-default ef-tag-small" style="margin-left: 8px;">{{ "viewDetail.4"|trans }}</span>
        {% endif %}
        <span class="view-detail-version-badge" id="view-detail-current-version" title="{{ "viewDetail.1"|trans }}">v{{ currentVersion|default('1_0') }}</span>
      </div>
      <button type="button" class="btn outline primary small" id="btn-toggle-versions" style="margin-left: auto; flex-shrink: 0;">
        <i class="fa-solid fa-code-branch"></i> {{ "viewDetail.5"|trans }}
        <i class="fa-solid fa-chevron-down" id="version-toggle-arrow" style="margin-left: 2px;"></i>
      </button>
    </div>
  </div>

  <div class="view-detail-info-cards">
    <div class="view-detail-card">
      <div class="view-detail-card-header">
        <i class="fa-solid fa-info-circle"></i>
        {{ "viewDetail.6"|trans }}
      </div>
      <div class="view-detail-card-body">
        <table class="view-detail-info-table">
          <tr>
            <td class="info-label">{{ "viewDetail.7"|trans }}</td>
            <td class="info-value"><code>{{ view.name }}</code></td>
          </tr>
          <tr>
            <td class="info-label">{{ "viewDetail.8"|trans }}</td>
            <td class="info-value">{{ view.label|default('-') }}</td>
          </tr>
          <tr>
            <td class="info-label">{{ "viewDetail.9"|trans }}</td>
            <td class="info-value">{{ view.type }}</td>
          </tr>
          <tr>
            <td class="info-label">{{ "viewDetail.10"|trans }}</td>
            <td class="info-value">{{ view.template|default('-') }}</td>
          </tr>
          <tr>
            <td class="info-label">{{ "viewDetail.11"|trans }}</td>
            <td class="info-value"><code>{{ view.path|default('-') }}</code></td>
          </tr>
        </table>
      </div>
    </div>

    {% if view.formEntity %}
    <div class="view-detail-card">
      <div class="view-detail-card-header">
        <i class="fa-solid fa-database"></i>
        {{ "viewDetail.12"|trans }}
      </div>
      <div class="view-detail-card-body">
        <table class="view-detail-info-table">
          <tr>
            <td class="info-label">{{ "viewDetail.13"|trans }}</td>
            <td class="info-value">{{ view.formEntity.name }}</td>
          </tr>
          <tr>
            <td class="info-label">FQN</td>
            <td class="info-value"><code>{{ view.formEntity.fqn }}</code></td>
          </tr>
          <tr>
            <td class="info-label">{{ "viewDetail.14"|trans }}</td>
            <td class="info-value">{{ fields|length }}</td>
          </tr>
        </table>
      </div>
    </div>

    {% set sc = view.sectionConfig %}
    {% if sc is not empty %}
    <div class="view-detail-card">
      <div class="view-detail-card-header">
        <i class="fa-solid fa-layout"></i>
        {{ "viewDetail.15"|trans }}
      </div>
      <div class="view-detail-card-body">
        <table class="view-detail-info-table">
          <tr>
            <td class="info-label">{{ "viewDetail.16"|trans }}</td>
            <td class="info-value">{{ sc.contentWidth|default('100%') }}</td>
          </tr>
          {% if sc.contentWidth is defined and sc.contentWidth == 'boxed' %}
          <tr>
            <td class="info-label">{{ "viewDetail.17"|trans }}</td>
            <td class="info-value">{{ sc.width|default('auto') }}{{ sc.unit|default('px') }}</td>
          </tr>
          {% endif %}
        </table>
      </div>
    </div>
    {% endif %}
    {% endif %}

    <div class="view-detail-card view-version-card" style="display: none;">
      <div class="view-detail-card-header">
        <i class="fa-solid fa-code-branch"></i>
        {{ "viewDetail.5"|trans }}
        <span class="view-detail-count" id="version-count-badge"></span>
      </div>
      <div class="view-detail-card-body">
        <div id="version-list-container" style="min-height: 40px; color: #94a3b8; font-size: 13px;">{{ "viewDetail.18"|trans }}…</div>
        <div style="margin-top: 12px; display: flex; gap: 8px; align-items: center;">
          <button type="button" class="btn primary small" id="btn-new-version">
            <i class="fa-solid fa-plus"></i> {{ "viewDetail.19"|trans }}
          </button>
          <button type="button" class="btn secondary small" id="btn-version-tiles">
            <i class="fa-solid fa-table-cells-large"></i> {{ "viewDetail.20"|trans }}
          </button>
          <button type="button" class="btn secondary small" id="btn-open-trash">
            <i class="fa-solid fa-trash-can"></i> {{ "viewDetail.21"|trans }}
          </button>
          <span class="text-muted" style="font-size: 12px;" id="version-hint"></span>
        </div>
      </div>
    </div>
  </div>

  {% if fields is not empty %}
  <div class="view-detail-section">
    <div class="view-detail-section-header">
      <i class="fa-solid fa-list"></i>
      {{ "viewDetail.22"|trans }}
      <span class="view-detail-count">{{ fields|length }}</span>
    </div>
    <table class="ef-table view-field-table">
      <thead>
        <tr>
          <th style="width: 40px;">#</th>
          <th>{{ "viewDetail.23"|trans }}</th>
          <th>{{ "viewDetail.9"|trans }}</th>
          <th>{{ "viewDetail.8"|trans }}</th>
          <th>{{ "viewDetail.24"|trans }}</th>
          <th style="width: 180px;">{{ "viewDetail.25"|trans }}</th>
        </tr>
      </thead>
      <tbody>
        {% for field in fields %}
        {% set cfg = field.config %}
        <tr>
          <td class="text-muted">{{ loop.index }}</td>
          <td><code>{{ field.fieldName }}</code></td>
          <td>
            {% set typeIcons = {
              'string': 'fa-solid fa-font',
              'text': 'fa-solid fa-paragraph',
              'integer': 'fa-solid fa-hashtag',
              'boolean': 'fa-solid fa-toggle-on',
              'entity': 'fa-solid fa-link',
              'department': 'fa-solid fa-sitemap',
              'user': 'fa-solid fa-user',
            } %}
            <span class="field-type-badge">
              <i class="{{ typeIcons[field.fieldType]|default('fa-solid fa-question') }}"></i>
              {{ field.fieldType }}
            </span>
          </td>
          <td>{{ cfg.label|default(field.fieldLabel)|default('-') }}</td>
          <td>
            {% if cfg.required|default(false) %}
              <span class="ef-tag ef-tag-red ef-tag-small">{{ "viewDetail.24"|trans }}</span>
            {% else %}
              <span class="text-muted">-</span>
            {% endif %}
          </td>
          <td>
            {% set summary = [] %}
            {% if cfg.height is defined %}
              {% set summary = summary|merge([field.fieldType == 'text' ? cfg.height ~ 'viewDetail.row'|trans : cfg.height ~ 'px']) %}
            {% endif %}
            {% if cfg.rounded|default(true) == false %}
              {% set summary = summary|merge(['viewDetail.square'|trans]) %}
            {% endif %}
            {% if cfg.regularBg is defined and cfg.regularBg is not empty and cfg.regularBg|upper != '#FFFFFF' %}
              {% set summary = summary|merge(['viewDetail.bg'|trans]) %}
            {% endif %}
            {% if cfg.placeholder is defined and cfg.placeholder is not empty %}
              {% set summary = summary|merge(['viewDetail.placeholder'|trans]) %}
            {% endif %}
            <span class="config-summary">{{ summary|default(['默认'])|join(', ') }}</span>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
  <div class="view-detail-empty">
    <i class="fa-solid fa-inbox"></i>
    <p>{{ "viewDetail.26"|trans }}</p>
    {% if view.formEntity %}
    <p class="text-muted">{{ "viewDetail.27"|trans }}"{{ "viewDetail.28"|trans }}"{{ "viewDetail.29"|trans }}</p>
    {% endif %}
  </div>
  {% endif %}

  <div class="view-detail-actions">
    <a href="{{ path('platform_view_editor', {id: view.id}) }}" target="_blank" class="btn primary medium">
      <i class="fa-solid fa-pen-to-square"></i>
      {{ "viewDetail.30"|trans }}
    </a>
    {% if is_granted('ROLE_SYS_ADMIN') %}
    <button type="button" class="btn secondary medium" onclick="loadEditView('{{ view.id }}')">
      <i class="fa-solid fa-edit"></i>
      {{ "viewDetail.31"|trans }}
    </button>
    {% endif %}
    {% if not view.builtIn %}
    <button type="button" class="btn red medium" data-view-id="{{ view.id }}" data-delete-view style="margin-left: auto;">
      <i class="fa-solid fa-trash-can"></i>
      {{ "viewDetail.32"|trans }}
    </button>
    {% endif %}
  </div>
</div>

<!-- 删除确认弹窗 -->
<div class="ef-modal-container" id="deleteViewModal" style="z-index: 1001; display: none;">
  <div class="ef-modal-mask"></div>
  <div class="ef-modal-wrapper ef-modal-wrapper-align-center">
    <div class="ef-modal" style="width: 420px;">
      <div class="ef-modal-header">
        <div class="ef-modal-title ef-modal-title-align-left">{{ "viewDetail.33"|trans }}</div>
        <div tabindex="-1" role="button" aria-label="Close" class="ef-modal-close-btn" data-close-delete-modal>
          <span class="ef-icon-hover">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" class="ef-icon ef-icon-close" stroke-width="4" stroke-linecap="butt" stroke-linejoin="miter">
              <path d="M9.857 9.858 24 24m0 0 14.142 14.142M24 24 38.142 9.858M24 24 9.857 38.142"></path>
            </svg>
          </span>
        </div>
      </div>
      <div class="ef-modal-body">
        <div style="text-align: center; padding: 10px 0;">
          <div style="font-size: 48px; color: #faad14; margin-bottom: 16px;">
            <i class="fa-solid fa-triangle-exclamation"></i>
          </div>
          <div style="font-size: 16px; font-weight: 600; color: #1f2937; margin-bottom: 8px;">
            {{ "viewDetail.34"|trans }}「{{ view.label|default(view.name) }}」{{ "viewDetail.35"|trans }}
          </div>
          <div style="color: #dc2626; font-size: 13px;" id="delete-view-version-info">
            <i class="fa-solid fa-circle-exclamation"></i>
            {{ "viewDetail.36"|trans }}<strong>{{ "viewDetail.21"|trans }}</strong>{{ "viewDetail.37"|trans }}
          </div>
        </div>
      </div>
      <div class="ef-modal-footer">
        <button class="btn secondary small" type="button" data-close-delete-modal>{{ "viewDetail.38"|trans }}</button>
        <button class="btn red small" type="button" data-confirm-delete-view>
          <i class="fa-solid fa-trash-can"></i>
          {{ "viewDetail.39"|trans }}
        </button>
      </div>
    </div>
  </div>
</div>

<!-- 新增版本弹窗 -->
<div class="ef-modal-container" id="newVersionModal" style="z-index: 1002; display: none;">
  <div class="ef-modal-mask" data-close-new-version></div>
  <div class="ef-modal-wrapper ef-modal-wrapper-align-center">
    <div class="ef-modal" style="width: 480px;">
      <div class="ef-modal-header">
        <div class="ef-modal-title ef-modal-title-align-left"><i class="fa-solid fa-code-branch" style="margin-right: 8px; color:#6366f1;"></i> {{ "viewDetail.19"|trans }}</div>
        <div tabindex="-1" role="button" aria-label="Close" class="ef-modal-close-btn" data-close-new-version>
          <span class="ef-icon-hover">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" class="ef-icon ef-icon-close" stroke-width="4" stroke-linecap="butt" stroke-linejoin="miter"><path d="M9.857 9.858 24 24m0 0 14.142 14.142M24 24 38.142 9.858M24 24 9.857 38.142"></path></svg>
          </span>
        </div>
      </div>
      <div class="ef-modal-body" style="padding: 20px 24px;">
        <div style="margin-bottom: 20px;">
          <div class="ef-form-item-label" style="margin-bottom: 8px; font-weight: 600;">{{ "viewDetail.40"|trans }}</div>
          <div style="display: flex; gap: 24px;">
            <label class="nv-source-radio">
              <input type="radio" name="nv-source" value="current" checked>
              <span class="nv-source-dot"></span>
              <span class="nv-source-label">{{ "viewDetail.41"|trans }}</span>
            </label>
            <label class="nv-source-radio">
              <input type="radio" name="nv-source" value="blank">
              <span class="nv-source-dot"></span>
              <span class="nv-source-label">{{ "viewDetail.42"|trans }}</span>
            </label>
          </div>
        </div>
        <div style="margin-bottom: 20px;">
          <div class="ef-form-item-label" style="margin-bottom: 8px; font-weight: 600;">{{ "viewDetail.43"|trans }} <span style="color:#ef4444;">*</span></div>
          <div style="max-width: 240px;">
            {{ ui.input('nv-version', 'text', '如 1_1', '', '', '', '', {'style': 'width: 100%;'}) }}
          </div>
          <div style="font-size: 12px; color: #94a3b8; margin-top: 6px;">{{ "viewDetail.44"|trans }} → 1_1）</div>
          <div style="color:#ef4444; font-size:12px; display:none;" id="nv-version-error"></div>
        </div>
        <div>
          <div class="ef-form-item-label" style="margin-bottom: 8px; font-weight: 600;">{{ "viewDetail.45"|trans }}</div>
          {{ ui.textarea('nv-label', '如：春节活动版、改版优化说明…', 2, 4) }}
        </div>
      </div>
      <div class="ef-modal-footer">
        <button class="btn secondary small" type="button" data-close-new-version>{{ "viewDetail.38"|trans }}</button>
        <button class="btn primary small" type="button" id="nv-confirm"><i class="fa-solid fa-plus"></i> {{ "viewDetail.46"|trans }}</button>
      </div>
    </div>
  </div>
</div>

<!-- 重命名版本弹窗 -->
<div class="ef-modal-container" id="renameVersionModal" style="z-index: 1002; display: none;">
  <div class="ef-modal-mask" data-close-rename-version></div>
  <div class="ef-modal-wrapper ef-modal-wrapper-align-center">
    <div class="ef-modal" style="width: 420px;">
      <div class="ef-modal-header">
        <div class="ef-modal-title ef-modal-title-align-left"><i class="fa-solid fa-pen" style="margin-right: 8px; color:#6366f1;"></i> {{ "viewDetail.47"|trans }}</div>
        <div tabindex="-1" role="button" aria-label="Close" class="ef-modal-close-btn" data-close-rename-version>
          <span class="ef-icon-hover">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" class="ef-icon ef-icon-close" stroke-width="4" stroke-linecap="butt" stroke-linejoin="miter"><path d="M9.857 9.858 24 24m0 0 14.142 14.142M24 24 38.142 9.858M24 24 9.857 38.142"></path></svg>
          </span>
        </div>
      </div>
      <div class="ef-modal-body" style="padding: 20px 24px;">
        <div>
          <div class="ef-form-item-label" style="margin-bottom: 8px; font-weight: 600;">{{ "viewDetail.48"|trans }}</div>
          <input type="text" id="rv-label" class="ef-input" style="width: 100%; padding: 7px 10px; font-size: 13px; border: 1px solid #e2e8f0; border-radius: 6px; outline: none;" placeholder="{{ "viewDetail.2"|trans }}">
