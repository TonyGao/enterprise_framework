<script>
  window.__VIEW_ID__ = {{ id is defined ? id|json_encode|raw : 'null' }};
  window.__VIEW_NAME__ = {{ viewName is defined ? viewName|json_encode|raw : 'null' }};
  window.__VIEW_PATH__ = {{ viewPath is defined ? viewPath|json_encode|raw : 'null' }};
  window.__VIEW_DESIGN_PATH__ = {{ viewDesignPath is defined ? viewDesignPath|json_encode|raw : 'null' }};
  window.__SECTION_CONFIG__ = {{ sectionConfig is defined and sectionConfig ? sectionConfig|json_encode|raw : {contentWidth: '', width: 100, unit: '%'}|json_encode|raw }};
  window.__AI_CONTEXT__ = {
      name: 'view_editor',
      pageId: {{ id is defined ? id|json_encode|raw : 'null' }},
  };
  document.addEventListener('cssElementSelected', function(e) {
      var el = e.detail && e.detail.element;
      if (el) {
          var info = '<' + el.tagName.toLowerCase();
          if (el.id) info += '#' + el.id;
          var cls = (el.className || '').split(' ').filter(Boolean);
          if (cls.length) info += '.' + cls.join('.');
          info += '>';
          var style = el.getAttribute('style') || '';
          window.__AI_CONTEXT__._selectedElement = { tag: el.tagName.toLowerCase(), id: el.id || '', classes: cls, style: style, summary: info };
      }
  });
  document.addEventListener('cssElementDeselected', function() {
      delete window.__AI_CONTEXT__._selectedElement;
  });
</script>
{% if generalConfig is defined %}
<script>
  window.__GENERAL_CONFIG__ = {{ generalConfig|json_encode|raw }};
</script>
{% endif %}
