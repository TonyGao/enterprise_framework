{% extends 'admin/layout.html.twig' %}

{% block app_content_container %}
<div class="org-structure-container llm-config-page">
  <div class="outside-wrapper" style="padding: 40px 48px; max-width: 1280px; margin: 0; background: #fff; min-height: calc(100vh - 60px);">

    <div class="page-title-row" style="margin-bottom: 12px;">
      <h1>{{ "llmRoleForm.1"|trans }}{{ role.label }}</h1>
      <a href="{{ path('admin_llm_config_index') }}" class="back-link">
        <i class="fa-solid fa-arrow-left"></i> {{ "llmRoleForm.2"|trans }}
      </a>
    </div>

    {% set capabilityDescs = {
      'vision': 'llmRoleForm.desc_vision',
      'reasoning': 'llmRoleForm.desc_reasoning',
      'general': 'llmRoleForm.desc_general',
      'lightweight': 'llmRoleForm.desc_lightweight',
      'embedding': 'llmRoleForm.desc_embedding',
    } %}

    <div class="form-card">
      <div class="role-meta">
        <div class="role-meta-item"><strong>{{ "llmRoleForm.3"|trans }}</strong><span class="llm-code">{{ role.code }}</span></div>
        <div class="role-meta-item"><strong>{{ "llmRoleForm.4"|trans }}</strong>{{ role.label }}</div>
        <div class="role-meta-item" style="margin-top: 8px; padding: 12px; background: #f5f5f7; border-radius: 8px; font-size: 13px; color: #555; line-height: 1.5;">
          <i class="fa-solid fa-lightbulb" style="color: #f59e0b; margin-right: 6px;"></i>
          {{ capabilityDescs[role.code]|default('llmRoleForm.desc_general')|trans }}
        </div>
      </div>

      {{ form_start(form, {attr: {class: 'llm-role-form'}}) }}

        <div class="form-row">
          <div class="form-label">{{ form_label(form.provider) }}</div>
          <div class="form-control">{{ form_widget(form.provider) }}{{ form_errors(form.provider) }}</div>
        </div>

        <div class="form-row" style="align-items: flex-start;">
          <div class="form-label" style="margin-top: 4px;">{{ form_label(form.systemPrompt) }}</div>
          <div class="form-control">{{ form_widget(form.systemPrompt) }}{{ form_errors(form.systemPrompt) }}</div>
        </div>

        <div class="form-row">
          <div class="form-label">{{ form_label(form.isEnabled) }}</div>
          <div class="form-control">{{ form_widget(form.isEnabled) }}{{ form_errors(form.isEnabled) }}</div>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn primary medium">
            <i class="fa-solid fa-save"></i> {{ "llmRoleForm.5"|trans }}
          </button>
          <a href="{{ path('admin_llm_config_index') }}" class="btn medium">{{ "llmRoleForm.6"|trans }}</a>
        </div>
      {{ form_end(form) }}
    </div>

  </div>
</div>
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="/sunui/admin/platform/llm_config.css">
{% endblock %}
