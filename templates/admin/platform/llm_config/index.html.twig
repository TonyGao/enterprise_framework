{% extends 'admin/layout.html.twig' %}
{% import 'components/datagrid.html.twig' as grid %}

{% block app_content_container %}
<div class="org-structure-container llm-config-page">
  <div class="outside-wrapper" style="padding: 40px 48px; max-width: 1280px; margin: 0; background: #fff; min-height: calc(100vh - 60px);">

    {# Page header #}
    <div class="llm-config-header">
      <h1>{{ "llmIndex.1"|trans }}</h1>
      <div class="header-actions">
        <a href="{{ path('admin_llm_provider_create') }}" class="btn primary medium">
          <i class="fa-solid fa-plus"></i> {{ "llmIndex.2"|trans }}
        </a>
      </div>
    </div>

    {# Flash messages #}
    {% for message in app.flashes('success') %}
      <div role="alert" class="ef-alert ef-alert-success" style="margin-bottom: 32px; border-radius: 12px; padding: 20px; background-color: #f0fdf4; color: #166534;">
        <div class="ef-alert-icon" style="color: #16a34a;"><i class="fa-solid fa-circle-check" style="font-size: 18px;"></i></div>
        <div class="ef-alert-body">
          <div class="ef-alert-content" style="font-size: 14px;">{{ message }}</div>
        </div>
      </div>
    {% endfor %}

    {# Stats row #}
    {% set enabledCount = providers|filter(p => p.isEnabled)|length %}
    {% set boundRoles = roles|filter(r => r.provider is not null) %}
    <div class="llm-stats">
      <div class="llm-stat-card">
        <div class="llm-stat-icon blue"><i class="fa-solid fa-cubes"></i></div>
        <div>
          <div class="llm-stat-number">{{ providers|length }}</div>
          <div class="llm-stat-label">{{ "llmIndex.3"|trans }}</div>
        </div>
      </div>
      <div class="llm-stat-card">
        <div class="llm-stat-icon green"><i class="fa-solid fa-toggle-on"></i></div>
        <div>
          <div class="llm-stat-number">{{ enabledCount }}</div>
          <div class="llm-stat-label">{{ "llmIndex.4"|trans }}</div>
        </div>
      </div>
      <div class="llm-stat-card">
        <div class="llm-stat-icon purple"><i class="fa-solid fa-tag"></i></div>
        <div>
          <div class="llm-stat-number">{{ roles|length }}</div>
          <div class="llm-stat-label">{{ "llmIndex.5"|trans }}</div>
        </div>
      </div>
      <div class="llm-stat-card">
        <div class="llm-stat-icon orange"><i class="fa-solid fa-link"></i></div>
        <div>
          <div class="llm-stat-number">{{ boundRoles|length }}</div>
          <div class="llm-stat-label">{{ "llmIndex.6"|trans }}</div>
        </div>
      </div>
    </div>

    {# Provider cards #}
    <div class="llm-section-header">
      <div>
        <div class="section-title">{{ "llmIndex.7"|trans }}</div>
        <div class="section-subtitle">{{ "llmIndex.8"|trans }}</div>
      </div>
    </div>

    <div class="llm-provider-list">
      {% for provider in providers %}
        {% include 'admin/platform/llm_config/_provider_card.html.twig' %}
      {% else %}
        <div class="llm-empty-state">
          <div class="empty-icon"><i class="fa-solid fa-robot"></i></div>
          <p>{{ "llmIndex.9"|trans }}</p>
          <a href="{{ path('admin_llm_provider_create') }}" class="btn primary medium">
            <i class="fa-solid fa-plus"></i> {{ "llmIndex.10"|trans }}
          </a>
        </div>
      {% endfor %}
    </div>

    {# Role binding table #}
    <div class="llm-role-section">
      <div class="llm-section-header">
        <div>
          <div class="section-title">{{ "llmIndex.11"|trans }}</div>
          <div class="section-subtitle">{{ "llmIndex.12"|trans }}</div>
        </div>
        <button type="button" class="btn outline small icon" id="btn-batch-bind" disabled>
          <i class="fa-solid fa-layer-group"></i> {{ "llmIndex.13"|trans }}
        </button>
      </div>

      {# Batch panel (hidden by default) #}
      <div class="llm-batch-panel" id="batch-panel" style="display: none;">
        <div class="batch-panel-left">
          <i class="fa-solid fa-check-circle" style="color: #0066cc;"></i>
          <span>{{ "llmIndex.14"|trans }} <strong><span id="batch-count">0</span></strong> {{ "llmIndex.15"|trans }}</span>
        </div>
        <div class="batch-panel-right">
          <div class="batch-select-wrapper">
            <select id="batch-provider">
              <option value="">— {{ "llmIndex.16"|trans }} —</option>
              {% for p in providers %}
                <option value="{{ p.id }}">{{ p.name }}（{{ p.provider }}）</option>
              {% endfor %}
            </select>
          </div>
          <button type="button" class="btn primary small icon" id="btn-batch-confirm">
            <i class="fa-solid fa-check"></i> {{ "llmIndex.17"|trans }}
          </button>
          <button type="button" class="btn secondary small icon" id="btn-batch-cancel">
            <i class="fa-solid fa-xmark"></i> {{ "llmIndex.18"|trans }}
          </button>
        </div>
      </div>

      {% set roleRows = [] %}
      {% for role in roles %}
        {% if role.provider %}
          {% set providerHtml = '<span class="llm-tag llm-tag-bound">' ~ role.provider.name ~ '</span>' %}
        {% else %}
          {% set providerHtml %}<span class="llm-tag llm-tag-unbound">{{ "llmIndex.unbound"|trans }}</span>{% endset %}
        {% endif %}

        {% if role.isEnabled %}
          {% set statusHtml %}<span class="llm-tag llm-tag-enabled">{{ "llmIndex.enabled"|trans }}</span>{% endset %}
        {% else %}
          {% set statusHtml %}<span class="llm-tag llm-tag-disabled">{{ "llmIndex.disabled"|trans }}</span>{% endset %}
        {% endif %}

        {% set editBtn %}<a href="{{ path('admin_llm_role_edit', {code: role.code}) }}" class="ef-link" style="font-size: 15px;" title="{{ "llmIndex.edit"|trans }}"><i class="fa-solid fa-pen"></i></a>{% endset %}

        {% set roleRows = roleRows|merge([{
          id: role.code,
          code: '<span class="llm-code">' ~ role.code ~ '</span>',
          label: '<span style="font-weight: 500;">' ~ role.label ~ '</span>',
          provider: providerHtml,
          status: statusHtml,
          actions: editBtn,
        }]) %}
      {% endfor %}

      {{ grid.dataGrid(
        roleRows,
        [
          {field: 'code', label: '编码', align: 'left', raw: true},
          {field: 'label', label: '模型功能', align: 'left', raw: true},
          {field: 'provider', label: '绑定服务商', align: 'left', raw: true},
          {field: 'status', label: '状态', align: 'center', raw: true},
          {field: 'actions', label: '操作', align: 'center', raw: true, width: '80px'},
        ],
        {
          emptyText: '暂无角色定义',
          gridId: 'llm-role-grid',
          pagination: false,
          serverSide: false,
          showCheckbox: true,
          showRowNumber: true,
          sortable: false,
          autoFitContent: true,
          maxWidth: '100%',
          minHeight: 'auto',
        }
      ) }}
    </div>

    {# Info cards row #}
    <div class="llm-info-cards">
      <div class="side-card">
        <div class="side-card-title"><i class="fa-solid fa-info-circle" style="color: #0066cc;"></i> {{ "llmIndex.19"|trans }}</div>
        <div class="side-card-text">
          {{ "llmIndex.20"|trans }}
          {{ "llmIndex.21"|trans }}
        </div>
      </div>

      <div class="side-card">
        <div class="side-card-title"><i class="fa-solid fa-shield-halved" style="color: #16a34a;"></i> {{ "llmIndex.22"|trans }}</div>
        <div class="side-card-text">
          {{ "llmIndex.23"|trans }}
          {{ "llmIndex.24"|trans }}
        </div>
      </div>

      <div class="side-card" style="background: #f5f3ff;">
        <div class="side-card-title" style="color: #7c3aed;"><i class="fa-solid fa-wand-magic-sparkles"></i> {{ "llmIndex.11"|trans }}</div>
        <div class="side-card-text">
          {{ "llmIndex.25"|trans }}
          {{ "llmIndex.26"|trans }}
        </div>
      </div>
    </div>

  </div>
</div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="/sunui/admin/platform/llm_config.js"></script>
  <script>
    $(document).ready(function () {
      function updateBatchBtn() {
        var ids = window.efDataGrid ? window.efDataGrid.getSelectedIds('llm-role-grid') : [];
        $('#btn-batch-bind').prop('disabled', ids.length === 0);
      }

      $(document).on('change', '#llm-role-grid .ef-checkbox input', updateBatchBtn);
      $(document).on('change', '#llm-role-grid .check-all input', updateBatchBtn);

      $('#btn-batch-bind').on('click', function () {
        var ids = window.efDataGrid.getSelectedIds('llm-role-grid');
        if (ids.length === 0) return;
        $('#batch-count').text(ids.length);
        $('#batch-provider').val('');
        $('#batch-panel').show();
      });

      $('#btn-batch-cancel').on('click', function () {
        $('#batch-panel').hide();
      });

      $('#btn-batch-confirm').on('click', function () {
        var ids = window.efDataGrid.getSelectedIds('llm-role-grid');
        var providerId = $('#batch-provider').val();
        var $btn = $(this).prop('disabled', true).html(t('llmIndex.js1'));

        $.post('/admin/platform/llm-config/role/batch-bind', {
          role_codes: ids,
          provider_id: providerId,
        }).done(function (res) {
          if (res.success) {
            location.reload();
          } else {
            alert(res.error || t('llmIndex.js2'));
          }
        }).fail(function (xhr) {
          var err = (xhr.responseJSON && xhr.responseJSON.error) || t('llmIndex.js2');
          alert(err);
        }).always(function () {
          $btn.prop('disabled', false).html(t('llmIndex.js3'));
        });
      });
    });
  </script>
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('sunui/components/datagrid.css') }}">
  <link rel="stylesheet" href="/sunui/admin/platform/llm_config.css">
{% endblock %}
