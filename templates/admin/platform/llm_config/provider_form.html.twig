{% extends 'admin/layout.html.twig' %}

{% block app_content_container %}
<div class="org-structure-container llm-config-page">
  <div class="outside-wrapper" style="padding: 40px 48px; max-width: 1280px; margin: 0; background: #fff; min-height: calc(100vh - 60px);">

    <div class="page-title-row" style="margin-bottom: 12px;">
      <h1>{{ provider.id ? '编辑服务商' : '新增服务商' }}</h1>
      <a href="{{ path('admin_llm_config_index') }}" class="back-link">
        <i class="fa-solid fa-arrow-left"></i> 返回
      </a>
    </div>

    <div class="form-card">
      {{ form_start(form, {attr: {class: 'llm-provider-form'}}) }}

        <div class="form-section-title">基本信息</div>

        <div class="form-row">
          <div class="form-label">{{ form_label(form.name) }}</div>
          <div class="form-control">{{ form_widget(form.name) }}{{ form_errors(form.name) }}</div>
        </div>

        <div class="form-row">
          <div class="form-label">{{ form_label(form.provider) }}</div>
          <div class="form-control">{{ form_widget(form.provider) }}{{ form_errors(form.provider) }}</div>
        </div>

        <div class="form-row">
          <div class="form-label">{{ form_label(form.model) }}</div>
          <div class="form-control">{{ form_widget(form.model) }}{{ form_errors(form.model) }}</div>
        </div>

        <div class="form-row">
          <div class="form-label">{{ form_label(form.apiKey) }}</div>
          <div class="form-control">{{ form_widget(form.apiKey) }}{{ form_errors(form.apiKey) }}</div>
        </div>

        <div class="form-row">
          <div class="form-label">{{ form_label(form.apiEndpoint) }}</div>
          <div class="form-control">
            {{ form_widget(form.apiEndpoint) }}
            <div style="font-size: 12px; color: #86868b; margin-top: 4px;">选择知名服务商后自动填入，可手动修改</div>
            {{ form_errors(form.apiEndpoint) }}
          </div>
        </div>

        <div class="form-row">
          <div class="form-label">{{ form_label(form.isEnabled) }}</div>
          <div class="form-control">{{ form_widget(form.isEnabled) }}{{ form_errors(form.isEnabled) }}</div>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn primary medium">
            <i class="fa-solid fa-save"></i> 保存
          </button>
          <a href="{{ path('admin_llm_config_index') }}" class="btn medium">取消</a>
        </div>
      {{ form_end(form) }}
    </div>

  </div>
</div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="/sunui/admin/platform/llm_config.js"></script>
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="/sunui/admin/platform/llm_config.css">
{% endblock %}
