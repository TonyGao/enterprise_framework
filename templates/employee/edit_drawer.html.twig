{% form_theme form 'form/ef_ui_form_theme.html.twig' %}
{% if designerFormView is defined %}{% form_theme designerFormView 'form/ef_ui_form_theme.html.twig' %}{% endif %}
<div class="ef-drawer-container" style="z-index: 1001; display: none;" id="{{ drawerId }}">
    <div class="ef-drawer-mask" maskid="{{ drawerId }}" onclick="closeDrawer('{{ drawerId }}')"></div>
    <div class="ef-drawer" style="right: -650px; width: 650px; box-shadow: -4px 0 20px rgba(0,0,0,0.15);">
        <div class="ef-drawer-header">
            <div class="ef-drawer-title">
                <i class="fa-solid fa-user-pen" style="margin-right: 12px; font-size: 18px;"></i>
                {{ 'employee.detail.action.edit'|trans({}, 'messages')|default('Edit Employee') }} - {{ employee.name }}
            </div>
            {% if is_granted('ROLE_SYS_ADMIN') %}
                <div style="margin-left: auto; display: flex; gap: 6px; align-items: center; margin-right: 12px;">
                    {% if designerViewId is defined %}
                        <a href="{{ path('platform_view_editor', {id: designerViewId}) }}" target="_blank"
                           style="padding: 4px 10px; background: #f0f7ff; border: 1px solid #cce5ff; border-radius: 14px;
                                  font-size: 12px; color: #0066cc; text-decoration: none; white-space: nowrap;
                                  display: inline-flex; align-items: center; gap: 4px;">
                            <i class="fa-solid fa-pen-to-square"></i> 视图设计器
                        </a>
                        <button type="button" onclick="unbindEmployeeView(this, '{{ designerViewId }}')"
                                style="padding: 4px 10px; background: #fff0f0; border: 1px solid #ffccc7; border-radius: 14px;
                                       font-size: 12px; color: #a8071a; white-space: nowrap; cursor: pointer;
                                       display: inline-flex; align-items: center; gap: 4px;">
                            <i class="fa-solid fa-chain-broken"></i> 解绑视图
                        </button>
                    {% elseif designerViewName is defined %}
                        <button type="button" onclick="autoCreateEmployeeView(this)"
                                style="padding: 4px 10px; background: #fff3cd; border: 1px solid #ffc107; border-radius: 14px;
                                       font-size: 12px; color: #856404; white-space: nowrap; cursor: pointer;
                                       display: inline-flex; align-items: center; gap: 4px;">
                            <i class="fa-solid fa-link"></i> 新建视图
                        </button>
                    {% endif %}
                </div>
            {% endif %}
            <div tabindex="-1" role="button" aria-label="Close" class="ef-drawer-close-btn" onclick="closeDrawer('{{ drawerId }}')">
                <span class="ef-icon-hover">
                    <svg viewbox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" class="ef-icon ef-icon-close" stroke-width="4" stroke-linecap="butt" stroke-linejoin="miter">
                        <path d="M9.857 9.858 24 24m0 0 14.142 14.142M24 24 38.142 9.858M24 24 9.857 38.142"></path>
                    </svg>
                </span>
            </div>
        </div>
        <div class="ef-drawer-body">
            <div class="ef-drawer-content" style="padding: 24px 32px; background: #ffffff;">
                <style>
                    .profile-drawer-title {
                        font-size: 18px;
                        font-weight: 600;
                        color: #1e293b;
                        margin-bottom: 24px;
                    }

                    .profile-section {
                        display: flex;
                        gap: 20px;
                        align-items: center;
                        margin-bottom: 32px;
                    }

                    .profile-avatar {
                        width: 72px;
                        height: 72px;
                        border-radius: 50%;
                        object-fit: cover;
                    }

                    .profile-info {
                        display: flex;
                        flex-direction: column;
                        gap: 8px;
                    }
                    
                    .profile-info-title {
                        font-size: 14px;
                        font-weight: 600;
                        color: #1e293b;
                    }

                    .profile-actions {
                        display: flex;
                        gap: 12px;
                    }

                    .btn-upload {
                        border: 1px solid #6366f1;
                        color: #6366f1;
                        background: transparent;
                        padding: 6px 16px;
                        border-radius: 6px;
                        cursor: pointer;
                        display: flex;
                        align-items: center;
                        gap: 8px;
                        font-weight: 500;
                        font-size: 13px;
                        transition: all 0.2s;
                    }
                    
                    .btn-upload:hover {
                        background: #e0e7ff;
                    }

                    .btn-remove {
                        border: none;
                        color: #ef4444;
                        background: #fee2e2;
                        padding: 6px 16px;
                        border-radius: 6px;
                        cursor: pointer;
                        display: flex;
                        align-items: center;
                        gap: 8px;
                        font-weight: 500;
                        font-size: 13px;
                        transition: all 0.2s;
                    }
                    
                    .btn-remove:hover {
                        background: #fecaca;
                    }

                    .profile-hint {
                        font-size: 12px;
                        color: #64748b;
                        margin-top: 2px;
                    }

                    .modern-form-grid {
                        display: grid;
                        grid-template-columns: repeat(2, 1fr);
                        gap: 20px;
                        margin-bottom: 20px;
                    }

                    .modern-form-group {
                        display: flex;
                        flex-direction: column;
                        gap: 8px;
                    }

                    .modern-form-group.full-width {
                        grid-column: span 2;
                    }

                    .modern-label {
                        font-size: 14px;
                        font-weight: 500;
                        color: #334155;
                    }

                    .btn-verify {
                        background: #e0e7ff;
                        color: #6366f1;
                        border: none;
                        padding: 8px 12px;
                        border-radius: 6px;
                        font-size: 13px;
                        font-weight: 500;
                        cursor: pointer;
                        display: flex;
                        align-items: center;
                        gap: 6px;
                        white-space: nowrap;
                    }

                    .modern-divider {
                        height: 1px;
                        background: #f1f5f9;
                        margin: 28px 0;
                    }

                    .toggle-row {
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                        margin-bottom: 24px;
                    }

                    .toggle-info {
                        display: flex;
                        flex-direction: column;
                        gap: 4px;
                    }

                    .toggle-title {
                        font-size: 14px;
                        font-weight: 500;
                        color: #1e293b;
                    }

                    .toggle-desc {
                        font-size: 13px;
                        color: #64748b;
                    }

                    .btn-full-save {
                        width: 100%;
                        background: #3b82f6;
                        color: #fff;
                        border: none;
                        padding: 12px;
                        border-radius: 8px;
                        font-size: 15px;
                        font-weight: 500;
                        cursor: pointer;
                        transition: background 0.2s;
                        margin-top: 8px;
                        text-align: center;
                    }

                    .btn-full-save:hover {
                        background: #2563eb;
                    }
                </style>

                <div class="profile-drawer-title">{{ 'employee.edit_drawer.account_details'|trans }}</div>

                <div class="profile-section">
                    <div id="edit-avatar-img-{{ employee.id }}" data-ef-sync="employee:{{ employee.id }}" class="profile-avatar" style="cursor: pointer;display:flex;align-items:center;justify-content:center;background-color:#3b82f6;color:#ffffff;font-weight:600;font-size:24px;flex-shrink:0;" onclick="openAvatarModal('{{ employee.id }}')">
                        {% if employee.avatar %}
                            <img src="{{ employee.avatar }}" style="width:100%;height:100%;object-fit:cover;border-radius:50%;">
                        {% else %}
                            {{ employee.name|slice(-2, 2) }}
                        {% endif %}
                    </div>
                    <div class="profile-info" style="flex: 1;">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                            <div>
                                <div class="profile-info-title" style="font-size: 18px; margin-bottom: 2px;">{{ employee.name }}</div>
                                <div style="font-size: 13px; color: #64748b;">{{ employee.englishName|default('') }}</div>
                            </div>
                            {% set status_class = {
                                'active': 'ef-badge-success',
                                'inactive': 'ef-badge-danger'
                            }[employee.employmentStatus] | default('ef-badge-secondary') %}
                            <span class="ef-badge {{ status_class }}">{{ ('employee.employment_status.' ~ employee.employmentStatus)|trans }}</span>
                        </div>
                        <div style="margin-top: 8px; font-size: 13px; color: #475569; display: flex; gap: 12px; align-items: center;">
                            <span>
                                <i class="fa-solid fa-briefcase" style="margin-right: 6px; color: #94a3b8;"></i>
                                {{ employee.position ? employee.position.name : ('employee.field.no_position'|trans|default('No Position')) }}
                            </span>
                            <span style="display: flex; align-items: center; gap: 4px;">
                                {% set work_icon = {
                                    'working': 'fa-briefcase',
                                    'vacation': 'fa-umbrella-beach',
                                    'business_trip': 'fa-plane',
                                    'out_of_office': 'fa-person-walking-arrow-right',
                                    'in_meeting': 'fa-users'
                                }[employee.workStatus] | default('fa-circle') %}
                                <i class="fa-solid {{ work_icon }}" style="color: #94a3b8;"></i>
                                {{ ('employee.work_status.' ~ employee.workStatus)|trans }}
                            </span>
                        </div>
                        <div class="profile-actions" style="margin-top: 12px;">
                            <button type="button" class="btn-upload" onclick="openAvatarModal('{{ employee.id }}')"><i class="fa-solid fa-arrow-up-from-bracket"></i> {{ 'employee.edit_drawer.upload_image'|trans }}</button>
                            <button type="button" class="btn-remove" onclick="removeAvatar('{{ employee.id }}', this)"><i class="fa-regular fa-trash-can"></i> {{ 'employee.edit_drawer.remove'|trans }}</button>
                        </div>
                    </div>
                </div>

                {% import 'ui/template/ui.html.twig' as ui %}
                {% set fv = designerFormView is defined ? designerFormView : form %}
                {% set colSpanMap = {email: 2, mobile: 2, company: 2} %}
                {% if designerFields is defined %}
                  {% for df in designerFields %}
                    {% set colSpanMap = colSpanMap|merge({(df.fieldName): df.config.colSpan|default(1)}) %}
                  {% endfor %}
                {% endif %}
                {% macro spanClass(map, name) %}{% if map[name]|default(1) > 1 %} full-width{% endif %}{% endmacro %}
                {% import _self as helpers %}
                {{ form_start(fv, {'attr': {'id': 'employee-edit-form-' ~ employee.id, 'class': 'edit-form'}}) }}
                    <div class="modern-form-grid">
                        <div class="modern-form-group{{ helpers.spanClass(colSpanMap, 'name') }}">
                            {{ form_label(fv.name, null, {'label_attr': {'class': 'modern-label'}}) }}
                            {{ form_widget(fv.name) }}
                            {{ form_errors(fv.name) }}
                        </div>
                        <div class="modern-form-group{{ helpers.spanClass(colSpanMap, 'englishName') }}">
                            {{ form_label(fv.englishName, null, {'label_attr': {'class': 'modern-label'}}) }}
                            {{ form_widget(fv.englishName) }}
                            {{ form_errors(fv.englishName) }}
                        </div>
                        <div class="modern-form-group{{ helpers.spanClass(colSpanMap, 'employeeNo') }}">
                            {{ form_label(fv.employeeNo, null, {'label_attr': {'class': 'modern-label'}}) }}
                            {{ form_widget(fv.employeeNo) }}
                            {{ form_errors(fv.employeeNo) }}
                        </div>
                        
                        <div class="modern-form-group{{ helpers.spanClass(colSpanMap, 'employmentStatus') }}">
                            {{ form_label(fv.employmentStatus, null, {'label_attr': {'class': 'modern-label'}}) }}
                            {{ form_widget(fv.employmentStatus) }}
                            {{ form_errors(fv.employmentStatus) }}
                        </div>

                        <div class="modern-form-group{{ helpers.spanClass(colSpanMap, 'workStatus') }}">
                            {{ form_label(fv.workStatus, null, {'label_attr': {'class': 'modern-label'}}) }}
                            {{ form_widget(fv.workStatus) }}
                            {{ form_errors(fv.workStatus) }}
                        </div>

                        <div class="modern-form-group{{ helpers.spanClass(colSpanMap, 'isActive') }}">
                            {{ form_label(fv.isActive, null, {'label_attr': {'class': 'modern-label'}}) }}
                            {{ form_widget(fv.isActive) }}
                            {{ form_errors(fv.isActive) }}
                        </div>

                        <div class="modern-form-group{{ helpers.spanClass(colSpanMap, 'hireDate') }}">
                            {{ form_label(fv.hireDate, null, {'label_attr': {'class': 'modern-label'}}) }}
                            {{ form_widget(fv.hireDate) }}
                            {{ form_errors(fv.hireDate) }}
                        </div>

                        <div class="modern-form-group{{ helpers.spanClass(colSpanMap, 'position') }}">
                            {{ form_label(fv.position, null, {'label_attr': {'class': 'modern-label'}}) }}
                            {{ form_widget(fv.position) }}
                            {{ form_errors(fv.position) }}
                        </div>

                        <div class="modern-form-group{{ helpers.spanClass(colSpanMap, 'email') }}">
                            {{ form_label(fv.email, null, {'label_attr': {'class': 'modern-label'}}) }}
                            <div style="display: flex; gap: 8px; align-items: center;">
                                <div style="flex: 1;">{{ form_widget(fv.email) }}</div>
                                <button type="button" class="btn-verify" onclick="sendVerification('{{ employee.id }}', this)">
                                    <i class="fa-regular fa-envelope"></i> {{ 'employee.edit_drawer.send_verification_mail'|trans }}
                                </button>
                            </div>
                            {{ form_errors(fv.email) }}
                        </div>

                        <div class="modern-form-group{{ helpers.spanClass(colSpanMap, 'mobile') }}">
                            {{ form_label(fv.mobile, null, {'label_attr': {'class': 'modern-label'}}) }}
                            {{ form_widget(fv.mobile) }}
                            {{ form_errors(fv.mobile) }}
                        </div>
                    </div>

                    <div class="modern-divider"></div>

                    <div class="modern-form-grid">
                        <div class="modern-form-group{{ helpers.spanClass(colSpanMap, 'company') }}">
                            {{ form_label(fv.company, null, {'label_attr': {'class': 'modern-label'}}) }}
                            {{ form_widget(fv.company) }}
                            {{ form_errors(fv.company) }}
                        </div>

                        <div class="modern-form-group{{ helpers.spanClass(colSpanMap, 'department') }}">
                            {{ form_label(fv.department, null, {'label_attr': {'class': 'modern-label'}}) }}
                            {{ form_widget(fv.department) }}
                            {{ form_errors(fv.department) }}
                        </div>

                        <div class="modern-form-group{{ helpers.spanClass(colSpanMap, 'manager') }}">
                            {{ form_label(fv.manager, null, {'label_attr': {'class': 'modern-label'}}) }}
                            {{ form_widget(fv.manager) }}
                            {{ form_errors(fv.manager) }}
                        </div>
                    </div>

                    <button class="btn-full-save" type="submit">{{ 'employee.edit_drawer.save_changes'|trans }}</button>
                {{ form_end(fv) }}
            </div>
        </div>
    </div>
</div>

{{ include('employee/_avatar_modal.html.twig') }}

<script>
    window.closeDrawer = function(id) {
        $().hideDrawer(id);
    };

    // SSR Real-time Avatar Sync
    $('#edit-avatar-img-{{ employee.id }}').on('ef:sync', function(e, data) {
        if (data && typeof data.avatarUrl !== 'undefined') {
            const $el = $(this);
            if (data.avatarUrl) {
                // 有头像：替换内容为 img 标签
                $el.html(`<img src="${data.avatarUrl}" style="width:100%;height:100%;object-fit:cover;border-radius:50%;">`);
                $el.css('background-color', 'transparent'); // 移除背景色
            } else {
                // 无头像：显示名字缩写
                const name = data.name || '{{ employee.name }}';
                $el.text(name.slice(-2));
                $el.css('background-color', '#3b82f6'); // 恢复蓝色背景
            }
        }
    });

    // 状态联动：在职状态 -> 账号状态
    (function() {
        const employmentStatusSelect = document.getElementById('employee_employmentStatus');
        const accountStatusSelect = document.getElementById('employee_isActive');

        if (employmentStatusSelect && accountStatusSelect) {
            employmentStatusSelect.addEventListener('change', function() {
                const val = this.value;
                if (val === 'inactive') {
                    // 离职 -> 停用
                    accountStatusSelect.value = '0';
                } else if (val === 'active') {
                    // 在职 -> 可用
                    accountStatusSelect.value = '1';
                }
                
                // 触发 change 事件以更新可能的自定义 UI 组件 (如 select.js)
                $(accountStatusSelect).trigger('change');
            });
        }
    })();

    // Initialize date pickers in the drawer if needed
    if (typeof $.fn.daterangepicker !== 'undefined' && typeof window.EFDate !== 'undefined') {
        $('#{{ drawerId }} .date-picker').each(function() {
            if (!$(this).data('daterangepicker')) {
                $(this).daterangepicker({
                    ...window.EFDate.getDefaultOptions('YYYY-MM-DD'),
                    singleDatePicker: true,
                    showDropdowns: true,
                    autoUpdateInput: false
                }).on('apply.daterangepicker', function(ev, picker) {
                    $(this).val(picker.startDate.format('YYYY-MM-DD'));
                }).on('cancel.daterangepicker', function(ev, picker) {
                    $(this).val('');
                });
            }
        });
    }

    // Form Submission Logic
    document.getElementById('employee-edit-form-{{ employee.id }}').addEventListener('submit', function(e) {
        e.preventDefault();
        
        const form = e.target;
        // Skip validation if ui.formValid is not available, but try to use it if it is
        if (typeof ui !== 'undefined' && ui.formValid && ui.formValid(form) === false) {
            return;
        }

        const formData = new FormData(form);
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalText = submitBtn.innerHTML;
        submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> {{ "action.saving"|trans|default("Saving...") }}';
        submitBtn.disabled = true;

        fetch('{{ path("employee_edit", {id: employee.id}) }}', {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => {
            if (response.status === 422) {
                // Validation error, replace drawer content
                return response.text().then(html => {
                    const tempDiv = document.createElement('div');
                    tempDiv.innerHTML = html;
                    const newDrawer = tempDiv.querySelector('.ef-drawer-container');
                    if (newDrawer) {
                        const oldDrawer = document.getElementById('{{ drawerId }}');
                        if (oldDrawer) {
                            oldDrawer.outerHTML = newDrawer.outerHTML;
                            // Re-initialize any JS components in the new form
                            if (typeof ui !== 'undefined' && ui.init) {
                                ui.init();
                            }
                        }
                    }
                    throw new Error('Validation failed');
                });
            }
            if (!response.ok) {
                throw new Error('Network response was not ok');
            }
            return response.json();
        })
        .then(data => {
            if (data.status === 'success') {
                // 1. Close ONLY the edit drawer
                window.closeDrawer('{{ drawerId }}');
                
                // 2. Refresh the parent detail drawer if it exists
                const parentDrawerId = 'employee-detail-drawer-{{ employee.id }}';
                const $parentDrawer = $('#' + parentDrawerId);
                
                if ($parentDrawer.length > 0) {
                    $.ajax({
                        url: '/employee/{{ employee.id }}',
                        method: 'GET',
                        success: function(html) {
                            const $newHtml = $(html);
                            const $newBody = $newHtml.find('.ef-drawer-body');
                            $parentDrawer.find('.ef-drawer-body').html($newBody.html());
                            
                            if (typeof window.Alert !== 'undefined') {
                                let alertMsg = new Alert($parentDrawer.find('.ef-drawer-body'));
                                alertMsg.success('{{ "action.edit_success"|trans }}', { percent: '300px', title: "成功", closable: false });
                            }
                        }
                    });
                } else {
                    if (typeof ui !== 'undefined' && ui.alert) {
                        ui.alert.success('{{ "action.edit_success"|trans }}');
                    } else {
                        window.location.reload();
                    }
                }
            } else {
                alert(data.message || 'Error saving employee');
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
            }
        })
        .catch(error => {
            console.error('Error:', error);
            if (error.message !== 'Validation failed') {
                alert('An error occurred while saving.');
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
            }
        });
    });

    // Back button handler for View Designer form
    $(document).on('click', '#{{ drawerId }} .back-btn', function() {
        window.closeDrawer('{{ drawerId }}');
    });

    window.removeAvatar = function(employeeId, btn) {
        if (!confirm('确定要移除头像吗？')) return;
        
        const originalText = btn.innerHTML;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';
        btn.disabled = true;

        fetch('/api/employee/' + employeeId + '/avatar', {
            method: 'DELETE',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(response => response.json())
        .then(data => {
            btn.innerHTML = originalText;
            btn.disabled = false;
            if (data.success) {
                // The Mercure SSE sync will update the UI automatically.
            } else {
                alert(data.error || '移除失败');
            }
        })
        .catch(err => {
            console.error(err);
            btn.innerHTML = originalText;
            btn.disabled = false;
            alert('请求发生错误');
        });
    };

    window.sendVerification = function(employeeId, btn) {
        const originalText = btn.innerHTML;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> {{ "action.saving"|trans|default("发送中...") }}';
        btn.disabled = true;

        fetch('/api/employee/' + employeeId + '/send-verification', {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(async response => {
            const data = await response.json();
            if (!response.ok) throw new Error(data.error || '发送失败');
            return data;
        })
        .then(data => {
            btn.innerHTML = originalText;
            btn.disabled = false;
            if (typeof window.Alert !== 'undefined') {
                let alertMsg = new Alert($('#{{ drawerId }} .ef-drawer-body'));
                alertMsg.success(data.message || '发送成功', { percent: '300px', title: "成功", closable: false });
            } else {
                alert(data.message || '发送成功');
            }
        })
        .catch(err => {
            console.error(err);
            btn.innerHTML = originalText;
            btn.disabled = false;
            if (typeof window.Alert !== 'undefined') {
                let alertMsg = new Alert($('#{{ drawerId }} .ef-drawer-body'));
                alertMsg.error(err.message || '请求发生错误', { percent: '300px', title: "错误", closable: false });
            } else {
                alert(err.message || '请求发生错误');
            }
        });
    };

    window.onFormSubmitSuccess = function() {
        window.closeDrawer('{{ drawerId }}');
        window.location.reload();
    };

{% if designerViewId is defined %}
    window.unbindEmployeeView = function(btn, viewId) {
        if (!confirm('确定要解绑视图吗？表单将恢复为标准布局。')) return;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';
        ajax({
            url: '{{ path('api_platform_view_unbind_entity', {id: '__VIEW_ID__'}) }}'.replace('__VIEW_ID__', viewId),
            method: 'POST',
            success: function() {
                window.closeDrawer('{{ drawerId }}');
                window.location.reload();
            },
            error: function(xhr) {
                var msg = xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : '解绑失败';
                alert(msg);
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-chain-broken"></i> 解绑视图';
            }
        });
    };
{% endif %}

{% if designerViewName is defined %}
    window.autoCreateEmployeeView = function(btn) {
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> 创建中...';
        ajax({
            url: '{{ path('api_platform_view_auto_bind') }}',
            method: 'POST',
            contentType: 'application/json',
            data: {
                viewName: '{{ designerViewName }}',
                viewLabel: '{{ designerViewLabel|default(designerViewName) }}',
                entityFqn: '{{ designerEntityFqn|e('js') }}',
                fields: ['name','englishName','employeeNo','employmentStatus','workStatus','isActive','hireDate','position','email','mobile','company','department','manager']
            },
            success: function(resp) {
                var info = resp.data;
                if (info && info.viewId) {
                    window.open('{{ path('platform_view_editor', {id: '__VIEW_ID__'}) }}'.replace('__VIEW_ID__', info.viewId), '_blank');
                    setTimeout(function() { location.reload(); }, 500);
                }
            },
            error: function(xhr) {
                var msg = xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : '创建失败';
                alert(msg);
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-link"></i> 新建视图';
            }
        });
    };
{% endif %}
</script>