<div class="ef-logic-row">
	<input type="hidden" name="propertyToken" value="{{ propertyToken }}">
	<div class="ef-row ef-row-align-start ef-row-justify-start">
		<div class="ef-col-6" style="padding-left: 12px; padding-right: 12px;">
			<div class="ud__col ud__form__item__label">
				<label class="ud__form__item-required" title="字段名">字段名<div class="ud__form__item__required-mark">*</div>
				</label>
			</div>
			<div class="ef-field-control-wrapper">
				{{ form_widget(formView.fieldComment) }}
			</div>
		</div>
		<div class="ef-col-6" style="padding-left: 12px; padding-right: 12px;">
			<div class="ud__col ud__form__item__label">
				<label class="ud__form__item-required" title="字段英文名">字段英文名<div class="ud__form__item__required-mark">*</div>
				</label>
			</div>
			<div class="ef-field-control-wrapper">
				{{ form_widget(formView.fieldName, {attr: {disabled: 'disabled'}}) }}
			</div>
		</div>
		<div class="ef-col-5" style="padding-left: 12px; padding-right: 12px;">
			<div class="ud__col ud__form__item__label">
				<label class="ud__form__item-required" title="字段类型">字段类型<div class="ud__form__item__required-mark">*</div>
				</label>
			</div>
			<div class="ef-field-control-wrapper">
				{{ form_widget(formView.fieldType, {attr: {disabled: 'disabled'}}) }}
			</div>
		</div>
		<div class="ef-col-6" style="padding-left: 12px; padding-right: 12px;">
			<div class="ud__col ud__form__item__label">
				<label class="ud__form__item-required" title="分组">分组<div class="ud__form__item__required-mark">*</div>
				</label>
			</div>
			<div class="ef-field-control-wrapper">
				{{ form_widget(formView.fieldGroup) }}
			</div>
		</div>
		<div class="ef-col-1" style="padding-left: 12px; padding-right: 12px;">
			<div class="ud__col ud__form__item__label">
				<label class="ud__form__item-required">
					<div class="ud__form__item__required-mark"></div>
				</label>
			</div>
			<i class="fa-solid fa-circle-xmark close-field-row" style="font-size: larger;"></i>
		</div>
	</div>
	<div class="ef-row ef-row-align-start ef-row-justify-start" style="margin-top: 10px;">
		<div class="ef-col-6" style="padding-left: 12px; padding-right: 12px;">
			<div class="ud__col ud__form__item__label">
				<label class="ud__form__item-required" title="高度">高度</label>
			</div>
			<div class="ef-field-control-wrapper">
				{{ form_widget(formView.fieldHeight) }}
			</div>
		</div>
		<div class="ef-col-6" style="padding-left: 12px; padding-right: 12px;">
			<div class="ud__col ud__form__item__label">
				<label class="ud__form__item-required" title="圆角">圆角</label>
			</div>
			<div class="ef-field-control-wrapper">
				{{ form_widget(formView.fieldRounded) }}
			</div>
		</div>
		<div class="ef-col-6 field-rows-wrapper" style="padding-left: 12px; padding-right: 12px; {{ type == 'text' ? '' : 'display: none;' }}">
			<div class="ud__col ud__form__item__label">
				<label class="ud__form__item-required" title="行数">行数</label>
			</div>
			<div class="ef-field-control-wrapper">
				{{ form_widget(formView.fieldRows) }}
			</div>
		</div>
		<div class="ef-col-6 field-autosize-wrapper" style="padding-left: 12px; padding-right: 12px; {{ type == 'text' ? '' : 'display: none;' }}">
			<div class="ud__col ud__form__item__label">
				<label class="ud__form__item-required" title="自适应高度">自适应高度</label>
			</div>
			<div class="ef-field-control-wrapper">
				{{ form_widget(formView.fieldAutosize) }}
			</div>
		</div>
	</div>
	{% if type == 'string' %}
	<div class="ef-field-attr-action-bar">
		<div class="ef-col-24">
			<div class="ef-row ef-row-align-start ef-row-justify-start ef-row-vertical-center">
				<div class="ef-col-6" style="padding-left: 12px; padding-right: 12px;">
					<div class="ud__col ud__form__item__label">
						<label class="ud__form__item-required" title="字段长度">字段长度<div class="ud__form__item__required-mark">*</div></label>
					</div>
					<div class="ef-field-control-wrapper">
						<span class="ef-input-wrapper" style="max-width: 320px;">
							<input component="input" class="ef-input ef-input-size-medium" clearable="true" type="text" name="fieldLength" fieldname="length" value="{{ length }}">
						</span>
					</div>
				</div>
				<div class="ef-col-3" style="padding-left: 12px; padding-right: 12px;">
					<div class="ud__col ud__form__item__label">
						<label class="ud__form__item-required" title="允许为空">允许为空</label>
					</div>
					<div class="ef-field-control-wrapper">
						<label aria-disabled="false" class="ef-checkbox {{ nullable ? 'ef-checkbox-checked' : '' }}">
							<input type="checkbox" component="checkbox" class="ef-checkbox-target" name="nullable" fieldname="nullable" value="1" {{ nullable ? 'checked' : '' }}>
							<span class="ef-icon-hover ef-checkbox-icon-hover ef-icon-hover-disabled">
								<div class="ef-checkbox-icon">
									<svg aria-hidden="true" focusable="false" viewBox="0 0 1024 1024" width="200" height="200" fill="currentColor" class="ef-checkbox-icon-check"><path d="M877.44815445 206.10060629a64.72691371 64.72691371 0 0 0-95.14856334 4.01306852L380.73381888 685.46812814 235.22771741 533.48933518a64.72691371 64.72691371 0 0 0-92.43003222-1.03563036l-45.82665557 45.82665443a64.72691371 64.72691371 0 0 0-0.90617629 90.61767965l239.61903446 250.10479331a64.72691371 64.72691371 0 0 0 71.19960405 15.14609778 64.33855261 64.33855261 0 0 0 35.08198741-21.23042702l36.24707186-42.71976334 40.5190474-40.77795556-3.36579926-3.49525333 411.40426297-486.74638962a64.72691371 64.72691371 0 0 0-3.88361443-87.64024149l-45.3088404-45.43829334z" p-id="840"></path></svg>
								</div>
							</span>
						</label>
					</div>
				</div>
				<div class="ef-col-3" style="padding-left: 12px; padding-right: 12px;">
					<div class="ud__col ud__form__item__label">
						<label class="ud__form__item-required" title="唯一的">唯一的</label>
					</div>
					<div class="ef-field-control-wrapper">
						<label aria-disabled="false" class="ef-checkbox {{ unique ? 'ef-checkbox-checked' : '' }}">
							<input type="checkbox" component="checkbox" class="ef-checkbox-target" name="unique" fieldname="unique" value="1" {{ unique ? 'checked' : '' }}>
							<span class="ef-icon-hover ef-checkbox-icon-hover">
								<div class="ef-checkbox-icon">
									<svg aria-hidden="true" focusable="false" viewBox="0 0 1024 1024" width="200" height="200" fill="currentColor" class="ef-checkbox-icon-check"><path d="M877.44815445 206.10060629a64.72691371 64.72691371 0 0 0-95.14856334 4.01306852L380.73381888 685.46812814 235.22771741 533.48933518a64.72691371 64.72691371 0 0 0-92.43003222-1.03563036l-45.82665557 45.82665443a64.72691371 64.72691371 0 0 0-0.90617629 90.61767965l239.61903446 250.10479331a64.72691371 64.72691371 0 0 0 71.19960405 15.14609778 64.33855261 64.33855261 0 0 0 35.08198741-21.23042702l36.24707186-42.71976334 40.5190474-40.77795556-3.36579926-3.49525333 411.40426297-486.74638962a64.72691371 64.72691371 0 0 0-3.88361443-87.64024149l-45.3088404-45.43829334z" p-id="840"></path></svg>
								</div>
							</span>
						</label>
					</div>
				</div>
			</div>
		</div>
	</div>
	{% endif %}
</div>
