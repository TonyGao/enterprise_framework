#!/bin/bash

# Enterprise Framework FrankenPHP Launcher
# Usage: ./serve [dev|prod|stop|restart|status|watch]

PROJECT_ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$PROJECT_ROOT"

MODE="${1:-dev}"

show_help() {
    echo ""
    echo "=========================================="
    echo "  企业框架 - FrankenPHP 启动器"
    echo "=========================================="
    echo ""
    echo "  用法: ./serve [模式]"
    echo ""
    echo "  模式:"
    echo "    dev     开发模式 (热重载，默认)"
    echo "    prod    生产模式 (优化性能)"
    echo "    stop    停止所有服务"
echo "    restart 重启服务器"
        echo "    refresh 清除缓存并重启服务器"
        echo "    status  查看服务状态"
    echo "    watch   看守模式 (崩溃后自动重启)"
    echo ""
    echo "  示例:"
    echo "    ./serve          启动开发模式"
    echo "    ./serve dev      启动开发模式"
    echo "    ./serve prod     启动生产模式"
    echo "    ./serve stop     停止服务"
    echo "    ./serve status   查看状态"
    echo ""
}

PID_FILE="$PROJECT_ROOT/var/frankenphp.pid"
WORKER_PID_FILE="$PROJECT_ROOT/var/messenger_worker.pid"
SCHEDULER_PID_FILE="$PROJECT_ROOT/var/task_scheduler.pid"
MCP_PID_FILE="$PROJECT_ROOT/var/mate_mcp.pid"
CDP_PROXY_PID_FILE="$PROJECT_ROOT/var/cdp_proxy.pid"
WATCHER_PID_FILE="$PROJECT_ROOT/var/watcher.pid"
WATCHER_LOCK_DIR="$PROJECT_ROOT/var/watcher.lock"
STATE_FILE="$PROJECT_ROOT/var/frankenphp.state"
LOG_FILE="$PROJECT_ROOT/var/log/server.log"
WORKER_LOG_FILE="$PROJECT_ROOT/var/log/messenger_worker.log"
SCHEDULER_LOG_FILE="$PROJECT_ROOT/var/log/task_scheduler.log"
MCP_LOG_FILE="$PROJECT_ROOT/var/log/mate_mcp.log"
CDP_PROXY_LOG_FILE="$PROJECT_ROOT/var/log/cdp_proxy.log"
STOP_REASON_FILE="$PROJECT_ROOT/var/log/stop_reason.log"

mkdir -p "$PROJECT_ROOT/var/log"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$STOP_REASON_FILE"
}

is_running() {
    # Prefer PID file check, fallback to process name check.
    if [ -f "$PID_FILE" ]; then
        local pid
        pid=$(cat "$PID_FILE")
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
    fi

    if pgrep -f "[f]rankenphp.*Caddyfile" > /dev/null 2>&1; then
        return 0
    fi
    return 1
}

get_http_code() {
    local code
    code=$(curl -sS -o /dev/null -w "%{http_code}" --max-time 3 http://localhost:8000/ 2>/dev/null || true)
    if [ -z "$code" ]; then
        echo "000"
    else
        echo "$code"
    fi
}

is_watcher_running() {
    if [ -f "$WATCHER_PID_FILE" ]; then
        WPID=$(cat "$WATCHER_PID_FILE")
        if [ -n "$WPID" ] && kill -0 "$WPID" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

is_mcp_running() {
    if [ -f "$MCP_PID_FILE" ]; then
        MPID=$(cat "$MCP_PID_FILE")
        if [ -n "$MPID" ] && kill -0 "$MPID" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

is_cdp_proxy_running() {
    if [ -f "$CDP_PROXY_PID_FILE" ]; then
        CDP_PID=$(cat "$CDP_PROXY_PID_FILE")
        if [ -n "$CDP_PID" ] && kill -0 "$CDP_PID" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

kill_stale_watchers() {
    # Kill watcher processes from previous sessions, but never kill current shell.
    local pids
    pids=$(pgrep -f "/bin/bash ./serve watch" 2>/dev/null || true)
    if [ -n "$pids" ]; then
        for pid in $pids; do
            if [ "$pid" != "$$" ]; then
                kill -TERM "$pid" 2>/dev/null || true
                sleep 1
                kill -9 "$pid" 2>/dev/null || true
            fi
        done
    fi
}

stop_server() {
    local reason="${1:-manual_stop}"
    log "STOP REASON: $reason"
    echo ""
    echo "正在停止服务..."
    echo ""
    
    # Signal watcher to stop if running
    if [ -f "$WATCHER_PID_FILE" ]; then
        WPID=$(cat "$WATCHER_PID_FILE")
        if [ -n "$WPID" ] && kill -0 "$WPID" 2>/dev/null; then
            kill -TERM "$WPID" 2>/dev/null || true
        fi
        rm -f "$WATCHER_PID_FILE"
    fi

    kill_stale_watchers
    rm -rf "$WATCHER_LOCK_DIR" 2>/dev/null || true
    
    # Stop Messenger Worker via PID file
    if [ -f "$WORKER_PID_FILE" ]; then
        WPID=$(cat "$WORKER_PID_FILE")
        if [ -n "$WPID" ] && kill -0 "$WPID" 2>/dev/null; then
            kill -TERM "$WPID" 2>/dev/null || true
            sleep 1
            kill -9 "$WPID" 2>/dev/null || true
            echo "  ✓ 消息队列消费者已停止"
        fi
        rm -f "$WORKER_PID_FILE"
    fi
    
    pkill -f "messenger:consume async" 2>/dev/null || true

    # Stop task scheduler trigger loop
    if [ -f "$SCHEDULER_PID_FILE" ]; then
        SPID=$(cat "$SCHEDULER_PID_FILE")
        if [ -n "$SPID" ] && kill -0 "$SPID" 2>/dev/null; then
            kill -TERM "$SPID" 2>/dev/null || true
            sleep 1
            kill -9 "$SPID" 2>/dev/null || true
            echo "  ✓ 定时任务调度器已停止"
        fi
        rm -f "$SCHEDULER_PID_FILE"
    fi

    pkill -f "internal/scheduler/run" 2>/dev/null || true

    # Stop Symfony Mate MCP server via PID file
    if [ -f "$MCP_PID_FILE" ]; then
        MPID=$(cat "$MCP_PID_FILE")
        if [ -n "$MPID" ] && kill -0 "$MPID" 2>/dev/null; then
            kill -TERM "$MPID" 2>/dev/null || true
            sleep 1
            kill -9 "$MPID" 2>/dev/null || true
        fi
        rm -f "$MCP_PID_FILE"
    fi

    pkill -f "vendor/bin/mate serve" 2>/dev/null || true

    # Stop CDP proxy via PID file
    if [ -f "$CDP_PROXY_PID_FILE" ]; then
        CDP_PID=$(cat "$CDP_PROXY_PID_FILE")
        if [ -n "$CDP_PID" ] && kill -0 "$CDP_PID" 2>/dev/null; then
            kill -TERM "$CDP_PID" 2>/dev/null || true
            sleep 1
            kill -9 "$CDP_PID" 2>/dev/null || true
            echo "  ✓ CDP 代理服务器 (Chrome DevTools Proxy) 已停止"
        fi
        rm -f "$CDP_PROXY_PID_FILE"
    fi
    
    # Stop FrankenPHP via PID file
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
            kill -9 "$PID" 2>/dev/null || true
            echo "  ✓ FrankenPHP (HTTP 服务器) 已停止"
        fi
        rm -f "$PID_FILE"
    fi
    
    # Force kill any remaining FrankenPHP processes
    pkill -9 -f "[f]rankenphp.*Caddyfile" 2>/dev/null || true
    sleep 1
    ./frankenphp stop 2>/dev/null || true
    
    rm -f "$STATE_FILE"
    echo ""
    echo "=========================================="
    echo "  所有服务已停止"
    echo "=========================================="
}

start_frankenphp() {
    local mode="$1"
    local extra_args=""
    
    nohup ./frankenphp run --config Caddyfile $extra_args >> "$LOG_FILE" 2>&1 &
    FPID=$!
    echo $FPID > "$PID_FILE"
    echo "  ✓ FrankenPHP (HTTP 服务器) PID: $FPID"
}

start_worker() {
    nohup php -d memory_limit=1G bin/console messenger:consume async --time-limit=3600 >> "$WORKER_LOG_FILE" 2>&1 &
    WPID=$!
    echo $WPID > "$WORKER_PID_FILE"
    echo "  ✓ 消息队列消费者 (Messenger Worker) PID: $WPID"
}

start_scheduler() {
    local mode="${1:-dev}"
    local app_env="dev"
    if [ "$mode" = "prod" ]; then
        app_env="prod"
    fi

    if [ -f "$SCHEDULER_PID_FILE" ] && kill -0 "$(cat "$SCHEDULER_PID_FILE")" 2>/dev/null; then
        echo "  ✓ 定时任务调度器 (已运行中) PID: $(cat "$SCHEDULER_PID_FILE")"
        return 0
    fi

    nohup /bin/bash -c '
        while true; do
            TS=$(date "+%Y-%m-%d %H:%M:%S")
            OUT=$(php bin/console app:scheduler:run --env='"$app_env"' --no-interaction 2>&1)
            RC=$?
            echo "[$TS] EXIT=$RC $OUT"
            sleep 30
        done
    ' >> "$SCHEDULER_LOG_FILE" 2>&1 &

    SPID=$!
    echo $SPID > "$SCHEDULER_PID_FILE"
    echo "  ✓ 定时任务调度器 (每30秒检查) PID: $SPID"
}

start_mcp_server() {
    if [ ! -f "$PROJECT_ROOT/vendor/bin/mate" ]; then
        echo "  ! Symfony Mate (需在 VS Code 中启动)"
        return 0
    fi

    echo "  ✓ Symfony Mate AI 助手 (在 VS Code MCP 面板中管理)"
}

start_cdp_proxy() {
    local node_bin
    node_bin=$(command -v node 2>/dev/null)
    if [ -z "$node_bin" ]; then
        echo "  ! Node.js 未安装，CDP 代理无法启动"
        return 1
    fi

    # Kill any existing process on port 9223
    local existing_pid
    existing_pid=$(lsof -ti :9223 2>/dev/null || true)
    if [ -n "$existing_pid" ]; then
        kill -9 "$existing_pid" 2>/dev/null || true
        sleep 1
    fi

    export NODE_ENV="${APP_ENV:-development}"
    nohup node "$PROJECT_ROOT/bin/chrome-cdp-server.mjs" > "$CDP_PROXY_LOG_FILE" 2>&1 &
    CDP_PID=$!
    echo $CDP_PID > "$CDP_PROXY_PID_FILE"
    echo "  ✓ CDP 代理服务器 (Chrome DevTools Proxy) PID: $CDP_PID"
}

wait_for_server() {
    local count=0
    local max_wait=10
    
    while [ $count -lt $max_wait ]; do
        if is_running; then
            return 0
        fi
        sleep 1
        count=$((count + 1))
    done
    return 1
}

start_dev() {
    if is_running; then
        echo "服务已在运行中，请先执行 ./serve stop"
        return 1
    fi
    
    echo ""
    echo "=========================================="
    echo "  企业框架开发环境启动中..."
    echo "=========================================="
    echo ""
    echo "  正在启动服务："
    
    mkdir -p "$(dirname "$LOG_FILE")"
    
    start_worker "dev"
    start_frankenphp "dev"
    start_mcp_server
    start_cdp_proxy
    
    sleep 2
    
    if wait_for_server; then
        start_scheduler "dev"
        echo ""
        echo "=========================================="
        echo "  ✓ 所有服务启动成功！"
        echo "=========================================="
        echo ""
        echo "  访问地址：http://localhost:8000"
        echo ""
        echo "  日志文件："
        echo "    - 服务器日志: $LOG_FILE"
        echo "    - 消息队列:   $WORKER_LOG_FILE"
        echo "    - 定时任务:   $SCHEDULER_LOG_FILE"
        echo ""
        log "Server started successfully in DEV mode"
    else
        echo ""
        echo "  ✗ 服务器启动失败，请查看日志"
        tail -50 "$LOG_FILE"
        return 1
    fi
}

start_prod() {
    if is_running; then
        echo "服务已在运行中，请先执行 ./serve stop"
        return 1
    fi
    
    echo ""
    echo "=========================================="
    echo "  企业框架生产环境启动中..."
    echo "=========================================="
    echo ""
    echo "  正在启动服务："
    
    mkdir -p "$(dirname "$LOG_FILE")"
    
    start_worker "prod"
    start_frankenphp "prod"
    start_cdp_proxy
    
    sleep 2
    
    if wait_for_server; then
        start_scheduler "prod"
        echo ""
        echo "=========================================="
        echo "  ✓ 所有服务启动成功！"
        echo "=========================================="
        echo ""
        echo "  访问地址：http://localhost:8000"
        echo ""
        echo "  日志文件："
        echo "    - 服务器日志: $LOG_FILE"
        echo "    - 消息队列:   $WORKER_LOG_FILE"
        echo "    - 定时任务:   $SCHEDULER_LOG_FILE"
        echo ""
        log "Server started successfully in PROD mode"
    else
        echo ""
        echo "  ✗ 服务器启动失败，请查看日志"
        tail -50 "$LOG_FILE"
        return 1
    fi
}

watch_mode() {
    if is_watcher_running; then
        echo "看守模式已在运行中，请先执行 ./serve stop"
        return 1
    fi
    
    echo ""
    echo "=========================================="
    echo "  企业框架 - 启动看守模式"
    echo "=========================================="
    echo ""
    echo "  系统崩溃后将自动重启..."
    echo ""
    
    mkdir -p "$(dirname "$LOG_FILE")"
    
    # Start watcher loop in background - ignore signals so Ctrl+C/terminal close doesn't kill it
    (
        trap '' HUP INT TERM

        # Prevent duplicate watchers from running concurrently.
        if ! mkdir "$WATCHER_LOCK_DIR" 2>/dev/null; then
            log "Another watcher instance is active, exiting current watcher"
            exit 0
        fi
        trap 'rm -rf "$WATCHER_LOCK_DIR"' EXIT
        
        restart_count=0
        max_restarts=100
        restart_delay=3
        health_check_interval=15
        
        while [ $restart_count -lt $max_restarts ]; do
            # Check if stop was requested (only check the LAST line of the file)
            if [ -f "$STOP_REASON_FILE" ]; then
                last_reason=$(tail -1 "$STOP_REASON_FILE" 2>/dev/null | grep -oE "STOP REASON:.*" | sed 's/STOP REASON: //')
                if [ -n "$last_reason" ] && echo "$last_reason" | grep -qE "manual_stop|watch_mode_stopped"; then
                    log "Watcher stopping due to stop request (last reason: $last_reason)"
                    exit 0
                fi
            fi
            
            # Clean up any stale processes before starting
            pkill -f "[f]rankenphp.*Caddyfile" 2>/dev/null || true
            rm -f "$PID_FILE" 2>/dev/null || true
            # Wait for process to fully exit
            sleep 1
            
            # Start server
            start_dev "true"
            server_started=$?
            
            if [ $server_started -ne 0 ]; then
                log "Server failed to start, retrying..."
                sleep $restart_delay
                restart_count=$((restart_count + 1))
                continue
            fi
            
            log "Server started, monitoring for crashes..."
            
            # Monitor server - simple loop that checks if server is still running
            while true; do
                sleep 5
                
                # Check if server process is still alive
                if ! pgrep -f "[f]rankenphp.*Caddyfile" > /dev/null 2>&1; then
                    log "Server process died"
                    break
                fi
                
                # Check if server is responding to HTTP
                http_code=$(get_http_code)
                if ! echo "$http_code" | grep -qE "^[23]"; then
                    log "Server not responding (HTTP $http_code), will restart if persists"
                    # Wait a bit more to confirm
                    sleep 5
                    http_code=$(get_http_code)
                    if ! echo "$http_code" | grep -qE "^[23]"; then
                        log "Server confirmed unresponsive, killing and restarting"
                        pkill -f "[f]rankenphp.*Caddyfile" 2>/dev/null || true
                        break
                    fi
                fi
                
                # Check for stop request periodically
                health_check_interval=$((health_check_interval - 1))
                if [ $health_check_interval -le 0 ]; then
                    health_check_interval=15
                    last_reason=$(tail -1 "$STOP_REASON_FILE" 2>/dev/null | grep -oE "STOP REASON:.*" | sed 's/STOP REASON: //')
                    if [ -n "$last_reason" ] && echo "$last_reason" | grep -qE "manual_stop|watch_mode_stopped"; then
                        log "Watcher stopping due to stop request"
                        exit 0
                    fi
                fi
            done
            
            # Server died or was killed, prepare for restart
            restart_count=$((restart_count + 1))
            log "Restarting server (attempt $restart_count/$max_restarts)"
            
            # Clean up - force kill to ensure process is gone
            pkill -9 -f "[f]rankenphp.*Caddyfile" 2>/dev/null || true
            rm -f "$PID_FILE" 2>/dev/null || true
            sleep 2
        done
        
        log "ERROR: Max restarts reached, watcher giving up"
    ) &
    
    WATCHER_PID=$!
    echo $WATCHER_PID > "$WATCHER_PID_FILE"
    log "Watcher started with PID $WATCHER_PID"
    echo "Watch mode started (Watcher PID: $WATCHER_PID)"
}

show_status() {
    echo ""
    echo "=========================================="
    echo "  企业框架 - 服务状态"
    echo "=========================================="
    echo ""
    
    if is_watcher_running; then
        echo "  ✓ 看守进程 (Watch Mode): 运行中 PID: $(cat "$WATCHER_PID_FILE")"
    else
        echo "  - 看守进程 (Watch Mode): 未运行"
    fi
    
    if is_running; then
        echo "  ✓ FrankenPHP (HTTP 服务器): 运行中 PID: $(cat "$PID_FILE")"
    else
        echo "  ✗ FrankenPHP (HTTP 服务器): 已停止"
    fi
    
    if [ -f "$WORKER_PID_FILE" ] && kill -0 "$(cat "$WORKER_PID_FILE")" 2>/dev/null; then
        echo "  ✓ 消息队列消费者: 运行中 PID: $(cat "$WORKER_PID_FILE")"
    else
        echo "  ✗ 消息队列消费者: 已停止"
    fi

    if [ -f "$SCHEDULER_PID_FILE" ] && kill -0 "$(cat "$SCHEDULER_PID_FILE")" 2>/dev/null; then
        echo "  ✓ 定时任务调度器: 运行中 PID: $(cat "$SCHEDULER_PID_FILE")"
    else
        echo "  ✗ 定时任务调度器: 已停止"
    fi

    if is_cdp_proxy_running; then
        echo "  ✓ CDP 代理服务器: 运行中 PID: $(cat "$CDP_PROXY_PID_FILE")"
    else
        echo "  ✗ CDP 代理服务器: 已停止"
    fi

    echo "  ✓ Symfony Mate AI 助手: 在 VS Code MCP 面板中管理"
    
    echo ""
    echo "  访问地址：http://localhost:8000"
    echo ""
    echo "  日志文件："
    echo "    服务器日志: $LOG_FILE"
    echo "    消息队列:   $WORKER_LOG_FILE"
    echo "    定时任务:   $SCHEDULER_LOG_FILE"
    
    if [ -f "$STOP_REASON_FILE" ] && [ -s "$STOP_REASON_FILE" ]; then
        echo ""
        echo "=== 最近事件 ==="
        tail -10 "$STOP_REASON_FILE" | sed 's/^/  /'
    fi
    echo ""
}

setup_traps() {
    trap 'log "Caught SIGTERM, graceful shutdown"; stop_server "sigterm"; exit 0' TERM
    trap 'log "Caught SIGINT, graceful shutdown"; stop_server "sigint"; exit 0' INT
}

case "$MODE" in
    dev)
        setup_traps
        stop_server "mode_switch"
        start_dev
        wait
        ;;
    prod)
        setup_traps
        stop_server "mode_switch"
        start_prod
        wait
        ;;
    stop)
        stop_server "manual_stop"
        ;;
    status)
        show_status
        ;;
    watch)
        stop_server "watch_mode"
        watch_mode
        echo "Watch mode started in background. Use './serve status' to check."
        echo "To stop: ./serve stop"
        exit 0
        ;;
    restart)
        PREV_MODE=$(cat "$STATE_FILE" 2>/dev/null || echo "dev")
        echo "Restarting in $PREV_MODE mode..."
        stop_server "restart"
        sleep 1
        if [ "$PREV_MODE" = "prod" ]; then
            start_prod
        else
            start_dev
        fi
        ;;
    refresh)
        echo ""
        echo "=========================================="
        echo "  清除缓存并优雅重启 (服务不中断)"
        echo "=========================================="
        echo ""
        php bin/console cache:clear --no-interaction
        echo ""
        echo "  正在优雅重载 worker..."
        ADMIN_ADDR="localhost:2019"
        # 等待 admin API 就绪（最多 5 秒）
        for i in 1 2 3 4 5; do
            CONFIG=$(curl -s "http://$ADMIN_ADDR/config/" 2>/dev/null)
            if [ -n "$CONFIG" ]; then
                break
            fi
            sleep 1
        done
        if [ -n "$CONFIG" ]; then
            HTTP_CODE=$(curl -s -X POST "http://$ADMIN_ADDR/load" \
                -H "Content-Type: application/json" \
                -d "$CONFIG" \
                -o /dev/null -w "%{http_code}")
            if [ "$HTTP_CODE" = "200" ]; then
                echo "  ✓ 工作进程已优雅重启，服务未中断"
            else
                echo "  ✗ API 返回 $HTTP_CODE，尝试硬重启..."
                stop_server "refresh_fallback"
                sleep 1
                start_dev
            fi
        else
            echo "  ! 无法连接 admin API，尝试硬重启..."
            stop_server "refresh_fallback"
            sleep 1
            start_dev
        fi
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        echo "Unknown mode: $MODE"
        echo ""
        show_help
        exit 1
        ;;
esac
